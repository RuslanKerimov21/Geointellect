.layer-summary-card {
  background: #ffffff;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-width: 300px;
}
.layer-summary-card .summary-content {
  padding: 1.5rem;
  flex: 1;
}
.layer-summary-card .layer-info {
  margin-bottom: 1.5rem;
}
.layer-summary-card .layer-info .layer-name {
  font-size: 1.5rem;
  font-weight: 600;
  color: #1f2937;
  margin: 0 0 0.5rem 0;
  line-height: 1.2;
}
.layer-summary-card .layer-info .layer-type {
  display: flex;
  align-items: center;
  color: #6b7280;
  font-size: 1.1rem;
  gap: 0.5rem;
}
.layer-summary-card .layer-info .layer-type .layer-icon {
  width: 16px;
  height: 16px;
  object-fit: contain;
}
.layer-summary-card .statistics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}
.layer-summary-card .statistics-grid .stat-item {
  background: #f8fafc;
  padding: 0.5rem;
  border-radius: 6px;
  text-align: center;
}
.layer-summary-card .statistics-grid .stat-item .stat-value {
  font-size: 2rem;
  font-weight: 600;
  color: #174e88;
  margin-bottom: 0.2rem;
}
.layer-summary-card .statistics-grid .stat-item .stat-label {
  font-size: 1rem;
  color: #6b7280;
  font-weight: 500;
}
.layer-summary-card .section-title {
  font-size: 1.15rem;
  font-weight: 600;
  color: #174e88;
  margin: 1.5rem 0 0.5rem 0;
}
.layer-summary-card .owner-section,
.layer-summary-card .user-section {
  margin-bottom: 2rem;
}
.layer-summary-card .user-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.layer-summary-card .user-item {
  display: flex;
  align-items: center;
  padding: 0.25rem 0;
}
.layer-summary-card .user-item .user-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background-color: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-weight: 600;
  font-size: 0.7rem;
  flex-shrink: 0;
  margin-right: 0.5rem;
}
.layer-summary-card .user-item .user-email {
  font-size: 1.1rem;
  color: #1f2937;
  word-break: break-all;
}
[data-theme="fulldark"] .layer-summary-card {
  background: #1a2433;
}
[data-theme="fulldark"] .layer-summary-card .layer-name {
  color: #e2e8f0;
}
