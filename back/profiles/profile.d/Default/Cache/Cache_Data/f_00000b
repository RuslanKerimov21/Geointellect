.gbutton {
  display: grid;
  grid-template-columns: 0 1.5rem auto 0.3rem;
  border-radius: 1rem;
  border-width: 2px;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.001);
  cursor: pointer;
  min-width: 2.7rem;
  min-height: 2.7rem;
  align-content: center;
  justify-content: center;
  align-items: center;
  column-gap: 0.6rem;
  user-select: none;
  transition: all 0.2s ease-in-out;
}
.gbutton .icon {
  width: 1.5rem;
  height: 1.5rem;
  background-size: 1.5rem;
  grid-column-start: 2;
  grid-column: 2 / span 1;
  grid-row-start: 1;
  grid-row: 1 / span 1;
  pointer-events: none;
}
.gbutton .text {
  grid-column-start: 3;
  grid-column: 3 / span 1;
  grid-row-start: 1;
  grid-row: 1 / span 1;
  font-size: 1.2rem;
  pointer-events: none;
  transform: translateY(-1px);
}
.gbutton[data-notext] {
  padding: 0;
  grid-template-columns: 0 1.5rem 0;
}
.gbutton.default {
  transition: all 0.2s ease-in-out;
}
.gbutton.danger {
  transition: all 0.2s ease-in-out;
}
.gbutton.warning {
  transition: all 0.2s ease-in-out;
}
.gbutton.success {
  transition: all 0.2s ease-in-out;
}
.gbutton.info {
  transition: all 0.2s ease-in-out;
}
