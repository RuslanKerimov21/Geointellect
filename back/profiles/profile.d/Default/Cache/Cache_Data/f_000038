    L.Draw.Marker = L.Draw.Feature.extend({
        statics: {
            TYPE: "marker"
        },

        options: {
            icon: vertexIcon,
            repeatMode: false,
            zIndexOffset: 2000
        },

        initialize: function (map, options) {
            this.type = L.Draw.Marker.TYPE;
            L.Draw.Feature.prototype.initialize.call(this, map, options);
        },

        addHooks: function () {
