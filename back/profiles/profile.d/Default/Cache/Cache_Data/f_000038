(function(window, document) {

    L.drawVersion = "GI-3.1.2-dev";

    L.drawLocal = {};

    L.Draw = {};

    L.Draw.Feature = L.Handler.extend({
        includes: L.Mixin.Events,

        /*когда начинаем рисовать новый объект*/
        initialize: function(map, options) {
            this._map = map;
            this._container = map._container;
            this._overlayPane = map._panes.overlayPane;
            this._popupPane = map._panes.popupPane;
            this._instrument_options = null;
            if (options && options.shapeOptions) {
                options.shapeOptions = L.Util.extend({}, this.options.shapeOptions, options.shapeOptions);
            }
            L.setOptions(this, options);
        },

        enable: function(opts) {
            if (this._enabled) {
                return;
            }
            this._instrument_options = opts;
            L.Handler.prototype.enable.call(this);
            this.fire("enabled", { handler: this.type });
            this._map.fire("draw:drawstart", { layerType: this.type });
        },

        disable: function() {
            if (!this._enabled) {
                return;
            }
            L.Handler.prototype.disable.call(this);
            this._map.fire("draw:drawstop", { layerType: this.type });
            this.fire("disabled", { handler: this.type });
        },

        addHooks: function() {
            var map = this._map;
            if (map) {
                L.DomUtil.disableTextSelection();
                map.getContainer().focus();
                L.DomEvent.on(this._container, "keyup", this._cancelDrawing, this);
            }
        },

        removeHooks: function() {
            if (this._map) {
                L.DomUtil.enableTextSelection();
                L.DomEvent.off(this._container, "keyup", this._cancelDrawing, this);
            }
        },

        setOptions: function(options) {
            L.setOptions(this, options);
        },

        _fireCreatedEvent: function (layer) {
            this._map.fire("draw:created", { layer: layer, layerType: this.type });
        },

        /*когда нажимаем ESC на клавиатуре*/
        _cancelDrawing: function(e) {
            if (e.keyCode === 27) {
                if (typeof this._instrument_options.onEscape === "function") {
                    this._instrument_options.onEscape(this);
                }
                else {
                    this.disable();
                }
            }
        }
    });









    /* ========================================================================================
       ================== Полилиния ===========================================================
       ======================================================================================== */

    L.Draw.Polyline = L.Draw.Feature.extend({
        statics: {
            TYPE: "polyline"
        },
        Poly: L.Polyline,
        options: {
            allowIntersection: true,
            repeatMode: false,
            icon: vertexIcon,
            shapeOptions: {
                stroke: true,
                color: "#3d91de",
                weight: 2,
                opacity: 0.9,
                fill: false,
                clickable: true
            },
            metric: true, /*если Меркатор*/
            showLength: true, /*Показывать ли длину в балоне*/
            zIndexOffset: 2000
        },

        initialize: function(map, options) {
            this.type = L.Draw.Polyline.TYPE;
            L.Draw.Feature.prototype.initialize.call(this, map, options);
        },

        addHooks: function() {
            L.Draw.Feature.prototype.addHooks.call(this);
            if (this._map) {
                this._markers = [];

                this._markerGroup = new L.LayerGroup();
                this._map.addLayer(this._markerGroup);

                this._guidesGroup = new L.LayerGroup();
                this._map.addLayer(this._guidesGroup);

                this._poly = new L.Polyline([], this.options.shapeOptions);

                if (!this._mouseMarker) {
                    this._mouseMarker = L.marker(this._map.getCenter(), {
                        icon: vertexIcon,
                        opacity: 0,
                        zIndexOffset: this.options.zIndexOffset
                    });
                }

                this._mouseMarker
                    .on("mousedown", this._onMouseDown, this)
                    .addTo(this._map);

                this._map
                    .on("mousemove", this._onMouseMove, this)
                    .on("mouseup", this._onMouseUp, this)
                    .on("zoomend", this._onZoomEnd, this);
            }
        },

        removeHooks: function() {
            L.Draw.Feature.prototype.removeHooks.call(this);

            this._cleanUpShape();

            this._map.removeLayer(this._markerGroup);
            delete this._markerGroup;

            this._map.removeLayer(this._guidesGroup);
            delete this._guidesGroup;

            delete this._markers;

            this._map.removeLayer(this._poly);
            delete this._poly;

            this._mouseMarker
                .off("mousedown", this._onMouseDown, this)
                .off("mouseup", this._onMouseUp, this);
            this._map.removeLayer(this._mouseMarker);
            delete this._mouseMarker;

            this._map
                .off("mousemove", this._onMouseMove, this)
                .off("zoomend", this._onZoomEnd, this);
        },

        deleteLastVertex: function() {
            if (this._markers.length <= 1) {
                return;
            }

            var lastMarker = this._markers.pop(),
                poly = this._poly,
                latlng = this._poly.spliceLatLngs(poly.getLatLngs().length - 1, 1)[0];

            this._markerGroup.removeLayer(lastMarker);

            if (poly.getLatLngs().length < 2) {
                this._map.removeLayer(poly);
            }

            this._vertexChanged(latlng, false);
        },

        addVertex: function (latlng) {
            var markersLength = this._markers.length;
            this._markers.push(this._createMarker(latlng));
            this._poly.addLatLng(latlng);
            if (this._poly.getLatLngs().length === 2) {
                this._map.addLayer(this._poly);
            }
            this._vertexChanged(latlng, true);
        },

        _finishShape: function () {
            if (window.drawer.markers_cnt <= 1 && this._instrument_options.geomtype !== "line") {
                return;
            }
            if (!this._poly)
                return;
            this._fireCreatedEvent();
            this.disable();
            if (this.options.repeatMode) {
                this.enable();
            }
        },

        _shapeIsValid: function() {
            return true;
        },

        _onZoomEnd: function() {
            //this._updateGuide();
        },

        _onMouseMove: function(e) {
            var latlng = e.latlng;
            this._currentLatLng = latlng;
            this._updateGuide(latlng);
            this._mouseMarker.setLatLng(latlng);
            L.DomEvent.preventDefault(e.originalEvent);

            var vert = [];
            vert.length = 0;
            $.each(this._markers, function(i,o) {
                vert.push(o._latlng);
            });
            vert.push(latlng);

            if (typeof this._instrument_options.onMouseMoveSet === "function") {
                this._instrument_options.onMouseMoveSet(vert, latlng);
            }
        },

        _vertexChanged: function(latlng, added) {
            this._updateFinishHandler();
            this._updateRunningMeasure(latlng, added);
            this._clearGuides();
            this._map.fire("draw:vertexChange", { layerType: this.type, markers: this._markers, path: this });
        },

        _onMouseDown: function (e) {
            var originalEvent = e.originalEvent;
            this._mouseDownOrigin = L.point(originalEvent.clientX, originalEvent.clientY);
        },

        _onMouseUp: function (e) {
            if (e.originalEvent.which !== 1) {
                return;
            }
            if (this._mouseDownOrigin) {
                var distance = L.point(e.originalEvent.clientX, e.originalEvent.clientY).distanceTo(this._mouseDownOrigin);
                if (Math.abs(distance) < 9 * (window.devicePixelRatio || 1)) {
                    this.addVertex(e.latlng);
                }
            }
            this._mouseDownOrigin = null;
        },

        _updateFinishHandler: function() {
            var markerCount = this._markers.length;
            if (markerCount > 1) {
                this._markers[markerCount - 1].on("click", this._finishShape, this);
            }
            if (markerCount > 2) {
                this._markers[markerCount - 2].off("click", this._finishShape, this);
            }
        },

        _createMarker: function(latlng) {
            var marker = null;

            window.drawer = {
                markers_cnt: this._markers.length
            };

            if (window.drawer.markers_cnt === 0) {

                marker = new L.Marker(latlng, {
                    /*icon: this.options.icon,*/
                    icon: vertexIcon,
                    zIndexOffset: this.options.zIndexOffset * 2,
                    clickable: false,
                    opacity: 0.7,
                    riseOnHover: true
                });

                if (this._instrument_options.geomtype !== "line") {
                    
                    marker.bindPopup(gl.text.tool_finish_btn);
                    marker.on('mouseover', function (e) {
                        if (window.drawer.markers_cnt > 1) {
                            this.openPopup();
                            this.setOpacity(1.0);
                        }
                    });
                    marker.on('mouseout', function (e) {
                        this.closePopup();
                        this.setOpacity(0.6);
                    });
                }

            } else {
                marker = new L.Marker(latlng, {
                    /*icon: this.options.icon,*/
                    icon: vertexIconTmp,
                    zIndexOffset: this.options.zIndexOffset * 2,
                    clickable: false,
                    riseOnHover: false
                });
            }
            
            this._markerGroup.addLayer(marker);
            return marker;
        },

        _clearGuides: function() {
            this._guidesGroup.clearLayers();
        },

        _updateGuide: function(newPos) {
            var markerCount = this._markers.length;
            if (markerCount > 0) {
                this._clearGuides();
                this._drawGuide(
                    this._markers[markerCount - 1].getLatLng(),
                    newPos
                );
            }
        },

        _drawGuide: function(pointA, pointB) {
            this._guidesGroup.addLayer(L.polyline([pointA, pointB], {
                color: "red",
                weight: 1.5,
                opacity: 0.7,
                pane: "overlayPane",
                temporary: true
            }));
        },

        _updateRunningMeasure: function(latlng, added) {
            var markersLength = this._markers.length,
                previousMarkerIndex,
                distance;

            if (this._markers.length === 1) {
                this._measurementRunningTotal = 0;
            } else {
                previousMarkerIndex = markersLength - (added ? 2 : 1);
                distance = latlng.distanceTo(this._markers[previousMarkerIndex].getLatLng());

                this._measurementRunningTotal += distance * (added ? 1 : -1);
            }
        },

        _getMeasurementString: function() {
            var currentLatLng = this._currentLatLng;
            var previousLatLng = this._markers[this._markers.length - 1].getLatLng();
            var distance = this._measurementRunningTotal + currentLatLng.distanceTo(previousLatLng);
            return L.GeometryUtil.readableDistance(distance, this.options.metric);
        },

        _clearHideErrorTimeout: function() {
            if (this._hideErrorTimeout) {
                clearTimeout(this._hideErrorTimeout);
                this._hideErrorTimeout = null;
            }
        },

        _cleanUpShape: function() {
            if (this._markers.length > 1) {
                this._markers[this._markers.length - 1].off("click", this._finishShape, this);
            }
        },

        _fireCreatedEvent: function () {
            this._instrument_options.geometry = new this.Poly(this._poly.getLatLngs(), this.options.shapeOptions);
            L.Draw.Feature.prototype._fireCreatedEvent.call(this, this._instrument_options.geometry);

            //todo: if too big

            var polyfeature = this._instrument_options.geometry.toGeoJSON();
            var centroidPt = turf.centroid(polyfeature);
            var x = centroidPt.geometry.coordinates[0];
            var y = centroidPt.geometry.coordinates[1];

            if (typeof (this._instrument_options.onDrawComplete) === "function") {
                this._instrument_options.startPoint = new L.Marker([x,y], {
                    icon: vertexIcon,
                    zIndexOffset: this.options.zIndexOffset * 2,
                    pane: "markerPane"
                });
                this._instrument_options.onDrawComplete(this._instrument_options.geometry, x, y, this._instrument_options.startPoint);
            }
        }
    });












