function gButton(options) {
    if (!options) return null;

    this.id = generateSTRUID();

    options.visible = options.visible || true;
    options.enabled = options.enabled || true;
    options.text = options.text || "";
    options.className = options.className || "default";
    options.iconClass = options.iconClass || "";

    let icon = '';
    if (options.iconClass != "") {
        icon = `<div class="icon gr-pic ${options.iconClass}"></div>`;
    }

    let text = '';
    let notext = 'data-notext=true';
    if (options.text != "") {
        notext = '';
        text = `<div class="text">${options.text}</div>`;
    }

    const button = HtmlElementFromText(`
        <div id="${this.id}" class="gbutton" ${notext}>
            ${icon}
            ${text}
        </div>`);

    button.setAttribute("data-visible", options.visible);

    button.classList.add(options.className);

    button.addEventListener("click", function (e) {
        if (typeof options.onClick == "function") {
            options.onClick(e);
        }
        else {
            console.warn("gButton: onClick is not a function");
        }
    });

    this.getElement = function () {
        return button;
    };

    this.clone = function () {
        const clone = new gButton(options);
        return clone;
    };
};
function gCheckbox(options) {
    if (!options) return null;

    let id = generateSTRUID();
    this.id = id;
    let localThis = this;

    this.name = options.name;
    this.value = options.value || "unchecked"; /*unchecked, checked, partially, disabled*/
    this.checkedClass = options.checkedClass || "gr-check-square-solid";
    this.uncheckedClass = options.uncheckedClass || "gr-rsquare";
    this.partialClass = options.partialClass || "gr-check-square-partial-2";
    this.disabledClass = options.disabledClass || "gr-rsquare-solid";
    this.size = options.size || "24px";
    this.disabled = options.disabled || false;
    this.readOnly = options.readOnly || false;
    this.partialStateEnabled = options.partialStateEnabled || false;

    this._getStateClass = function () {
        switch (this.value) {
            case 'checked': return this.checkedClass;
            case 'partially': return this.partialClass;
            case 'disabled': return this.disabledClass;
            default: return this.uncheckedClass;
        }
    };

    const element = HtmlElementFromText(`
<div id="${id}" class="g-checkbox {{dstate}} {{ddisabled}} {{dreadonly}}" 
     style="width: {{dsize}}; height: {{dsize}};"
     {{dreadonlyattr}}>
    <div class="checkbox-visual"></div>
</div>`, [
        { key: "dstate", value: this._getStateClass() },
        { key: "ddisabled", value: this.disabled ? "disabled" : "" },
        { key: "dreadonly", value: this.readOnly ? "readonly" : "" },
        { key: "dreadonlyattr", value: this.readOnly ? "data-readonly='true'" : "" },
        { key: "dsize", value: this.size }
    ]);

    const visualElement = element.querySelector('.checkbox-visual');

    this._updateVisual = function () {
        if (visualElement) {
            visualElement.className = 'checkbox-visual';
            visualElement.classList.add(this._getStateClass());
        }

        element.className = `g-checkbox ${this._getStateClass()} ${this.disabled ? 'disabled' : ''} ${this.readOnly ? 'readonly' : ''}`;

        if (this.readOnly) {
            element.setAttribute('data-readonly', 'true');
        } else {
            element.removeAttribute('data-readonly');
        }
    };

    this._updateVisual();

    this._getBooleanValue = function () {
        return this.value === 'checked';
    };

    this._toggleState = function () {
        if (this.disabled || this.readOnly) return;

        const states = this.partialStateEnabled ?
            ['unchecked', 'checked', 'partially'] : ['unchecked', 'checked'];

        const currentIndex = states.indexOf(this.value);

        if (currentIndex !== -1) {
            const nextIndex = (currentIndex + 1) % states.length;
            this.value = states[nextIndex];
            this._updateVisual();
        }
    };

    if (!this.disabled && !this.readOnly) {
        element.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            this._toggleState();

            if (typeof options.onChange === 'function') {
                options.onChange(this.value, this._getBooleanValue());
            }
        });

        element.addEventListener('keydown', (e) => {
            if (e.key === ' ' || e.key === 'Enter') {
                e.preventDefault();
                this._toggleState();

                if (typeof options.onChange === 'function') {
                    options.onChange(this.value, this._getBooleanValue());
                }
            }
        });

        element.setAttribute('tabindex', '0');
    } else if (this.readOnly) {
        element.removeAttribute('tabindex');
    }

    this.getElement = function () {
        return element;
    };

    this.getValue = function () {
        return this.value;
    };

    this.getBooleanValue = function () {
        return this._getBooleanValue();
    };

    this.setValue = function (newValue) {
        if (['unchecked', 'checked', 'partially', 'disabled'].includes(newValue)) {
            this.value = newValue;
            this._updateVisual();
        }
    };

    this.setDisabled = function (isDisabled) {
        this.disabled = isDisabled;

        if (isDisabled) {
            element.classList.add('disabled');
            element.removeAttribute('tabindex');
        } else if (!this.readOnly) {
            element.classList.remove('disabled');
            element.setAttribute('tabindex', '0');
        }

        this._updateVisual();
    };

    this.setReadOnly = function (isReadOnly) {
        this.readOnly = isReadOnly;

        if (isReadOnly) {
            element.classList.add('readonly');
            element.removeAttribute('tabindex');
        } else if (!this.disabled) {
            element.classList.remove('readonly');
            element.setAttribute('tabindex', '0');
        }

        this._updateVisual();
    };

    this.enablePartialState = function (enable) {
        this.partialStateEnabled = enable;

        if (!enable && this.value === 'partially') {
            this.setValue('unchecked');
        }
    };

    this.setCustomClasses = function (classes) {
        if (classes.checked) this.checkedClass = classes.checked;
        if (classes.unchecked) this.uncheckedClass = classes.unchecked;
        if (classes.partial) this.partialClass = classes.partial;
        if (classes.disabled) this.disabledClass = classes.disabled;

        this._updateVisual();
    };

    return this;
};
