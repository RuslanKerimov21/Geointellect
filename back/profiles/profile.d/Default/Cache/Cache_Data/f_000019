        paletteLabel: 'Default palette:',
        allowRecent: true,
        recentMax: 5,
        allowCustomColor: false,
        palette: [
            '#1ABC9C', '#16A085', '#2ECC71', '#27AE60', '#3498DB', '#2980B9',
            '#9B59B6', '#8E44AD', '#34495E', '#2C3E50', '#F1C40F', '#F39C12',
            '#E67E22', '#D35400', '#E74C3C', '#C0392B', '#ECF0F1', '#BDC3C7',
            '#95A5A6', '#7F8C8D'
        ],
        onColorSelected: function () {
            /** apply selected color */
            this.element.style.backgroundColor = this.color;
            this.element.style.color = this.color;
        }
    };

    // Merge user options onto defaults
    function mergeOptions(opts) {
        var o = {};
        for (var k in defaults) o[k] = defaults[k];
        if (opts) for (var k2 in opts) if (opts[k2] != null) o[k2] = opts[k2];
        return o;
    }

    // Uppercase + dedupe
    function unique(arr) {
        var res = [];
        for (var i = 0; i < arr.length; i++) {
            var v = String(arr[i]).toUpperCase();
            if (res.indexOf(v) === -1) res.push(v);
        }
        return res;
    }

    // Load recent colors (up to max)
    function parseRecents(max) {
        try {
            var a = JSON.parse(localStorage.getItem('colorPickRecent'));
            return Array.isArray(a) ? a.slice(0, max) : [];
        } catch (e) {
            return [];
        }
    }

    // Save recent colors
    function saveRecents(arr, max) {
        localStorage.setItem('colorPickRecent', JSON.stringify(arr.slice(0, max)));
    }

    // Picker constructor
    function ColorPick(el, opts) {
        this.element = el;
        this.options = mergeOptions(opts);
        this.color = (el.dataset.initialcolor || this.options.initialColor).toUpperCase();
        this.palette = unique(this.options.palette);
        if (this.options.allowRecent) {
            this.recents = parseRecents(this.options.recentMax);
        }
        this.applyColor();

        var self = this;
        // show on click of host element
        el.addEventListener('click', function (e) {
            if (e.target !== self.element) return;
            e.preventDefault();
            var r = self.element.getBoundingClientRect();
            self.show(r.left + e.offsetX - 10, r.top + e.offsetY);
        });

        // hide on outside click
        document.addEventListener('click', function (e) {
            if (!self.wrapper || self.element.contains(e.target)) return;
            self.hide();
        });
    }

    ColorPick.prototype.applyColor = function () {
        this.element.style.backgroundColor = this.color;
        this.element.style.color = this.color;
    };

    ColorPick.prototype.show = function (left, top) {
        if (this.wrapper) return;
        var o = this.options;
        var frag = document.createDocumentFragment();

        // wrapper
        var w = document.createElement('div');
        w.className = 'colorPickWrapper';
        w.style.cssText =
            'position:absolute;padding:5px;background:#FFF;border:1px solid #CCC;z-index:99999';
        w.style.left = left + 'px';
        w.style.top = top + 'px';

        // palette label
        var lbl = document.createElement('span');
        lbl.textContent = o.paletteLabel;
        frag.appendChild(lbl);

        // palette buttons
        for (var i = 0; i < this.palette.length; i++) {
            var hex = this.palette[i];
            var btn = document.createElement('div');
            btn.className = 'colorPickButton';
            btn.dataset.hexValue = hex;
            btn.style.cssText = 'display:inline-block;margin:2px;width:20px;height:20px;cursor:pointer;background:' + hex;
            frag.appendChild(btn);
        }

        // custom color input
        if (o.allowCustomColor) {
            var inp = document.createElement('input');
            inp.type = 'text';
            inp.className = 'customColorHash';
            inp.value = this.color;
            inp.style.margin = '5px 0 0';
            frag.appendChild(inp);

            var self = this;
            inp.addEventListener('keyup', function () {
                var v = inp.value.trim();
                if (v.charAt(0) !== '#') v = '#' + v;
                if (/^#([0-9A-F]{3}|[0-9A-F]{6})$/i.test(v)) {
                    inp.classList.remove('error');
                    self.color = v.toUpperCase();
                    self.applyColor();
                    if (o.allowRecent) {
                        if (self.recents.indexOf(self.color) === -1) {
                            self.recents.unshift(self.color);
                            saveRecents(self.recents, o.recentMax);
                        }
                    }
                } else {
                    inp.classList.add('error');
                }
            });
        }

        // recent palette
        if (o.allowRecent) {
            var rec = this.recents || [];
            var span = document.createElement('span');
            span.textContent = 'Recent:';
            span.style.margin = '0 0 0 10px';
            frag.appendChild(span);

            for (var j = 0; j < rec.length; j++) {
                var hexR = rec[j];
                var btnR = document.createElement('div');
                btnR.className = 'colorPickButton';
                btnR.dataset.hexValue = hexR;
                btnR.style.cssText = 'display:inline-block;margin:2px;width:20px;height:20px;cursor:pointer;background:' + hexR;
                frag.appendChild(btnR);
            }
        }

        w.appendChild(frag);
        document.body.appendChild(w);
        this.wrapper = w;

        var self = this;
        w.addEventListener('click', function (e) {
            var hex = e.target.dataset.hexValue;
            if (!hex) return;
            self.color = hex;
            self.applyColor();
            if (o.allowRecent) {
                if (self.recents.indexOf(hex) === -1) {
                    self.recents.unshift(hex);
                    saveRecents(self.recents, o.recentMax);
                }
            }
            self.hide();
        });
    };

    ColorPick.prototype.hide = function () {
        if (this.wrapper) {
            this.wrapper.remove();
            this.wrapper = null;
        }
