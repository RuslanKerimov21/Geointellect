        all.forEach(x => x.remove());
        this.createMenu(null, top, left);
    }


    this._onMouseUp = (e) => {
        if (e.button !== this.options.which_btn) return;
        if (this._visible && this.options.singleInstance === true) return;
        if (this.items.length == 0) return;
        this.createMenu(e);
    }

    this.createMenu = (e, top, left) => {

        this.MenuDiv = HtmlElementFromText(Dialog);

        const container = this.MenuDiv.querySelector(".container");
        container.style.maxWidth = this.options.width_px + "px";

        const list_div = this.MenuDiv.querySelector(".items-list");

        let group_numbers = this.items.map(x => x.group).filter(x => x !== undefined);
        group_numbers = group_numbers.sort((a, b) => a - b).filter((x, i, a) => a.indexOf(x) === i);

        group_numbers.forEach((group_number, index) => {

            if (index !== 0) {
                const sprHtml = HtmlElementFromText(Separator);
                list_div.appendChild(sprHtml);
            }

            const items = this.items.filter(x => x.group === group_number);

            items.forEach(item => {
                switch (item.type) {
                    case "button":
                        const itemHtml = HtmlElementFromText(Button);
                        itemHtml.querySelector(".text").innerHTML = item.text;
                        item.icon_classes?.forEach(x => itemHtml.querySelector(".icon").classList.add(x));
                        item.item_classes?.forEach(x => itemHtml.classList.add(x));
                        itemHtml.addEventListener("click", (e) => {
                            item.onClick(item.id);
                            this.closeMenuFast();
                        });
                        list_div.appendChild(itemHtml);
                        break;
                    case "checkbox":
                        break;
                    default:
                        break;
                }
            });
        });

        const _size = ElSize.fromElement(this.MenuDiv);

        const menuHeight = _size.height;
        const menuWidth = (_size.width > 0) ? _size.width : this.options.width_px;

        const windowWidth = window.innerWidth;
        const windowHeight = window.innerHeight;

        let _tar_pos = null;
        if (e?.target) {
            _tar_pos = e.target.getBoundingClientRect();
        }
        else if (top && left) {
            _tar_pos = new DOMRect(left, top, 0, 0);
        }

        this.MenuDiv.style.left = ((_tar_pos.left + (_tar_pos.width / 2)) - menuWidth / 2) + "px";
        this.MenuDiv.style.top = ((_tar_pos.top + (_tar_pos.height / 2)) - menuHeight / 2) + "px";

        this.MenuDiv.style.maxWidth = this.options.width_px + "px";

        document.body.appendChild(this.MenuDiv);

        //tut

        let startLeft;
        let startTop;
        if (this._hasButton) {
            startLeft = this.options.attachTo.getBoundingClientRect().left;
            startTop = this.options.attachTo.getBoundingClientRect().top;
            const btn_size = ElSize.fromElement(this.options.attachTo);
            startLeft = startLeft + Math.ceil(btn_size.width / 2);
            startTop = startTop + Math.ceil(btn_size.height);
        }
        else {
            if (e) {
                startLeft = e.clientX;
                startTop = e.clientY;
            }
            else if (top && left) {
                startLeft = left;
                startTop = top;
            }

        }

        startLeft = startLeft - Math.ceil(menuWidth / 2);

        this.MenuDiv.style.left = startLeft + "px";
        this.MenuDiv.style.top = startTop + "px";

        if (startLeft + menuWidth > windowWidth) {
            this.MenuDiv.style.left = (windowWidth - menuWidth - 10) + "px";
        }
        else if (startLeft < 0) {
            this.MenuDiv.style.left = "0px";
        }

        if (startTop + menuHeight > windowHeight) {
            this.MenuDiv.style.top = (startTop - menuHeight) + "px";
        }
        else if (startTop < 0) {
            this.MenuDiv.style.top = "0px";
        }

        this.MenuDiv.setAttribute("animate", "true");

        this.MenuDiv.setAttribute("data-visible", "true");

        this._visible = true;

        if (this.options.onOpen) {
            this.options.onOpen();
        }

        setTimeout(() => {
            window.addEventListener("mousedown", this._outsideClick);
            window.addEventListener("resize", this._windowResize);
        }, 200);
    }

    this.closeMenu = () => {
        this.closeMenuFast();
    }

    this.closeMenuFast = () => {
        if (this.MenuDiv) {
            window.removeEventListener("mousedown", this._outsideClick);
            window.removeEventListener("resize", this._windowResize);

            this.MenuDiv.remove();
            if (this.options.onClose) {
                this.options.onClose();
            }
        }

        this._visible = false;
    }

    this._outsideClick = (e) => {
        if (this.MenuDiv.contains(e.target)) {
            return;
        }
        this.closeMenuFast();
    }

    this._windowResize = () => {
        this.closeMenuFast();
    }

    const init = (items, options, from) => {
        this._targetEvent = this._onMouseUp.bind(this);

        this._hasButton = options.hasButton;
        this._from = from ?? "nothing";
        console.log(`ContextMenu:from = [${this._from}]`);

        //if (this._hasButton) {
        //    this.options.attachTo.addEventListener("mouseup", this._targetEvent);
        //}
        //else {
        //    document.addEventListener("mouseup", this._targetEvent);
        //}

        if (this.options.attachTo) {
            this.options.attachTo.addEventListener("mouseup", this._targetEvent);
        }
        
        this._visible = false;
    }

    init(items, options, from);
};
