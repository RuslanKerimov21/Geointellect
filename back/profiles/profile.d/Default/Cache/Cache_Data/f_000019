function gFieldSelect(options) {
    if (!options) return null;

    let id = generateSTRUID();
    this.id = id;
    let localThis = this;

    this.name = options.name;
    this.title = options.title;
    this.options = options.options || []; // Список объектов типа {value: "1", text: "First"}
    this.value = options.value || "";
    this.placeholder = options.placeholder || gltxt("select_option") || "Select...";
    this.required = options.required || false;

    let optionsHtml = "";
    if (this.placeholder) {
        optionsHtml += `<option value="" ${!this.value ? 'selected' : ''} disabled>${this.placeholder}</option>`;
    }

    this.options.forEach(option => {
        const selected = option.value === this.value ? 'selected' : '';
        optionsHtml += `<option value="${option.value}" ${selected}>${option.text}</option>`;
    });

    const element = HtmlElementFromText(localizeHtml(`
<div id="${id}" class="gfield-select">
    <span class="Title">{{dtitle}}</span>
    <select data-name="{{dname}}" class="gr-down-l Value" {{drequired}}>
        ${optionsHtml}
    </select>
</div>`), [
        { key: "dname", value: this.name },
        { key: "dtitle", value: this.title },
        { key: "drequired", value: this.required ? "required" : "" }
    ]);

    if ((this.title ?? "") == "") {
        element.querySelector(".Title").remove();
    }

    const selectElement = element.querySelector(".Value");

    function setValue(e) {
        localThis.value = e.target.value;
        if (typeof options.onChange === "function") {
            options.onChange(localThis.value);
        }
    }

    selectElement.value = this.value;

    selectElement.addEventListener("change", setValue);

    this.getElement = function () {
        return element;
    };

    this.getValue = function () {
        return localThis.value;
    };

    this.setValue = function (value) {
        localThis.value = value;
        selectElement.value = value;
    };

    this.setOptions = function (newOptions) {
        this.options = newOptions;
        selectElement.innerHTML = "";

        if (this.placeholder) {
            const placeholderOption = document.createElement("option");
            placeholderOption.value = "";
            placeholderOption.textContent = this.placeholder;
            placeholderOption.disabled = true;
            placeholderOption.selected = !this.value;
            selectElement.appendChild(placeholderOption);
        }

        newOptions.forEach(option => {
            const optionElement = document.createElement("option");
            optionElement.value = option.value;
            optionElement.textContent = option.text;
            optionElement.selected = option.value === this.value;
            selectElement.appendChild(optionElement);
        });
    };

    this.clear = function () {
        localThis.value = "";
        selectElement.value = "";
        if (this.placeholder) {
            selectElement.querySelector('option[value=""]').selected = true;
        }
    };

    return this;
};
function gFieldFileInput(options) {
    if (!options) return null;

    let id = generateSTRUID();
    this.id = id;
    let localThis = this;

    this.name = options.name;
    this.title = options.title;
    this.accept = options.accept || "*/*"; // например .xlsx, .xls
