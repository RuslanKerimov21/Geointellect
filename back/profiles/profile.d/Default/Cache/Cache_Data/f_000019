        { key: "dbrowsetext", value: options.browseText || gltxt("browse") || "Browse" },
        { key: "dfilename", value: this._getFileNameDisplay() }
    ]);

    if ((this.title ?? "") == "") {
        element.querySelector(".Title").remove();
    }

    const fileInput = element.querySelector(".file-input-hidden");
    const browseBtn = element.querySelector(".browse-btn");
    const fileName = element.querySelector(".file-name");

    browseBtn.addEventListener("click", function () {
        fileInput.click();
    });

    fileInput.addEventListener("change", function (e) {
        if (this.multiple) {
            localThis.value = e.target.files;
        } else {
            localThis.value = e.target.files[0];
        }
        fileName.textContent = localThis._getFileNameDisplay();

        if (typeof options.onChange === "function") {
            options.onChange(localThis.value);
        }
    });

    this.getElement = function () {
        return element;
    };

    this.getValue = function () {
        return localThis.value;
    };

    this.setValue = function (file) {
        localThis.value = file;
        fileName.textContent = this._getFileNameDisplay();
        // Нельзя программно сэтить file из-за безопасности
    };

    this.clear = function () {
        fileInput.value = "";
        localThis.value = null;
        fileName.textContent = this._getFileNameDisplay();
    };

    this.setAccept = function (acceptTypes) {
        this.accept = acceptTypes;
        fileInput.accept = acceptTypes;
    };

    return this;
};
function gTable(options) {
    if (!options) return null;

    let id = generateSTRUID();
    this.id = id;

    this.name = options.name;
    this.title = options.title;
    this.data = options.data || [];
    this.columns = options.columns || [];
    this.maxHeight = options.maxHeight || "300px";
    this.showHeader = options.showHeader !== false;
    this.compact = options.compact || false;

    if (this.columns.length === 0 && this.data.length > 0) {
        this.columns = Object.keys(this.data[0]).map(key => ({
            key: key,
            title: key.charAt(0).toUpperCase() + key.slice(1).replace(/_/g, ' '),
            width: options.autoWidth ? "auto" : "150px"
        }));
    }

    this._formatValue = function (value) {
        if (value === null || value === undefined) return '';
        if (typeof value === 'object') return JSON.stringify(value);
        return String(value);
    };

    this._generateRowHtml = function (row) {
        return this.columns.map(col => {
            const value = row[col.key] ?? '';
            return `<td data-key="${col.key}">${this._formatValue(value)}</td>`;
        }).join('');
    };

    this._generateBodyHtml = function () {
        if (this.data.length === 0) {
            return `<tr><td colspan="${this.columns.length}" class="no-data">${gltxt("no_data") || "No data available"}</td></tr>`;
        }

        return this.data.map((row, index) => {
            const rowClass = index % 2 === 0 ? 'even' : 'odd';
            return `<tr class="row-${rowClass}">${this._generateRowHtml(row)}</tr>`;
        }).join('');
    };

    this._generateHeaderHtml = function () {
        if (!this.showHeader) return '';
        return this.columns.map(col =>
            `<th data-key="${col.key}" ${col.width ? `style="width: ${col.width}"` : ''}>${col.title}</th>`
        ).join('');
    };

    const element = HtmlElementFromText(localizeHtml(`
<div id="${id}" class="g-table">
    {{dtitle}}
    <div class="table-container">
        <table class="table-content">
            <thead class="table-header">
                <tr>{{headerContent}}</tr>
            </thead>
            <tbody class="table-body">
                {{bodyContent}}
            </tbody>
        </table>
    </div>
</div>`), [
        {
            key: "dtitle",
            value: this.title ? `<span class="Title">${this.title}</span>` : ""
        },
        {
            key: "headerContent",
            value: this._generateHeaderHtml()
        },
        {
            key: "bodyContent",
            value: this._generateBodyHtml()
        }
    ]);

    const tableContainer = element.querySelector('.table-container');
    if (tableContainer) {
        tableContainer.style.maxHeight = this.maxHeight;
    }

    if (this.compact) {
        element.classList.add('compact');
    }

    this._applyColumnWidths = function () {
        const headers = element.querySelectorAll('th');
        const cells = element.querySelectorAll('td');

        this.columns.forEach((col, index) => {
            if (col.width && headers[index]) {
                headers[index].style.width = col.width;
                headers[index].style.minWidth = col.width;

                cells.forEach((cell, cellIndex) => {
                    if (cellIndex % this.columns.length === index) {
                        cell.style.width = col.width;
                        cell.style.minWidth = col.width;
                    }
                });
            }
        });
    };

    if (this.columns.some(col => col.width)) {
        this._applyColumnWidths();
    }

    this._refreshTable = function () {
        const thead = element.querySelector('.table-header');
        const tbody = element.querySelector('.table-body');

        if (thead) {
            thead.innerHTML = `<tr>${this._generateHeaderHtml()}</tr>`;
        }

        if (tbody) {
            tbody.innerHTML = this._generateBodyHtml();
        }

        if (this.columns.some(col => col.width)) {
            setTimeout(() => this._applyColumnWidths(), 0);
        }
    };

    this.getElement = function () {
        return element;
    };

    this.getValue = function () {
        return this.data;
    };

    this.setData = function (newData) {
        this.data = newData;
        this._refreshTable();
    };

    this.setColumns = function (newColumns) {
        this.columns = newColumns;
        this._refreshTable();
    };

    this.addRow = function (rowData) {
        this.data.push(rowData);
        this._refreshTable();
    };

    this.removeRow = function (index) {
        this.data.splice(index, 1);
        this._refreshTable();
    };

    this.clear = function () {
        this.data = [];
        this._refreshTable();
    };

    return this;
}
