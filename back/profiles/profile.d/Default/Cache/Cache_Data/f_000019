            this.WINDOW.container.setAttribute("data-isopen", "true");
            this.WINDOW.bg.setAttribute("data-isopen", "true");
            window.G.UI.openAtRight();
            this.WINDOW.is_visible = true;
            if (!this.hasHeader && this.OuterCloseBtn) {
                this.OuterCloseBtn.style.display = "block";
            }
        },
        showIf: () => {
            if (this.WINDOW.is_visible) return;
            let _existing = document.querySelector("[data-role=right-panel]");
            if (_existing) {
                return;
            }
        },
        hide: () => {
            if (!this.WINDOW.is_visible) return;
            this.WINDOW.container.setAttribute("data-isopen", "false");
            this.WINDOW.bg.setAttribute("data-isopen", "false");
            window.G.UI.closeAtRight();
            this.WINDOW.is_visible = false;
            if (!this.hasHeader && this.OuterCloseBtn) {
                this.OuterCloseBtn.style.display = "none";
            }
        },
        startPending: () => {
            if (this.WINDOW.is_pending) return;
            this.WINDOW.is_pending = true;
            this.WINDOW.container.querySelector(".waiter").setAttribute("data-visible", "true");
            this.TOOLS.startPending();
            this.CONTENT.startPending();
            this.STATUS.startPending();
        },
        stopPending: () => {
            if (!this.WINDOW.is_pending) return;
            this.WINDOW.is_pending = false;
            this.WINDOW.container.querySelector(".waiter").setAttribute("data-visible", "false");
            this.TOOLS.stopPending();
            this.CONTENT.stopPending();
            this.STATUS.stopPending();
        },
        changeDockType: (dock) => {
            if (!this.WINDOW.dockEnabled) return;
            if (!dock) return;
            this.WINDOW.container.setAttribute("data-dock", dock);
            this.WINDOW.bg.setAttribute("data-dock", dock);
            if (this.WINDOW.is_visible) {
                switch (this.WINDOW.dockType) {
                    case "right":
                        window.G.UI.openAtRight();
                        break;
                    case "fullscreen":
                        window.G.UI.closeAtRight();
                        break;
                    case "bottom":
                        window.G.UI.closeAtRight();
                        break;
                    default:
                        break;
                }
            }
            this.WINDOW.dockType = dock;
        },
        destroy: () => {
            if (this.WINDOW.container === null) return;
            document.body.removeChild(this.WINDOW.container);
            document.body.removeChild(this.WINDOW.bg);
            this.WINDOW.container = null;
            this.WINDOW.bg = null;
        }
    }

    this.CONTENT = {
        is_visible: false,
        container: null,
        clear: () => {
            if (this.CONTENT.container === null) return;
            for (var i = 0; i < this.CONTENT.container.children.length; i++) {
                this.CONTENT.container.removeChild(this.CONTENT.container.children.item(i));
            }
        },
        set: (html) => {
            this.CONTENT.clear();
            this.CONTENT.container.appendChild(html);
        },
        show: () => { },
        hide: () => { },
        startPending: () => { },
        stopPending: () => { }
    }

    this.TOOLS = {
        is_visible: false,
        container: null,
        clear: () => {
            if (this.TOOLS.container === null) return;
            for (var i = 0; i < this.TOOLS.container.children.length; i++) {
                this.TOOLS.container.removeChild(this.TOOLS.container.children.item(i));
            }
        },
        set: (html) => {
            this.TOOLS.clear();
            this.TOOLS.container.appendChild(html);
        },
        show: () => {
            if (this.TOOLS.is_visible) return;
            this.TOOLS.is_visible = true;
            this.TOOLS.container.setAttribute("data-tools-visible", "true");
        },
        hide: () => {
            if (!this.TOOLS.is_visible) return;
            this.TOOLS.is_visible = false;
            this.TOOLS.container.setAttribute("data-tools-visible", "false");
        },
        startPending: () => { },
        stopPending: () => { }
    }

    this.STATUS = {
        container: null,
        text: "",
        setText: (text) => {
            if (this.STATUS.container === null) return;
            this.STATUS.text = text;
            if (this.WINDOW.is_pending) return;
            this.STATUS.container.querySelector(".status-label").innerHTML = this.STATUS.text;
        },
        startPending: () => {
            if (this.STATUS.container === null) return;
            this.STATUS.container.querySelector(".status-label").innerHTML = gltxt("please_wait___");
            this.STATUS.container.querySelector(".status-icon").classList.add("status-pending");
            this.STATUS.container.querySelector(".status-icon").classList.remove("gr-check-circle-solid");
            this.STATUS.container.querySelector(".status-icon").classList.remove("filter-success");
            this.STATUS.container.querySelector(".status-icon").classList.add("gr-dot-multi");
            this.STATUS.container.querySelector(".status-icon").classList.add("filter-warning");
        },
        stopPending: () => {
            if (this.STATUS.container === null) return;
            this.STATUS.container.querySelector(".status-label").innerHTML = this.STATUS.text;
            this.STATUS.container.querySelector(".status-icon").classList.remove("status-pending");
            this.STATUS.container.querySelector(".status-icon").classList.remove("gr-dot-multi");
            this.STATUS.container.querySelector(".status-icon").classList.remove("filter-warning");
            this.STATUS.container.querySelector(".status-icon").classList.add("gr-check-circle-solid");
            this.STATUS.container.querySelector(".status-icon").classList.add("filter-success");
        }
    }

    this.onClose = () => { };

    const init = (name, options) => {
        this.window_name = name;
        this.WINDOW.dockEnabled = options.dockEnabled;
        this.distroyOnClose = options.distroyOnClose ?? false;
        this.hasHeader = options.hasHeader ?? true;
        this.snapToVeryTop = options.snapToVeryTop ?? true;
        this.onClose = options.onClose ?? this.onClose;
        switch (options.dockType) {
            case "right":
                this.WINDOW.dockType = "right";
                break;
            case "fullscreen":
                this.WINDOW.dockType = "fullscreen";
                break;
            case "bottom":
                this.WINDOW.dockType = "bottom";
                break;
            default:
                this.WINDOW.dockType = "right";
                this.WINDOW.dockEnabled = false;
                break;
        }

        this.WINDOW.container = HtmlElementFromText(gltxt(View));
        this.WINDOW.container.setAttribute("data-name", this.window_name);

        this.WINDOW.bg = HtmlElementFromText(Bg);
        this.WINDOW.bg.setAttribute("data-name", this.window_name);

        this.CONTENT.container = this.WINDOW.container.querySelector(".content-container");
        this.TOOLS.container = this.WINDOW.container.querySelector(".tools-container");
        this.STATUS.container = this.WINDOW.container.querySelector(".status-container");

        if (!this.hasHeader) {
            this.WINDOW.container.querySelector(".header").style.display = "none";
            this.WINDOW.container.setAttribute("has-header", "false");
        }

        if (!this.snapToVeryTop) {
            this.WINDOW.container.setAttribute("snap-to-top", "false");
            this.WINDOW.bg.setAttribute("snap-to-top", "false");
        }

        this.ContextMenuBtn = this.WINDOW.container.querySelector(".header-menu");
        this.CloseBtn = this.WINDOW.container.querySelector(".header-close");
        this.OuterCloseBtn = this.WINDOW.container.querySelector(".outer-close-btn");

        let group = 0;
        ///here
        this._contextMenu = new ContextMenu(
            [],
            {
                attachTo: this.ContextMenuBtn,
                hasButton: true,
                which_btn: 0,
                width_px: 200
            },
            "RightWindow"
        );

        if (this.WINDOW.dockEnabled) {

            group++;

            this._contextMenu.addItem({
                type: "button",
                group: group,
                icon_classes: ["gr-expand-right", "filter-primary"],
                text: gltxt("��������� ������"), //TUDU: Localize
                onClick: async () => {
                    this.WINDOW.changeDockType("right");
                }
            });

            this._contextMenu.addItem({
                type: "button",
                group: group,
                icon_classes: ["gr-expand-down", "filter-primary"],
                text: gltxt("��������� �����"), //TUDU: Localize
                onClick: async () => {
                    this.WINDOW.changeDockType("bottom");
                }
            });

            this._contextMenu.addItem({
                type: "button",
                group: group + 1,
                icon_classes: ["gr-expand-up", "filter-primary"],
                text: gltxt("�� ���� �����"), //TUDU: Localize
                onClick: async () => {
                    this.WINDOW.changeDockType("fullscreen");
                }
            });
        }

        if (this._contextMenu.itemsCount() <= 0) {
            this.ContextMenuBtn.style.display = "none";
        }

        this.CloseBtn?.addEventListener("click", () => {
            this.hide();
            if (this.distroyOnClose) this.destroy();
            this.onClose();
        });

        this.OuterCloseBtn?.addEventListener("click", () => {
            this.hide();
            if (this.distroyOnClose) this.destroy();
            this.onClose();
        });

        document.body.appendChild(this.WINDOW.bg);
        document.body.appendChild(this.WINDOW.container);

        this.initialized = true;
    }

    this.changeDockType = (dock) => {
        this.WINDOW.changeDockType(dock);
    }

    this.show = () => {
        this.WINDOW.show();
    }

    this.showIf = () => {
        this.WINDOW.show();
    }

    this.close = () => {
        this.hide();
        if (this.distroyOnClose) this.destroy();
        this.onClose();
    }

    this.hide = () => {
        this.WINDOW.hide();
    }

    this.startPending = () => {
        this.WINDOW.startPending();
    }

    this.stopPending = () => {
        this.WINDOW.stopPending();
    }

    this.destroy = () => {
        this.WINDOW.destroy();
    }

    // parts

    this.setTitle = (title) => {
        this.WINDOW.container.querySelector(".header-title").innerHTML = title;
    }

    this.setIcon = (icon_class) => {
        let _icon = this.WINDOW.container.querySelector(".header-icon");
        for (var i = 0; i < _icon.classList.length; i++) {
            if (_icon.classList.item(i).startsWith("gr-")) {
                _icon.classList.remove(_icon.classList.item(i));
            }
        }
        _icon.classList.add(icon_class);
    }

    this.setContent = (html) => {
        this.CONTENT.set(html);
    }

    this.addMenuItem = (item) => {
        this._contextMenu.addItem(item);
        this.ContextMenuBtn.style.display = "block";
    }

    init(name, options);
};
function layerSummaryCard(options) {
    if (!options) return null;

    let id = generateSTRUID();
    this.id = id;
    let localThis = this;

    this.layerName = options.layerName || "";
    this.layerType = options.layerType || "";
    this.iconUrl = options.iconUrl || "";
    this.statistics = options.statistics || {};
    this.owner = options.owner || "";
    this.editors = options.editors || [];
    this.viewers = options.viewers || [];

    this._generateAvatar = function (email, size = "32px") {
        const initials = email.split('@')[0].substring(0, 2).toUpperCase();
        return `
            <div class="user-avatar" style="width: ${size}; height: ${size};">
                ${initials}
            </div>`;
    };

    this._generateStatistics = function () {
        if (!this.statistics || Object.keys(this.statistics).length === 0) {
            return '';
        }

        const stats = Object.entries(this.statistics).map(([key, value]) => `
            <div class="stat-item">
                <div class="stat-value">${value}</div>
                <div class="stat-label">${key}</div>
            </div>
        `).join('');

        return `
            <div class="statistics-grid">
                ${stats}
            </div>`;
    };

    this._generateUserList = function (users, title) {
        if (!users || users.length === 0) return '';

        return `
            <div class="user-section">
                <h3 class="section-title">${title} (${users.length})</h3>
                <div class="user-list">
                    ${users.map(email => `
                        <div class="user-item">
                            ${this._generateAvatar(email, '28px')}
                            <div class="user-email">${email}</div>
                        </div>
                    `).join('')}
                </div>
            </div>`;
    };

    const element = HtmlElementFromText(`
<div id="${id}" class="layer-summary-card">
    <div class="summary-content">
        <div class="layer-info">
            <h1 class="layer-name">${this.layerName}</h1>
            <div class="layer-type">
                <img src="${this.iconUrl}" class="layer-icon" alt="Layer icon">
                <span>${this.layerType}</span>
            </div>
        </div>
        
        ${this._generateStatistics()}
        
        ${this.owner ? `
        <div class="owner-section">
            <h3 class="section-title">${gltxt("owner")}</h3>
            <div class="user-item">
                ${this._generateAvatar(this.owner)}
                <div class="user-email">${this.owner}</div>
            </div>
        </div>` : ''}
        
        ${this._generateUserList(this.editors, gltxt("access_write"))}
        
        ${this._generateUserList(this.viewers, gltxt("access_read"))}
    </div>
</div>`);

    this.getElement = function () {
        return element;
    };

    this.updateData = function (newData) {
        if (newData.layerName) this.layerName = newData.layerName;
        if (newData.layerType) this.layerType = newData.layerType;
        if (newData.iconUrl) this.iconUrl = newData.iconUrl;
        if (newData.statistics) this.statistics = newData.statistics;
        if (newData.owner) this.owner = newData.owner;
        if (newData.editors) this.editors = newData.editors;
        if (newData.viewers) this.viewers = newData.viewers;

        const newElement = HtmlElementFromText("");
        element.parentNode.replaceChild(newElement, element);
    };

    return this;
};
