    this.value = options.value || null; // будет содержать целиком File-объект

    this._getFileNameDisplay = function () {
        if (!this.value) {
            return options.noFileText || gltxt("no_file_selected") || "No file selected";
        }

        if (this.multiple && this.value.length > 0) {
            return this.value.length + " " +
                (options.filesSelectedText || gltxt("files_selected") || "files selected");
        }

        if (!this.multiple && this.value) {
            return this.value.name;
        }

        return options.noFileText || gltxt("no_file_selected") || "No file selected";
    };

    const element = HtmlElementFromText(localizeHtml(`
