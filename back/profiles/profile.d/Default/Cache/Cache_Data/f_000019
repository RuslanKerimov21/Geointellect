    <span class="Title">{{dtitle}}</span>
    <div class="file-input-container">
        <input type="file" data-name="{{dname}}" class="file-input-hidden" 
               accept="{{daccept}}" {{dmultiple}}/>
        <button type="button" class="browse-btn">{{dbrowsetext}}</button>
        <div class="file-name">{{dfilename}}</div>
    </div>
</div>`), [
        { key: "dname", value: this.name },
        { key: "dtitle", value: this.title },
