                }

                aydishniki.push({
                    Id: o.id,
                    Name: o.name,
                    Filter: GetOptions.filter,
                    LegendItems: list_selected_legends,
                    Opacity: GetOptions.opacity,
                    Index: ind,
                });
            }
            ind++;
        });

        return aydishniki;
    };

