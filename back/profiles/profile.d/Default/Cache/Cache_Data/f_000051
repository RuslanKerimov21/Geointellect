                            }
                        }
                    });
                }

                var list_selected_legends = [];

                if (GetOptions.rules && GetOptions.rules.length > 0) {
                    var anyChecked = false;

                    for (var i = 0; i < GetOptions.rules.length; i++) {
                        if (GetOptions.rules[i].is_checked) {
                            anyChecked = true;
                            list_selected_legends.push(i);
                        }
                    }

