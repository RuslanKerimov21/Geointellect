    this.applyLayerListFilter = function () {
        const start = performance.now();
        const searchString = localThis.layersWindow
            .find("input.layer-list-header-search")
            .val();
        const options = localThis.globalStore.getState().options;
        const newOptions = {};

        for (const layerObject of localThis.layerList) {
            /*тут добавляем все правила фильтрации*/
            var isTagEnabled = false;
            var isInSearchResult = false;
            var hasSelectedTerra = false;
            var hasAttribute = false;

            /*правило для tags*/
            if (
                localThis.tagspanel
                    .selectedTagNames()
                    .indexOf(layerObject.tag) !== -1
            ) {
                isTagEnabled = true;
            }

            /* выставляем флаг, если выбран город и этот город есть в слое */
            if (window.mapModule01.currentCity !== null) {
                if (typeof layerObject.checkLayerHasTerra == "function") {
                    if (
                        layerObject.checkLayerHasTerra(
                            window.mapModule01.currentCity.Id,
                        )
                    ) {
                        hasSelectedTerra = true;
                    }
                } else {
                    hasSelectedTerra = true;
                }
            }

            /*правило для searchstring*/
            if (trim11(searchString?.toLowerCase()) === "") {
                isInSearchResult = true;
            } else {
                if (
                    layerObject.name
                        .toLowerCase()
                        .indexOf(trim11(searchString?.toLowerCase())) !== -1
                ) {
                    isInSearchResult = true;
                }
            }

            if (typeof layerObject.checkAttribute === "function") {
                hasAttribute = layerObject.checkAttribute(searchString);
            }

            /*а дальше собственно применяем сам фильтр*/
            if (
                (isTagEnabled && isInSearchResult && hasSelectedTerra) ||
                (isTagEnabled && hasAttribute && hasSelectedTerra)
            ) {
                // localThis.globalStore.getState().updateOptions(layerObject.opts.id, { visible: true });
                newOptions[layerObject.opts.id] = {
                    id: layerObject.opts.id,
                    options: {
                        ...(options[layerObject.opts.id].options ?? {}),
                        visible: true,
                    },
                };
            } else {
                // localThis.globalStore.getState().updateOptions(layerObject.opts.id, { visible: false });
                newOptions[layerObject.opts.id] = {
                    id: layerObject.opts.id,
                    options: {
                        ...(options[layerObject.opts.id].options ?? {}),
                        visible: false,
                    },
                };
            }
        }

        localThis.globalStore.getState().setAllOptions(newOptions);

        localThis.folders.forEach((_folder) => {
            _folder.checkFolder();
        });
        localThis.toggleGroupsVisibility();
        console.log(
            "applyLayerListFilter call took %dms",
            performance.now() - start,
        );
    };

