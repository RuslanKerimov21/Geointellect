        );
        clearRetryTimeout();

        const data = {
            login: window.UserModule.userData.Info.Login,
            content: {},
            include_tags: "true",
        };
        const layersResponse = DoWebApiAction("/layers/list", data);
        const userLayersResponse = DoWebApiAction("/ulayers/list", data);
        const moduleParamsReady = loadModuleParams();

        $.when(layersResponse, userLayersResponse, moduleParamsReady).done(
            initializeLayers,
        );
    };

    /**
     * Инициализация всех слоёв
     * @param {*} layersResponseData обычные слои
     * @param {*} userLayersResponseData пользовательские слои
     * @returns
     */
    var initializeLayers = function (
        layersResponseData,
        userLayersResponseData,
    ) {
        if (
            !layersResponseData[0].success ||
            layersResponseData[0].results == null
        ) {
            console.log(layersResponseData);

            return;
        }

        const layersData = layersResponseData[0].results;
        const userLayers = userLayersResponseData[0].results;
        const batchSize =
            localStorage.getItem("layer-list-panel-batch-size") ?? 10;

        Promise.all([
            initializeInBatches(layersData, batchSize),
            initializeInBatches(userLayers, batchSize, { isUserLayers: true }),
        ]).then(function () {
            console.log("All layers initialized");

            localThis.loaded = true;
            assignIndexLayer();
            localThis.doAfterInit();
            localThis.tagspanel.loadTags();
            refreshZindexes();

            document.dispatchEvent(new CustomEvent("layer-list-panel.init"));
        });
    };

    /**
     * Инициализация конкретного слоя
     * @param {*} layerData данные слоя
     * @param {*} initLayerInstance класс-имплементация слоя
     * @returns
     */
    var initializeLayer = function (layerData, initLayerInstance, isUserLayer) {
        if (layerData.provider == "gi2") return;

        const layerInstance = initLayerInstance([layerData, localThis]);

        if (layerInstance.initialized) {
            if (isUserLayer) {
                localThis.addUserLayer(layerInstance);
