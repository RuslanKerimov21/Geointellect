window.LayerTag = function (tag, parent) {
    var localThis = this;
    var svg;
    var img = null;
    this.parent = parent;

    this.name = tag;

    this.isActive = false;

    this.selfelement = $("<div/>", {
        order: 0,
        "data-selected": "false",
        title: this.name,
    });
    this.selfelement.addClass("layer-list-layer-tag-item");

    var label = $("<div/>", { tagname: this.name }).addClass("label");

    var icon = $("<div/>")
        .addClass("icon-group-container")
        .append($("<div/>", { tagname: this.name }).addClass("icon-group"));

    var circle = $("<div/>").addClass("selected-circle");

    label.append(this.name, circle);

    this.selfelement.append(label, icon);

    this.toggle = function () {
        if (localThis.isActive) {
            localThis.off();
        } else {
            localThis.on();
        }
    };

    this.off = function () {
        if (localThis.isActive === false) return;
        localThis.isActive = false;
        this.selfelement.attr("data-selected", "false");
    };

    this.on = function () {
        if (localThis.isActive === true) return;
        localThis.isActive = true;
        this.selfelement.attr("data-selected", "true");
        localThis.parent.tagsmenu.favorites.attr("data-selected", false);
    };

    this.onlightingTagEnabledLayer = function () {
        this.selfelement.attr("data-enabledLayer", true);
    };
    this.offlightingTagEnabledLayer = function () {
        this.selfelement.removeAttr("data-enabledLayer");
    };
    this.selfelement.on("click", function () {
        localThis.toggle();
        console.log("applyLayerListFilter call from self element on click");
        localThis.parent.applyLayerListFilter();
        let groups = localThis.parent.parent.layerGroups;

        groups.forEach((_group) => {
            _group.checkVisibleLayers();
            _group.group_visibility();
        });
    });
};

