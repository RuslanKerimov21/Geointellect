    /**
     * Карта, которая содержит инициализирующую функцию для каждого типа слоя.
     * Внутри функции вызывается конструктор класса, отвечающего за этот тип слоя
     * @type {{
     *   [layerType: string]: (args: any[]) => LayerClassInstance
     * }}
     */
    const layerTypes = {
        dynamic: (args) => new DynamicLayer(...args), // TODO: убрать вызов
        "dynamic-empty": (args) => new DynamicEmpty(...args),
        "dynamic-point": (args) => new DynamicLayer(...args),
        "dynamic-polygon": (args) => new DynamicLayer(...args),
        "dynamic-line": (args) => new DynamicLayer(...args),
        "vector-line": (args) => new DynamicLayer(...args),
        "vector-point": (args) => new DynamicLayer(...args),
        raster: (args) => new DynamicLayer(...args),
        "vector-polygon": (args) => new VectorLayer(...args),
        "vector-point-cluster": (args) => new ClusterLayer(...args),
        "vector-point-multi-cluster": (args) => new MultiClusterLayer(...args),
        "vector-point-cluster-terra": (args) => new ClusterTerrasLayer(...args),
        "vector-point-pie-chart": (args) =>
            new VectorPointPiechartLayer(...args),
        wmts: (args) => new WmtsLayer(...args),
        "wmts-empty": (args) => new WmtsLayer(...args),
        "vector-point-marker": (args) => new VectorPointMarkerLayer(...args),
        "territory-cluster": (args) => new TerrritoryClusteringLayer(...args),
        marker: (args) => new MarkerLayer(...args),

        user: (args) => new UserLayer(...args),

        /**
         * Возвращает функцию-инициализатор по типу слоя
         * @param {string} type
         * @returns {(args) => LayerClassInstance}
         * @throws {Error}
         */
        get: (type) => {
            if (layerTypes[type]) return layerTypes[type];

            throw new Error(
                `There is no initialization function for layer type ${type}. Add it manually inside layerTypes object definition in layer-list-panel module`,
            );
        },
    };

    /**
     * Инициализирует слои асинхронно пачками по несколько элементов.
     * Это нужно, чтобы избежать полной загрузки основного потока и фризов отрисовки DOM
     * @param {*} layersData
     * @param {number} batchSize
     * @param {{ isUserLayers: boolean }} options
     */
    var initializeInBatches = function (layersData, batchSize, options = {}) {
        return new Promise(function (resolve) {
            const { isUserLayers } = options;
            let i = 0;

            const processNextBatch = () => {
                const end = Math.min(i + batchSize, layersData.length);

                for (; i < end; i++) {
                    const layerData = layersData[i];

                    try {
                        let initLayerInstance;

                        if (!isUserLayers) {
                            initLayerInstance = layerTypes.get(layerData.type);
                        } else {
                            initLayerInstance = layerTypes.get("user");
                        }

                        const start = performance.now();

                        initializeLayer(
                            layerData,
                            initLayerInstance,
                            isUserLayers,
                        );
                        console.log(
                            `Layer #${layerData.id} (${
                                layerData.type
                            }) initialized in ${performance.now() - start}ms`,
                        );
                    } catch (error) {
                        console.error(
                            `Cannot initialize layer ${layerData.id}`,
                        );
                        console.error(error);
                    }
                }

                if (i < layersData.length) {
                    setTimeout(
                        processNextBatch,
                        localStorage.getItem(
                            "layer-list-panel-batch-timeout",
                        ) ?? 0,
                    );
                } else {
                    resolve();
                }
            };

            processNextBatch();
        });
    };

