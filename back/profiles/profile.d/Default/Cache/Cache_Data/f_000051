    /*Класс, который будет управлять объектом layerListViewObject*/
    function LayerListView() {
        let self = this;
        const hiddenLayers = []; /* Удаленные слои */
        const listLayersDIV = localThis.layersWindow[0].querySelector(
            ".layer-list .scroll-container",
        );
        let loader = null;

        self.renderButton = function (_type, _button) {
            let button = null;
            let typeIcon =
                _type === "list"
                    ? layerListViewObject.icons[0]
                    : layerListViewObject.icons[1];
            let typeName =
                _type === "list" ? _button?.title_folder : _button?.title_list;

            button = document.createElement("div");

            button.classList.add("icon-item", "button-view-type", typeIcon);

            if (_button.type === "context-menu") {
                button.classList.add("context-menu-item");
                button.innerHTML = typeName;
            }

            if (_button.type === "header-button") {
                button.classList.add("header-button");
            }

            button.setAttribute("title", typeName);
            button.addEventListener("click", toggleView);
            return button;
        };

        self.addButtonToContextMenu = function () {
            const _contextMenu = localThis.contextMenu[0];
            const button = self.renderButton(layerListViewObject.view, {
                type: "context-menu",
                title_folder: gltxt("show_as_folders"),
                title_list: gltxt("show_as_list"),
            });

            _contextMenu.querySelector(".button-view-type")?.remove();
            _contextMenu?.append(button);
        };

        self.addButtonToHeaderPanel = function () {
            const _header =
                localThis.layersWindow[0].querySelector(".layer-list-header");
            const button = self.renderButton(layerListViewObject.view, {
                type: "header-button",
                title_folder: gltxt("show_as_folders"),
                title_list: gltxt("show_as_list"),
            });

            _header.querySelector(".button-view-type")?.remove();
            _header?.append(button);
        };

        self.setType = function (_type) {
            loader = new Loading(listLayersDIV);
            loader.init();
            loader.showLoader();
            loader.createPelina(listLayersDIV);
            self.addButtonToContextMenu();
            self.addButtonToHeaderPanel();
            listLayersDIV.setAttribute("data-view", _type);
            updateViewHandler();
        };

        self.setGroups = function (_group) {
            layerListViewObject.groups.push(_group);
        };

        self.getGroups = function () {
            return layerListViewObject.groups;
        };

        let removeAllLayersAndGroups = function () {
            const scrollContainer = localThis?.layersWindow[0]?.querySelector(
                ".layer-list .scroll-container",
            );
            if (!scrollContainer) return;

            const elements = Array.from(scrollContainer.children);

            elements.forEach((item) => {
                const isGroup = item.classList.contains("layer-item-group");
                const isItem = item.classList.contains("layer-item");
                const isUserLayer =
                    item.getAttribute("data-type") === "user-layer-group";

                if ((isGroup || isItem) && !isUserLayer) {
                    item.remove();
                } /*удалим все,кроме юзер папки*/

                if (isItem) {
                    hiddenLayers.push(item);
                } /* Сохр. только layer-item  */
            });
        };
        function toggleView() {
            if (layerListViewObject.view === "list") {
                layerListViewObject.view = "folders";
                self.setType("folders");
            } else {
                layerListViewObject.view = "list";
                self.setType("list");
            }
            localThis.hideContextMenu();
        }

        function restoreHiddenLayers() {
            const scrollContainer = localThis?.layersWindow[0]?.querySelector(
                ".layer-list .scroll-container",
            );
            if (!scrollContainer || hiddenLayers.length === 0) return;

            hiddenLayers.forEach((layerItem) => {
                scrollContainer.appendChild(layerItem);
            });

            hiddenLayers.length = 0;
        }

        let updateViewHandler = function () {
            if (self.currentModeHandler) {
                self.currentModeHandler.destroy();
            }

            removeAllLayersAndGroups();

            switch (layerListViewObject.view) {
                case "list":
                    loader.removeLoader();
                    loader.removePelina();
                    restoreHiddenLayers();
                    console.log(
                        "applyLayerListFilter call from updateViewHandler",
                    );
                    localThis.applyLayerListFilter();

                    break;
                case "folders":
                    let layersCache = new Map();

                    localThis.dublicatesLayer = [];
                    localThis.layerGroups = [];

                    let resolveCycle;
                    const cyclePromise = new Promise((resolve) => {
                        resolveCycle = resolve;
                    });

                    self.getGroups().forEach((_group) => {
                        let groupInst = new LayerGroup(
                            _group.name,
                            localThis,
                            false,
                            "layer-group",
                        );
                        localThis.layerGroups.push(groupInst);

                        for (const [
                            index,
                            layer,
                        ] of _group.layers_tag.entries()) {
                            let object;

                            if (layersCache.has(layer)) {
                                let opts = localThis.globalStore
                                    .getState()
                                    .getOptions(layer).options;

                                let layerDubl = new LayerElementContollers(
                                    opts,
                                    false,
                                    null,
                                );
                                groupInst.setGroupIDToLayer(layerDubl);
                                groupInst._addLayer(layerDubl.getParts().self);
                                localThis.dublicatesLayer.push({
                                    id: layer,
                                    object: layerDubl,
                                });
                                groupInst.idsLayers.push(opts.id);
                            } else {
                                object = localThis.findLayerById(layer);
                                layersCache.set(layer, {
                                    id: object.opts.id,
                                });

                                groupInst._addLayer(object.getHtmlElement());
                                groupInst.setGroupIDToLayer(
                                    object.elementLayer,
                                );
                                groupInst.idsLayers.push(object.opts.id);
                            }
                        }
                        groupInst.checkVisibleLayers();
                        groupInst.group_visibility();
                    });
                    resolveCycle();
                    cyclePromise.then(() => {
                        setTimeout(function () {
                            console.log(
