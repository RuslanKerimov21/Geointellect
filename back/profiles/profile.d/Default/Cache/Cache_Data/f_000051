        });

        _order0.forEach(function (item) {
            if (_order_final.indexOf(item) == -1) {
                _order_final.push(item);
            }
        });

        _order_final.forEach(function (item) {
            localThis.addTag(item, false);
        });

        localThis.parent.commonActions["select-all-tags"] =
            localThis.enableAllTags;
        localThis.parent.commonActions["unselect-all-tags"] =
            localThis.disableAllTags;

        DoWebApiAction("/layers/group_icons", {
            groups: _order_final.join(";"),
        }).done(function (r) {
            if (r.success) {
                for (var s in r.results) {
                    const tag = layerListPanel.layersWindow.find(
                        '.icon-group[tagname="' + s + '"]',
                    );

                    tag.css("background-image", "url('" + r.results[s] + "')");

                    if (!r.results[s]) {
                        tag[0].innerHTML = s.slice(0, 2).toUpperCase();
                    }
                }
            }
        });

        localThis.disableAllTags();
        localThis.enableTagByName("Проживание");
        /* parent.searchEnabledLayers();*/
    };

    this.findTag = function (tagname) {
        var thetag = null;
        localThis.tags.forEach(function (tag) {
            if (tag.name.toLowerCase() === tagname.toLowerCase()) {
                thetag = tag;
            }
        });
        return thetag;
    };

    this.selectedTagNames = function () {
        var tags = [];
        localThis.tags.forEach(function (tag) {
            if (tag.isActive === true) {
                tags.push("" + tag.name);
            }
        });
        return tags;
    };

    this.enableAllTags = function () {
        localThis.tags.forEach(function (tag) {
            tag.on();
        });
        console.log("applyLayerListFilter call from enable all tags");
        localThis.applyLayerListFilter();
        $(".layer-list-layer-tags")
            .find("[data-action=select-all-tags]")
            .attr("data-selected", "false");
        $(".layer-list-layer-tags")
            .find("[data-action=unselect-all-tags]")
            .attr("data-selected", "true");
    };

    this.disableAllTags = function () {
        localThis.tags.forEach(function (tag) {
            tag.off();
        });
        console.log("applyLayerListFilter call from disable all tags");
        localThis.applyLayerListFilter();
        $(".layer-list-layer-tags")
            .find("[data-action=select-all-tags]")
            .attr("data-selected", "true");
        $(".layer-list-layer-tags")
            .find("[data-action=unselect-all-tags]")
            .attr("data-selected", "false");
    };

    this.enableTagByName = function (tagname) {
        localThis.tags.forEach(function (tag) {
            if (tag.name.toLowerCase() === tagname.toLowerCase()) {
                tag.on();
            }
        });
        console.log("applyLayerListFilter call from enable tag by name");
        localThis.applyLayerListFilter();
    };

    this.disableTagByName = function (tagname) {
        localThis.tags.forEach(function (tag) {
            if (tag.name.toLowerCase() === tagname.toLowerCase()) {
                tag.off();
            }
        });
        console.log("applyLayerListFilter call from disable tag by name");
        localThis.applyLayerListFilter();
    };

    this.tagactions.on("click", function () {
        var actionName = $(this).attr("data-action");
        if (localThis.parent.commonActions.hasOwnProperty(actionName)) {
            localThis.parent.commonActions[actionName]();
        }
    });

    this.tagsmenu.button.on("click", function () {
        if (localThis.tagsmenu.isexpanded === true) {
            localThis.layerTypesCollapse();
        } else {
            localThis.layerTypesExpand();
        }
    });

    this.tagsmenu.favorites.on("click", function () {
        // localThis.parent.layerList.forEach(function (layer) {
        //     try {
        //         let _layer = layer;
        //         if (layer?.opts) { _layer = layer.opts; }

        //         if (_layer.isFavorite == true) {
        //             layer.show();
        //         }
        //         else {
        //             layer.hide();
        //         }
        //     } catch (e) {
        //         console.warn(e);
        //     }
        // });

        const { getOptions } = window.layerListPanel.globalStore.get();

        console.log("tags", localThis.parent.tags);

        localThis.disableAllTags();

        localThis.tagsmenu.favorites.attr("data-selected", true);

        for (const layer of localThis.parent.layerList) {
            if (getOptions(layer.id).options.isFavorite) {
                try {
                    layer.show();
                } catch (e) {
                    console.warn(e);
                }

                continue;
            }

            try {
                layer.hide();
            } catch (e) {
                console.warn(e);
            }
        }
    });
};

document.addEventListener("DOMContentLoaded", function () {
    setTimeout(function () {
        window.layerListPanel = new LayerListPanel();
        var prepare = getParameterByName("prepare");
        if (typeof prepare === "undefined" || prepare === null) {
            DoNothing();
        } else {
            setTimeout(function () {
                window.layerListPanel.show();
            }, 3000);
        }
    }, 1000);
});
