                /*hard:*/
                goods.push(sobj.name);
                var headerItem = $("<td/>", { "data-field": sobj.name }).html(sobj.aliases[0].alias);
                header.append(headerItem);
            }
        });

        if (o.Objects[0].Geom != null) {
            var yHeaderItem = $("<td/>", { "data-field": "yHeaderItem" }).html(gl.text.coords_lat);
            header.append(yHeaderItem);
            var xHeaderItem = $("<td/>", { "data-field": "xHeaderItem" }).html(gl.text.coords_lon);
            header.append(xHeaderItem);
        }

        table.append($("<thead/>").append(header));

        var tbody = $("<tbody/>");

        o.Objects.forEach(function (robj) {
            var row = $("<tr/>");

            goods.forEach(function (fname) {
                var rowItem = $("<td/>", { "data-field": fname }).html(robj.Attributes[fname]);
                row.append(rowItem);
            });

            if (robj.Geom != null) {
