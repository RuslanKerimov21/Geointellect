    var getDetailedPopData = function (stats) {

        var data = [];
        if (isArray(stats)) {
            stats.forEach(function (item) {
                if (item.hasOwnProperty("data")) {
                    var ddd = JSON.parse(item["data"]);
                    if (ddd.hasOwnProperty("type") && ddd["type"] === "popd") {
                        data.push(ddd);
                    }
                }
            });
        } else {
            return null;
        }

        if (data.length === 0) {
            return null;
        }

        var maxp = data.reduce(function (a, b) { return Math.max(a, b.amount); }, 0);
        var mdat = data.filter(function (d) { return d.sex === 0; }).sort(function (a, b) { return a.from - b.from; });
        var fdat = data.filter(function (d) { return d.sex === 1; }).sort(function (a, b) { return a.from - b.from; });

        var labels = [];
        var mdata = [];
        var fdata = [];

        labels.push("x");
        mdata.push("male");
        fdata.push("female");

        var idx_last = mdat.length - 1;

        for (var idxx = 0; idxx <= idx_last; idxx++) {

            var mitem = mdat[idxx];
            var fitem = fdat[idxx];

            mdata.push(mitem.amount);

            fdata.push(fitem.amount);

            var lbl = "";

            if (idxx === 0) {
                lbl = "до " + mitem.to;
            }
            else if (idxx === idx_last) {
                lbl = "" + mitem.from + "+";
            }
            else {
                lbl = "" + mitem.from + "-" + mitem.to;
            }

            labels.push(lbl);

        }

        var dresult = {
            labels: labels,
            mdata: mdata,
            fdata: fdata
        };

        return dresult;
    };

