                let query_token = null;
                let query = DoWebApiAction("/requesthistory/list", mydata);

                if (localThis.GetReportShareToken() !== null) {
                    query_token = DoWebApiAction("/requesthistory/get_one_by_shared_token", { shared_token: localThis.GetReportShareToken() });
                }

                if (query_token !== null) {
                    $.when(query, query_token).done(function (boo, voo) {
