    /*сохранить новое имя отчёта*/
    var saveRenaming = function () {
        var txt = "";
        var chk = localThis.selfelement.find("div[data-elem=row-title]");
        if (chk.children().length > 0) {
            chk.children().each(function () {
                txt += $(this).text() + " ";
            });
        } else {
            txt += chk.text();
        }
        var newName = $.trim(txt);
        var oldName = localThis.parent.data.Name;

        if (newName === oldName) {
            cancelRenaming();
            return;
        }

        if (newName.length === 0) {
            cancelRenaming();
            return;
        }

        var mydata = {
            login: window.UserModule.userData.Info.Login,
            uid: localThis.parent.data.Uid,
            oldname: oldName,
            newname: newName
        };

        localThis.selfelement.find("div[data-elem=row-title]").prop('contenteditable', false).removeClass("editable");
