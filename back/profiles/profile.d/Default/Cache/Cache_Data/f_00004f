function Nalagator() {
    var localThis = this;
    this.geometries = [];
    this.union = null;
    this.divide = null;
    this.result = null;

    this.geoms = null;

    this.geoData = null;

    this.request = {};
    this.request.Login = window.UserModule.userData.Info.Login;
    this.request.Tooltype = "info-polygon";
    this.request.Metadata = {
        ToolName: "Информация в зоне",
        Location: null,
        Area: 0.0,
        Perimeter: 0.0,
        Buffer: 0.0
    };
    this.request.Address = "Без адреса";
    this.request.Name = "Без названия";
    this.request.Point = null;
    this.request.Line = null;
    this.request.Polygon = null;
    this.request.GeointellectLayers = window.layerListPanel.getEnabledLayers();
    this.request.UserLayers = window.layerListPanel.getEnabledUserLayers();
    /*180 меридиан, убираю бордер*/
    this.styles = [
                    {
                        stroke: true,
                        color: "#FFFFFF",
                        weight: 1,
                        opacity: 0.4,
                        fill: true,
                        fillColor: "#3D91DE",
                        fillOpacity: 0.6,
                        clickable: true
                    }, {
                        stroke: true,
                        color: "#FFFFFF",
                        weight: 1,
                        opacity: 0.4,
                        fill: true,
                        fillColor: "#FF0000",
                        fillOpacity: 0.4,
                        clickable: true
                    }
    ];

    this.waitmarker = null;

    var checkIsFreeToGo = function () {
        if (window.mapModule01.infopanel.visible) {
            window.mapModule01.infopanel.blink();
            alert("<span style=\"font-weight:bolder;color:red;\">Сейчас нельзя запустить расчёт!</span><br/>Сначала завершите работу с активным инструментом");
            return false;
        };
        return true;
    };

    /*проверяет геометрию на корректность*/
    var checkGeometries = function () {
        localThis.geometries = [];
        localThis.geometries.length = 0;

        var result = true;

        window.requestHistoryModule.historyElements.forEach(function (item) {
            if (item.selected) {
                if (item.data.Polygon !== null) {
                    var poly = item.data.Polygon.toGeoJSON();
                    localThis.geometries.push(poly.features[0]);
                }
            }
        });

        if (localThis.geometries.length < 2) result = false;

        return result;
    };

    /*проверяет, всё ли нужное есть в отчётах*/
    var checkArray = function () {
        
        var selected = 0;
        var overall = 0;
        var maxzones = 21; /*тут менять максимальное количество зон*/

        if (window.requestHistoryModule.historyElements.length === 0) {
            alert("В результатах нет сохранённых зон для пересечения");
            return false;
        }

        $.each(window.requestHistoryModule.historyElements, function (i, o) {
            if (o.selected && o.data.Tooltype.indexOf("point") === -1) selected += 1;
            if (o.data.Tooltype.indexOf("point") === -1) overall += 1;
        });

        if (overall === 1) {
            alert("В результатах всего одна зона. Нужно минимум две зоны");
            return false;
        }

        /*todo: убрать хардкодное значение ХХХ зон*/
        if (selected < 2 || selected > maxzones) {
            alert("Должно быть выбрано от 02 до " + maxzones + " зон для пересечения");
            return false;
        }
        return true;
    };

    /*объединение массива полигонов*/
    var unionArray = function(arr) {
        var temp = null;
        $.each(arr, function (i, o) {
            if (temp === null) {
                temp = o;
            } else {
                temp = turf.union(o,temp);
            }
        });
        return temp;
    };

    /*пересечение массива полигонов*/
    var intersectArray = function(arr) {

        var intersections = [];
        $.each(arr, function (i, o) {
            $.each(arr, function (i0, o0) {
                if (i !== i0) {
                    var chk = turf.intersect(o, o0);
                    if (chk !== null) {
                        intersections.push(chk);
                    }
                }
            });
        });

        var unionedIntersections = unionArray(intersections);
        return unionedIntersections;
    };

    var divideArray = function (arr) {
        /*
        var divide = DoAction("Intersector/divide",
            {
                login: window.UserModule.userData.Info.Login,
                features: JSON.stringify(arr)
            });
        */

        var req_arr = [];

        $.each(arr, function (i, ff) {
            var new_ff = deepCopy(ff);
            new_ff.geometry = convertLongitudesTo180(new_ff.geometry);
            req_arr.push(new_ff);
        });

        var divide = DoWebApiAction("/intersector/divide",
            {
                features: JSON.stringify(req_arr)
            });
        return divide;
    };

    this.clearGeodata = function () {
        if (localThis.geoData !== null) {
            window.MAP.removeLayer(localThis.geoData);
            localThis.geoData = null;
        }
    };

    this.renderGeodata = function (withdelay) {

        if (typeof withdelay === "undefined") {
            withdelay = 0;
        }

        localThis.clearGeodata();

        localThis.geoData = L.geoJSON();
        localThis.geoData.addTo(window.MAP);

        L.setOptions(localThis.geoData, {
            pane: "specialFX",
            interactive: true,
            style: function (feature) {
                return localThis.styles[feature.properties.selected];
            },
            onEachFeature: function (feature, layer) {
                layer.on({
                    click: function (e) {
                        
                        if (feature.properties.selected === 0) {
                            feature.properties.selected = 1;
                        } else {
                            feature.properties.selected = 0;
                        }
                        localThis.renderGeodata();
                    }
                });
            }
        });

        var delay = 0;

        window.NalagatorResult.forEach(function (poly) {
            delay += withdelay;
            if (withdelay > 0) {
                $.wait(function () {
                    localThis.geoData.addData(poly);
                }, delay);
            } else {
                localThis.geoData.addData(poly);
            }
        });

        window.MAP.invalidateSize();
    };

    this.combineSelectedPolygon = function () {
        var temp = [];
        $.each(window.NalagatorResult, function (i, poly) {
            if (poly.properties.selected === 1 && poly.geometry.type === "Polygon") {

                var new_poly = deepCopy(poly);
                new_poly.geometry = convertLongitudesTo180(new_poly.geometry);

                temp.push(new_poly);
            }
        });
        var result = unionArray(temp);
        return result;
    };

    this.customDialogContent = function () {
        var result = $("<div/>", { class:"nalagator-container"});

        result.append($("<h1/>").html("Инструмент наложения зон"));

        var leftHelp = $("<div/>",{ class: "gif-nalagator-help" }).css({
            position: "absolute",
            width: "300px",
            height: "340px",
            top: "60px",
            left: "40px",
            "background-image": "url(/resources/funcparts/request-history/help/nalagator_help.gif)"
        });

        var rightInfo = $("<div/>", {class:"tools-container"}).css({
            position: "absolute",
