    /*генерит таблицу МТС квадрат*/
    var renderKvadratMtsTable = function () {
        var content = $("<table/>").addClass("stat-table-block");
        var values = localThis.parent.data.ReportContent.Values;
        if (values === null) {
            content.html("<b class='font-error'>"+gltxt("no_data")+"</b>");
            return content;
        }

        /*делаем шапку таблицы для стат записей*/

        var th = $("<tr/>").addClass("trh");
        th.append($("<th/>").addClass("bg-main").html("<div class='pA'><span>№</span></div>"));

        var trs = [];

        for (var i = 0; i < values.length; i++) {
            var module = values[i];

            if (module.Module === "KvadratGiMts" || module.Module === "KvadratGiToshkent" || module.Module === "KvadratGiKCell") {

                for (var j = 0; j < module.Values.length; j++) {

                    var modValues = module.Values[j];
                    var total = modValues.total;
                    var endRow = $("<tr/>");
                    endRow.append($("<td/>").addClass("td1").html(gltxt("total") + ":"));

                    for (var k = 0; k < total.length; k++) {
                        th.append($("<th/>", { "class": "rotate" }).addClass("bg-main").html("<div><span>" + total[k].key + "</span></div>"));
                        endRow.append($("<td/>", { style: "font-weight:bold" }).addClass("td1").html(parseInt(total[k].value)));
                    }

                    trs.push(endRow.clone());

                    var kvdatas = modValues.kvdatas;

                    for (var l = 0; l < kvdatas.length; l++) {

                        var _vsego = parseInt(kvdatas[l].calc_data[0].value);
                        var _color = getColorFromMtsLegend(modValues.legend, _vsego);

                        var tr = $("<tr/>");

                        tr.append($("<td/>").addClass("td1").css({ "background-color": _color }).html(l + 1));

                        for (var h = 0; h < kvdatas[l].calc_data.length; h++) {
                            if (h === 0) {
                                tr.append($("<td/>", { style: "color:#e30611;font-weight:bold" }).addClass("td1").html(parseInt(kvdatas[l].calc_data[h].value)));
                            }
                            else {
                                tr.append($("<td/>").addClass("td1").html(parseInt(kvdatas[l].calc_data[h].value)));
                            }
                        }

                        trs.push(tr);
                    }

                    trs.push(endRow);
                }
            }
        }

        content.append(th);

        $.each(trs, function (i, el) {
            content.append(el);
        });

        if (values.length === 0) {
            content.html("<b class='font-error'>"+gltxt("no_data")+"</b>");
        }
        return content;
    };

