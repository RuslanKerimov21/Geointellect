    this.GetReportShareToken = function () {
        var token = null;
        if (window.giLinksImplement?.parameters !== undefined) {
            if (window.giLinksImplement?.parameters !== null) {
                window.giLinksImplement.parameters.forEach(function (operation) {
                    if (operation.type == "report") {
                        if (window.giLinksImplement?.token !== undefined) {
                            token = window.giLinksImplement?.token;
                        }
                    }
                });
            }
        }

        return token;
    };

    this.getHistoryList = function () {
        /*загружает историю отчётов с сервера*/

        console.log("=====> this.getHistoryList");

        _timers.wait_history_list = setInterval(function () {

            console.log("=====> _timers.wait_history_list");

            if (typeof window.UserModule?.userData?.Info?.Login !== "undefined") {
