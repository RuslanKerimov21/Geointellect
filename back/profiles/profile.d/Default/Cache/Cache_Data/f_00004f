    this.doCustom = function () {

        var poly = localThis.combineSelectedPolygon();

        if (poly !== null) {

            localThis.clearGeodata();
            localThis.result = poly;
            var pos = turf.pointOnSurface(poly);
            var centroidPt = turf.flip(pos);
            localThis.request.Metadata.Area = turf.area(poly);

            var feature = poly;

            localThis.waitmarker = $.extend({}, centroidPt.geometry);

            localThis.result = L.geoJSON(feature.geometry);
            localThis.result.addTo(window.MAP);
            localThis.result.setStyle(L.Draw.Circle.prototype.options.shapeOptions);
            L.setOptions(localThis.result, {
                pane: "overlayPane",
                interactive: false
            });

            var gc = localThis.geocode(centroidPt);

            gc.done(function (r) {
                if (r.status === "success") {
                    localThis.request.Metadata.Location = r.results;
                    localThis.request.Address = r.results.RegionName;
                    localThis.request.Name = "Наложение - " + r.results.RegionName;
                    localThis.request.Point = null;
                    localThis.request.Line = null;
                    /*localThis.request.Polygon = getPreparedGeoJsonAsObject(localThis.result);*/
                    localThis.request.Polygon = feature.geometry;
                    localThis.runRequest();
                    localThis.clearGeodata();
                    window.requestHistoryModule.dialogWindow.closeToolDialog();
                    window.mapModule01.MapClickAllowed = true;
                    window.mapModule01.guessMapClickAllowedOverride();
                }
            });

