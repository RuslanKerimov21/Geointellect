function RequestHistoryModule(varname) {

    var localThis = this;

    let reportsRibbon = null;

    this.selectedUids = [];

    this.varname = varname;
    this.id = "request-history";
    this.dialogWindow = null;
    
    this.historyElements = [];
    this.visible = false;
    this.initialized = false;
    this.loaded_history = false;

    this.listItemTemplate = null;
    this.resultItemTemplate = null;
    this.toolDialogTemplate = null;
    this.hideOnZoom = [0, 11];
    this.datesReports = ["14.02.2022", "15.02.2022", "16.02.2022"];
    this.arrayPrev = [];
    this.rendersLayotsElements = [];
    this.renderPopulationCounterDetailedYearsElements = [];
    var _timers = {};
    this.mobileStickerBtn = null;
    this.filterPanel = null;

    this.markerStyle = {
        icon: vertexIcon,
        opacity: 1.0
    };
    
    function createRibbon() {
        reportsRibbon = HtmlElementFromText(localizeHtml(`
            <div class="sticker-container bg-color-secondary font-secondary" data-elem="sticker-container">
                <div class="stickerContainerContent">
                    <k>{{rep_reports}}</k>
                    </br>
                    <k data-elem="query-kolvo">
                    </k>
                </div>
            </div>`));

        if (window.detectMobile() == "mobile") {
            localThis.mobileStickerBtn = window.ToolPanelModule.getNewPanelButton({
                "type": "small",
                "float": "rightPanelCenter",
                "order": 1,
                "mobile": true,
                "onClick": function () {
                    if (!localThis.visible) localThis.dialogWindow.on();
                },
                "title": "",
                "class": "rightRibbonButton gr-file",
                "mapContainer": "mapPanel"
            });
            localThis.mobileStickerBtn.addToTopPanel();
            localThis.mobileStickerBtn.$elemButton.attr("data-help", "reports-btn");
            localThis.mobileStickerBtn.$elemButton[0].appendChild(reportsRibbon);

        } else {
            document.getElementById("reportsRibbon").appendChild(reportsRibbon);
        }

        reportsRibbon.addEventListener("click", function (e) {
            if (!localThis.visible) localThis.dialogWindow.on();
        });
    };

    /*---------------------------------*/
    /*      публичные методы           */
    /*---------------------------------*/

    this.setRibbonValue = function (value) {
        reportsRibbon.querySelector("[data-elem=query-kolvo]").innerHTML = value;
    };

    this.setRibbonValueFx = function (value) {
        localThis.setRibbonValue(value);
        localThis.jumpSquareReports();
    };

    this.jumpSquareReports = function () {
        let old = getComputedStyle(reportsRibbon).marginTop;

        function animateRibbon(to, dur, delay, cb) {
            setTimeout(function () {
                let el = reportsRibbon;
                el.style.transition = `margin-top ${dur}ms ease`;
                el.style.marginTop = to;

                el.addEventListener('transitionend', function handler() {
                    el.removeEventListener('transitionend', handler);
                    if (cb) cb();
                });
            }, delay);
        }

        animateRibbon('-20px', 100, 100, function () {
            animateRibbon('20px', 100, 100, function () {
                animateRibbon(old, 100, 100);
            });
        });
    };

    /*показать перелёт отчёта в блокнотик (анимация)*/
    this.dropFlyerFx = function (point) {
        const the_flyer = HtmlElementFromText(`<div class="flyer"></div>`);

        Object.assign(the_flyer.style, {
            position: 'absolute',
            top: '0px',
            left: '0px',
            opacity: '0',
            transform: 'scale(1)'
        });

        let sourceTop, sourceLeft;
        if (point && point._icon) {
            sourceTop = point._icon._leaflet_pos.y - 50;
            sourceLeft = point._icon._leaflet_pos.x - 50;
        } else {
            sourceTop = 400;
            sourceLeft = 750;
        }
        the_flyer.style.top = `${sourceTop}px`;
        the_flyer.style.left = `${sourceLeft}px`;

        document.body.appendChild(the_flyer);
        the_flyer.getBoundingClientRect();

        the_flyer.style.transition = 'opacity 200ms ease';
        the_flyer.style.opacity = '0.9';

        function onFade(e) {
            if (e.propertyName !== 'opacity') return;
            the_flyer.removeEventListener('transitionend', onFade);

            const container = document.body.querySelector('[data-elem=sticker-container]');
            const size = GSize.fromElement(container);
            const targetTop = size.top - 20;
            const targetLeft = size.left - 20;

            the_flyer.style.transition = 'top 300ms ease, left 300ms ease, transform 300ms ease';
            the_flyer.style.top = `${targetTop}px`;
            the_flyer.style.left = `${targetLeft}px`;
            the_flyer.style.transform = 'scale(0.1)';

            the_flyer.addEventListener('transitionend', onMove, { once: true });
        };

        function onMove(e) {
            if (e.propertyName !== 'transform') return;

            the_flyer.style.transition = 'transform 300ms ease, opacity 300ms ease';
            the_flyer.style.transform = 'scale(0.1)';
            the_flyer.style.opacity = '0';

            the_flyer.addEventListener('transitionend', onHide);
        };

        function onHide(e) {
            if (e.propertyName !== 'opacity') return;
            the_flyer.removeEventListener('transitionend', onHide);
            the_flyer.remove();
        };

        the_flyer.addEventListener('transitionend', onFade);

        setTimeout(function () {
            if (the_flyer) {
                the_flyer.style.opacity = '0.1';
                the_flyer.style.transform = 'scale(0.1)';
                the_flyer.remove();
            }
        }, 1000);
    };

    function DeleteAllReports() {
        var svc = DoWebApiAction("/requesthistory/delete_all", { magic: "wtf" });
        svc.done(function (r) {
            if (r.success) {
                blinkmsg("deleted", 1000, "success");
                localThis.reload();
            }
            else {
                blinkmsg(r.message, 5000, "danger");
            }
        });
    };

    this.removeAllReports = function () {
        let hhttmmll = gltxt("delete_all_reports_sure_q");
        let b = {
            type: "ok",
            action: function () {
                DeleteAllReports();
            },
            title: "",
            text: gltxt("yes"),
            icon: false,
            "class": "btn_confirm"
        };
        let n = {
            type: "skip",
            action: function () { },
            title: "",
            text: gltxt("no"),
            icon: false,
            "class": "btn_confirm customAlertBtnCancel"
        };

        customConfirm(hhttmmll, null, [b, n], 400, 120);
    };

    this.clearSelection = function () {
        window.requestHistoryModule.historyElements.forEach(function (o) {
            o.unselect();
        });
        localThis.selectionChanged();
    };

    this.turnOnVisible = function () {

        localThis.selectedUids = [];
        localThis.selectedUids.length = 0;

        window.requestHistoryModule.historyElements.forEach(function (o) {
            o.unselect();
        });

        window.requestHistoryModule.historyElements.forEach(function (o) {
            if (o.expanded) {
                o.select();
            }
        });

        localThis.selectionChanged();
    };

    /*список всех включённых галочек*/
    this.selectedIds = function () {
        return window.requestHistoryModule.historyElements
            .filter(function (o) { return o.selected; })
            .map(function (o) {return o.data.Uid; });
    };

    /*инициализация модуля*/
    function init() {
       
        if (localThis.initialized) return;

        createRibbon();
       
        localThis.dialogWindow = new RequestHistoryDialog(localThis);
        localThis.dialogWindow.createDialog();

        localThis.dialogWindow.getHistoryList();

        _timers.wait_history_list = setInterval(function () {

            console.log("=====> localThis.loaded_history", localThis.loaded_history);
            
            if (localThis.loaded_history) {

                clearInterval(_timers.wait_history_list);

                console.log("=====> localThis.dialogWindow.GetReportShareToken()", localThis.dialogWindow.GetReportShareToken());

                if (localThis.dialogWindow.GetReportShareToken() !== null) {

                    let select_elem = null;

                    localThis.historyElements.forEach(function (elem) {
                        if (elem.data.SharedToken == localThis.dialogWindow.GetReportShareToken()) {
                            select_elem = elem;
                        }
                    });

                    localThis.dialogWindow.on();
                    if (select_elem != null) {
                        select_elem.select();
                    }

                }
            }
        }, 1000);

        localThis.initialized = true;

        console.log("=====> localThis.initialized", localThis.initialized);

        if (window.clearActions) {
            window.clearActions.push(localThis.clearSelection);
        }

        window.mapModule01.registerMapMoveEndEvent(localThis.onZoomChanged);
    };

    /*--------------------------*/
    /*триггеры, условия и прочее*/
    /*--------------------------*/

    this.reload = function () {
        localThis.clearSelection();

        localThis.arrayPrev = [];
        localThis.arrayPrev.length = 0;

        localThis.historyElements.forEach(function (o) {
            localThis.arrayPrev.push(o.data.Id);
            o.destroy();
        });

        this.dialogWindow.getHistoryList();
    };

    /*при изменении выбранных отчётов (когда галочка тогглется)*/
    this.selectionChanged = function () {

        var selected = 0;

        localThis.historyElements.forEach(function (o) {
            if (o.selected) {
                selected++;
            }
        });

        /*todo: расхардкодить максимальное количество полигонов в налажаторе*/
        var max = 21;
        if (selected >= 2 && selected <= max) {
            $(".nalagator-ico").attr("active", "true").css({ opacity: 1.0 }).attr("title", gl.text.rep_intersector_title);
        } else if (selected < 2) {
            $(".nalagator-ico").attr("active", "false").css({ opacity: 0.3 }).attr("title", gl.text.rep_intersector_title + ". " + gl.text.rep_intersector_select_some_reports);
        } else {
            $(".nalagator-ico").attr("active", "false").css({ opacity: 0.3 }).attr("title", gl.text.rep_intersector_title + ". " + gl.text.rep_intersector_to_many_reports.replace("{0}", "" + max));
        }

        localThis.dialogWindow.listActions.find(".left-container").children().remove();

        if (location.host.indexOf("digital") == -1) {
            localThis.dialogWindow.listActions.find(".left-container").append($("<span/>", { action: "check" }).addClass("bg-main-darker").addClass("font-default").html(gl.text.all_on));
            localThis.dialogWindow.listActions.find(".left-container").append($("<span/>", { action: "uncheck" }).addClass("bg-main-darker disabled").addClass("font-default").html(gl.text.all_off));
        }

        if (selected > 0) {
            localThis.dialogWindow.listActions.find(".left-container [action=uncheck]").removeClass("disabled");
        }

        window.MAP.invalidateSize();
    };

    this.onZoomChanged = function () {
        var _zoom = window.MAP.getZoom();
        if (_zoom >= localThis.hideOnZoom[0] && _zoom <= localThis.hideOnZoom[1]) {
            localThis.historyElements.forEach(function (item) {
                if (item.selected) {
                    if (item.data.Point != null && item.data.Polygon != null) {
                        tryRemoveGeometry(item.data.Point);
                        item.point_visible = false;
                    }
                }
            });
        }
        else {
            localThis.historyElements.forEach(function (item) {
                if (item.selected) {
                    if (item.data.Point != null && item.data.Polygon != null) {
                        if (item.point_visible == false) {
                            item.data.Point.addTo(window.MAP);
                            item.point_visible = true;
                        }
                    }
                }
            });
        }
    };
    init();
};

function mobilePartsModule(_parent) {
    /* Кнопка вернуть список отчетов */
     var showListReports = document.createElement("div");
     showListReports.classList.add('show-list-reports');
     showListReports.setAttribute("data-action", "show-list-reports");
    showListReports.addEventListener("click", function () {
        _parent.selfelement.find(".right-panel").attr("data-isOpen", false);
    });
    _parent.selfelement.find(".right-panel [data-elem=request-tool-panel] .container-tools[data-position=left]").append(showListReports);

    /*Кнопка: Выбрать все отчеты, не выбрать все отчеты */
    var btnSelectedReports = document.createElement("div");
    btnSelectedReports.classList.add('control-icon', 'geo-icon', 'icon-size-normal', 'gr-check-multi', 'request-filter');
    btnSelectedReports.setAttribute("data-type", "selectedAll");

    btnSelectedReports.addEventListener("click", function () {
        var typeBtn = btnSelectedReports.getAttribute("data-type");
        if (typeBtn === "selectedAll") {
            _parent.parent.turnOnVisible();
            btnSelectedReports.setAttribute("data-type", "unselectedAll");
        }else{
            _parent.parent.clearSelection();
            btnSelectedReports.setAttribute("data-type", "selectedAll");
        } 
    });

    _parent.selfelement.find(".left-panel [data-elem=request-search-panel]").append(btnSelectedReports);
};

