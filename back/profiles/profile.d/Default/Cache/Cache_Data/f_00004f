            },
            title: "",
            text: "Отмена",
            icon: false,
            "class": "btn_confirm customAlertBtnCancel"
        };

        customConfirm(hhttmmll, null, [b, n], 400, 120);
    };

    /*===========*/
    /*запускаторы*/
    /*===========*/

    /*запускает выбиратор*/
    this.runCustom = function () {

        if (!checkIsFreeToGo()) return;
        if (!checkArray()) return;
        if (!checkGeometries()) return;

        window.requestHistoryModule.clearSelection();
        window.requestHistoryModule.dialogWindow.showToolDialog();
        window.requestHistoryModule.dialogWindow.setToolDialogContent(localThis.customDialogContent());

        window.mapModule01.MapClickAllowed = false;
        window.mapModule01.MapClickAllowedOverride = false;

        var divide = divideArray(localThis.geometries);
        divide.done(function (r) {
            if (r.status === "success") {
                $.each(r.results, function (i, poly) {
                    poly.geometry = convertLongitudesTo360(poly.geometry);
                });

                localThis.geoms = r.results;
                window.NalagatorResult = r.results;

                localThis.renderGeodata(30);
            } else {
                alert(r.message);
            }
        });

        

        window.nalagator = null;
    };

    /*запускает объединятор*/
    this.runUnion = function () {
        
        if (!checkIsFreeToGo()) return;
        if (!checkArray()) return;
        if (!checkGeometries()) return;

        window.requestHistoryModule.clearSelection();

        localThis.result = unionArray(localThis.geometries);
        var centroidPt = turf.flip(turf.pointOnSurface(localThis.result));
        localThis.request.Metadata.Area = turf.area(localThis.result);
        localThis.result = turf.flip(localThis.result);

        if (localThis.result.geometry.type == "MultiPolygon") {
            var box = [];
            $.each(localThis.result.geometry.coordinates, function(i, ar) {
                box = $.merge(box, ar);
            });
            localThis.result.geometry.coordinates = box;
            localThis.result.geometry.type = "Polygon";
        }

        localThis.result = L.polygon(localThis.result.geometry.coordinates, { pane: "overlayPane" });
        localThis.waitmarker = $.extend({}, centroidPt.geometry);

        localThis.result.setStyle(L.Draw.Circle.prototype.options.shapeOptions);
        localThis.result.addTo(window.MAP);
        
        var gc = localThis.geocode(centroidPt);

        gc.done(function (r) {
            if (r.status == "success") {
                localThis.request.Metadata.Location = r.results;
                localThis.request.Address = r.results.Caption;
                localThis.request.Name = "Объединение - " + r.results.Caption;
                localThis.request.Point = null;
                localThis.request.Line = null;
                localThis.request.Polygon = getPreparedGeoJsonAsObject(localThis.result);
                localThis.runRequest();
            }
        });

    };

    /*запускает пересекатор*/
    this.runIntersect = function () {
        
        if (!checkIsFreeToGo()) return;
        if (!checkArray()) return;
        if (!checkGeometries()) return;

        window.requestHistoryModule.clearSelection();

        localThis.result = intersectArray(localThis.geometries);

        if (localThis.result == null) {
            alert("У выбранных полигонов пустая зона пересечения<br/>Выберите пересекающиеся полигоны и попробуйте снова");
            return;
        }

        var centroidPt = turf.flip(turf.pointOnSurface(localThis.result));
        localThis.request.Metadata.Area = turf.area(localThis.result);
        localThis.result = turf.flip(localThis.result);

        if (localThis.result.geometry.type == "MultiPolygon") {
            var box = [];
            $.each(localThis.result.geometry.coordinates, function (i, ar) {
                box = $.merge(box, ar);
            });
            localThis.result.geometry.coordinates = box;
            localThis.result.geometry.type = "Polygon";
        }

        localThis.result = L.polygon(localThis.result.geometry.coordinates, { pane: "overlayPane" });
        localThis.waitmarker = $.extend({}, centroidPt.geometry);

        localThis.result.setStyle(L.Draw.Circle.prototype.options.shapeOptions);
        localThis.result.addTo(window.MAP);

        var gc = localThis.geocode(centroidPt);

        gc.done(function (r) {
            if (r.status == "success") {
                localThis.request.Metadata.Location = r.results;
                localThis.request.Address = r.results.Caption;
                localThis.request.Name = "Пересечение - " + r.results.Caption;
                localThis.request.Point = null;
                localThis.request.Line = null;
                localThis.request.Polygon = getPreparedGeoJsonAsObject(localThis.result);
                localThis.runRequest();
            }
        });
    };

    /*===========*/
    /*запросяторы*/
    /*===========*/

    this.geocode = function (centroidPt) {
        return DoWebApiAction("/geocoder/point2address", {
            point: "" + centroidPt.geometry.coordinates[1] + "," + centroidPt.geometry.coordinates[0]
        });
    };

    this.runRequest = function () {
        window.MAP.invalidateSize();
        if (!checkIsFreeToGo()) return;

        localThis.request.GeointellectLayers = window.layerListPanel.getEnabledLayers();
        localThis.request.UserLayers = window.layerListPanel.getEnabledUserLayers();

        window.mapModule01.infopanel.setTitle(localThis.request.Metadata.ToolName);
        var content = $("<div/>");
        window.mapModule01.infopanel.setContent(content);
        window.mapModule01.infopanel.show();
        window.mapModule01.infopanel.setStatus("Подождите пока Геоинтеллект выполнит расчёт ...", false, true);

        window.mapModule01.infopanel.onclose = [];
        window.mapModule01.infopanel.onclose.length = 0;

        window.mapModule01.infopanel.graphics = [];
        window.mapModule01.infopanel.graphics.length = 0;

        window.mapModule01.infopanel.wait();

        var repeater = {};

        repeater.waitmarker = L.marker([localThis.waitmarker.coordinates[0], localThis.waitmarker.coordinates[1]], {
            icon: L.icon({
                iconUrl: '/resources/styles/images/animan_shlyapa.gif',
                iconSize: [50, 50],
                iconAnchor: [25, 25],
                popupAnchor: [25, 25]
            }),
            keyboard: false,
            zIndexOffset: 10000,
            opacity: 0.9,
            pane: "markerPane"
        }).addTo(window.MAP);

        repeater.options = {
            startPoint: undefined,
            Polygon: localThis.result
        };

        doIndoRequestUniversal(repeater, localThis.request);
    };
};
