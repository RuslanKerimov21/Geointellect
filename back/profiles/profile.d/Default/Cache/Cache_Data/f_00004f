        rightInfo.append($("<p/>").append(buttonDo, buttonCancel));

        return result;
    };

    this.doCustom0 = function () {
        var poly = localThis.combineSelectedPolygon();
        if (poly !== null) {
            localThis.clearGeodata();
            localThis.result = poly;
            var pos = turf.pointOnSurface(localThis.result);
            var centroidPt = turf.flip(pos);
            localThis.request.Metadata.Area = turf.area(localThis.result);

            localThis.result = turf.flip(localThis.result);
            var box = [];
            $.each(localThis.result.geometry.coordinates, function (i, ar) {
                box = $.merge(box, ar);
            });
            localThis.result.geometry.coordinates = box;
            localThis.result.geometry.type = "Polygon";
            localThis.result = L.polygon(localThis.result.geometry.coordinates, { pane: "overlayPane" });

            localThis.waitmarker = $.extend({}, centroidPt.geometry);

            localThis.result.setStyle(L.Draw.Circle.prototype.options.shapeOptions);
            localThis.result.addTo(window.MAP);

            var gc = localThis.geocode(centroidPt);

