/*Стили для инпут загрузка файлов*/
.fileform {
    position: relative;
    display: inline-block;
    float: left;
    height: 24px;
    width: 250px;
}
.fileform > input[type="file"] {
    position: absolute;
    top: 0;
    left: 0;
    width: 250px;
    opacity: 0;
    height: 18px;
    z-index: 20;
}
.fileform > .selectbutton {
    position: absolute;
    top: 0;
    right: 0;
    border: 0 none transparent;
    border-radius: 2px;
    font-size: 12px;
    height: 20px;
    line-height: 20px;
    overflow: hidden;
    padding: 2px 6px;
    text-align: center;
    vertical-align: middle;
    width: 50px;
    pointer-events: none;
}
.fileform > [data-field="filename"] {
    position: absolute;
    top: 0;
    left: 0;
    width: 185px;
    border-radius: 2px;
    height: 18px;
    line-height: 18px;
    overflow: hidden;
    padding: 2px 0;
    z-index: 30;
    border: 1px solid #e3e2e2;
    pointer-events: none;
}
.__cursor-pointer {
    cursor: pointer;
}
/*scroll*/
.min-blue-scroll::-webkit-scrollbar {
    width: 4px;
    height: 4px;
}
.min-blue-scroll::-webkit-scrollbar-track {
    background-color: #e4e4e4;
    border-radius: 100px;
}
.min-blue-scroll::-webkit-scrollbar-thumb {
    background-color: #238fc0;
    border-radius: 100px;
}
.custom-icon-map-point {
    cursor: pointer !important;
}
@keyframes placeHolderShimmer {
    0% {
        background-position: -468px 0;
    }
    100% {
        background-position: 468px 0;
    }
}
