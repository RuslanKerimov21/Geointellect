/*header*/
.header-icon {
    user-select: none;
    pointer-events: none;
    cursor: default;
    background-size: 2.5rem;
}
.header-button {
    user-select: none;
    float: right;
    cursor: pointer;
    background-size: 2rem;
}
.header-button,
.header-icon {
    width: 4rem;
    height: 4rem;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 1.5rem;
    z-index: 2;
    user-select: none;
    filter: invert(100%) sepia(98%) saturate(0%) hue-rotate(327deg)
        brightness(102%) contrast(105%);
}
.header-additional-buttons {
    display: inline-block;
    float: right;
    width: auto;
    height: 4rem;
    z-index: 2;
}
.header-label {
    display: flex;
    z-index: 2;
    user-select: none;
    flex-direction: row;
    font-size: 1.2rem;
    align-content: center;
    align-items: center;
    justify-content: flex-start;
    filter: invert(100%) sepia(98%) saturate(0%) hue-rotate(327deg)
        brightness(102%) contrast(105%);
}
.header-label-left {
    display: inline-block;
    float: left;
    width: auto;
    height: 4rem;
    line-height: 4rem;
    padding: 0px 40px;
    vertical-align: middle;
    z-index: 2;
    font-size: 15px;
    cursor: default;
}
.header-label-right {
    display: inline-block;
    float: right;
    width: auto;
    height: 4rem;
    line-height: 4rem;
    padding: 0px 10px;
    vertical-align: middle;
    z-index: 2;
    font-size: 15px;
    cursor: default;
}
.window-context-menu {
    display: block;
    position: absolute;
    right: 5px;
    top: 40px;
    min-height: 40px;
    background-color: #ffffff;
    z-index: 3;
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
}
.window-context-menu .context-menu-item {
    display: inline-block;
}
.window-context-menu .context-menu-item:hover {
    background-color: rgba(0, 177, 147, 0.04);
}
.window-context-menu .context-menu-separator {
    display: inline-block;
    float: left;
    height: 5px;
    width: 200px;
    margin-left: -5px;
    background-repeat: no-repeat;
    background-color: transparent;
    background-position: 10px 0;
    cursor: default;
    overflow: hidden;
    display: none !important;
}
.window-context-menu[data-state="opened"] {
    opacity: 1;
    height: auto;
    display: flex !important;
}
.window-context-menu[data-state="closed"] {
    opacity: 0;
    height: 0px;
}
