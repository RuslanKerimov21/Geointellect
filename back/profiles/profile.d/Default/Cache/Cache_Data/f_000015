[data-theme="uz"] .ActionRibbon,
[data-theme="green"] .ActionRibbon,
[data-theme="white"] .ActionRibbon,
[data-theme="blue"] .ActionRibbon,
[data-theme="default"] .ActionRibbon,
[data-theme="red"] .ActionRibbon,
[data-theme="dark"] .ActionRibbon,
[data-theme="fulldark"] .ActionRibbon {
    position: absolute;
    display: none;
    height: auto;
    line-height: 30px;
    min-height: 50px;
    left: 0.5rem;
    right: 0.5rem !important;
    border-radius: 1rem;
    top: 7.8rem;
    border-radius: 1rem 1rem 0 0;
    bottom: 0;
    width: 37.5rem;
    left: inherit !important;
    grid-template-columns: 1fr 2rem 2rem;
    grid-template-rows: minmax(2.5rem, max-content) minmax(0, max-content) auto;
    gap: 1rem;
    background-color: white;
    padding: 1.5rem;
    box-sizing: border-box;
    content: "panel";
}
[data-theme="uz"] .ActionRibbon[visible="true"],
[data-theme="green"] .ActionRibbon[visible="true"],
[data-theme="white"] .ActionRibbon[visible="true"],
[data-theme="blue"] .ActionRibbon[visible="true"],
[data-theme="default"] .ActionRibbon[visible="true"],
[data-theme="red"] .ActionRibbon[visible="true"],
[data-theme="dark"] .ActionRibbon[visible="true"],
[data-theme="fulldark"] .ActionRibbon[visible="true"] {
    display: -ms-grid !important;
    display: grid !important;
}
[data-theme="uz"] .ActionRibbon .left_block,
[data-theme="green"] .ActionRibbon .left_block,
[data-theme="white"] .ActionRibbon .left_block,
[data-theme="blue"] .ActionRibbon .left_block,
[data-theme="default"] .ActionRibbon .left_block,
[data-theme="red"] .ActionRibbon .left_block,
[data-theme="dark"] .ActionRibbon .left_block,
[data-theme="fulldark"] .ActionRibbon .left_block {
    grid-column-start: 1;
    grid-column: 1 / span 1;
    grid-row-start: 1;
    grid-row: 1 / span 1;
    display: -ms-grid !important;
    display: grid !important;
    grid-template-columns: minmax(0, max-content) minmax(auto, 10rem);
    grid-template-rows: minmax(1rem, max-content);
    align-self: center;
}
