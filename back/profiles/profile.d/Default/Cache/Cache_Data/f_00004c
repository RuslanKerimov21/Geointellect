            /*удаляем  попап */
            localThis.mobileEvents.closePopup = function () {
                localThis.popupMobile.classList.add("deactivate");

                const handleTransitionEnd = (event) => {
                    event.target.removeEventListener('transitionend', handleTransitionEnd); 
                    localThis.mobileEvents.PopupTransitionend(() => localThis.popupMobile.remove);
                };

                localThis.popupMobile.addEventListener('transitionend', handleTransitionEnd);
