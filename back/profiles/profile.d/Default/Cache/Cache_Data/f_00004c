/* балон при клике на карту */
var MapInfoPopupModule = function() {
    var localThis = this;
    this.id = "map-info-popup";
    var loadTemplateUrl = "/resources/funcparts/" + localThis.id + "/tmplt/map-info-popup.html";
    this.mapInfoPopup = null;
    this.initialized = false;
    var init = function () {
        appendHeadStyle("/resources/funcparts/" + localThis.id + "/style/map-info-popup.css");
       /* appendHeadStyle("/resources/styles/funcparts/" + localThis.id + "/map-info-popup.css");*/
        
        var tmplt = $.get(loadTemplateUrl);
        tmplt.done(function (response) {
            localThis.mapInfoPopup = new MapInfoPopup($(localizeHtml(response)));           
            localThis.initialized = true;
        });
    };
    
    init();
};

var MapInfoPopup = function(tmplt) {
    var localThis = this;
    this.template = tmplt.clone();
    this.selfpopup = $("<div/>");

    localThis.selfpopup = localThis.template.clone();
    localThis.card_container = localThis.selfpopup.find(".cards-container");
    localThis.tools_container = localThis.selfpopup.find(".tools-container");
    localThis.paginator = localThis.selfpopup.find(".paginator");
    localThis.paginator.css({"user-select":"none"});
    localThis.annotation_container = localThis.selfpopup.find(".annotation-container");
    localThis.annotation_content = localThis.annotation_container.find(".annotation");

    this.round_doubles = true;
    var _custom_format = {};

    this.features = [];
    this.selectionEnabled = false;
    this.selectedLayer = null;
    this.selectedLayerId = 0;
    this.selectionChanged = [];

    var _contextMenu = null;
    this.popupMobile = null;

    var options = {
        "maxWidth": 500,
        "minWidth": 400,
        "maxHeight": 500,
        "minHeight": 400,
        "keepInView": false,
        "popupAnchor": [0, 0],
        "className": "mapInfoPopup"
    };

    var _editor = {
        layerid: 0,
        fatureid: 0
    };

    this.mobileEvents = function () {
        closePopup:null
    };

    var init = function () {
        var qround = getModuleParams("map-info-popup", "round_doubles");
        qround.done(function (r) {
            if (r.success && r.results !== null) {
                localThis.round_doubles = (r.results.param_value == "true");
            }
        });
        var cformat = getModuleParams("map-info-popup", "custom_format");
        cformat.done(function (r) {
            if (r.success && r.results !== null) {
                _custom_format = JSON.parse(r.results.param_value);
            }
        });

        appendSubmodules().done(function () {
            localThis.timer = setInterval(function () {
                if (window.layerListPanel && window.mapModule01) {
                    window.layerListPanel.afterSelectionChanged.push(toggleButtonsVisibility);
                    window.mapModule01.registerMapClickEvent(renderFeaturesPopup);
                    window.clearActions.push(localThis.hide);
                    clearInterval(localThis.timer);
                }
            }, 200);
        });
    };

    this.popup = L.popup(options);

    this.results = [];
    this.selectedFeature = null;
    this.selectedGeometry = null;
    this.selectedIndex = 0;
    this.buttons = [];
    this.visible = false;
    this.latlng = null;

    this.getEditor = function () {
        return _editor;
    };

    this.resetEditor = function () {
        _editor = {
            layerid: 0,
            fatureid: 0,
            layername: null,
            type: null
        }
    };

    this.showAnnotation = function(content, durationMs) {
        localThis.annotation_content.html(content);
        localThis.annotation_container.attr("data-state", "open");

        if (durationMs == undefined || durationMs == null) return;

        setTimeout(function() {
            localThis.collapseAnnotation();
        }, durationMs);
    }

    this.collapseAnnotation = function() {
        localThis.annotation_content.empty();
        localThis.annotation_container.attr("data-state", "collapsed");
    }

    this.clearContent = function() {
        /* удаляет содержимое балона (объекты, титул, кнопки и всё остальное) */
    };

    this.onSelectionChange = [];

    var appendSubmodules = function () {
        var u = $.getScript("/resources/funcparts/map-info-popup/ULayerEditor.js");
        var g = $.getScript("/resources/funcparts/map-info-popup/GiLayerEditor.js");
        return $.when(u, g);
    };

    var bindPager = function() {
        localThis.paginator.on("mouseup", ".container > .prev", function() {
            var current = parseInt(localThis.paginator.attr("data-current"));
            pagerSetPage(current - 1);
        });

        $(localThis.paginator.on("mouseup", ".container > .next", function() {
            var current = parseInt(localThis.paginator.attr("data-current"));
            pagerSetPage(current + 1);
        }));
    };

    var bindButtons = function () {
        localThis.selfpopup.children(".footer").on("click","[data-action]",function () {
            var action = $(this).attr("data-action");
            if (typeof _actions[action] === "function") {
                _actions[action](localThis.latlng.lng, localThis.latlng.lat);
            }
        });

        localThis.selfpopup.children(".coordinates").children(".buttons").on("click", "[data-action]", function () {
            var action = $(this).attr("data-action");
            if (typeof _actions[action] === "function") {
                _actions[action](localThis.latlng.lng, localThis.latlng.lat);
            }
        });
    };

    var CheckModuleButtons = function () {
        localThis.selfpopup.children(".footer").find("[data-check]").each(function (index, element) {
            var action = $(element).attr("data-check");
            if (typeof localThis[action] === "function") {
                if (!localThis[action]()) {
                    $(element).css("display", "none");
                }
            }
        });
    };

    var _checksTIMEOUT = 3000;

    var _debug_popups = false;

    var _checks = {
        "value_equals": function (fieldvalue) {
            /*value_equals:sam=1*/

            let operations = ["=", "!=", "<>", ">", "<"];
            let current_operation = "";

            operations.forEach(function (one) {
                if (fieldvalue.indexOf(one) != -1) {
                    current_operation = one;
                }
            });

            var field = fieldvalue.split(current_operation)[0];
            var value = fieldvalue.split(current_operation)[1];

            if (value == "null") {
                value = null;
            }

            var rule_options = {
                
            };


            var value_check = false;

            switch (current_operation) {
                case "=": value_check = localThis.selectedFeature.properties[field] == value; break;
                case "!=": value_check = localThis.selectedFeature.properties[field] != value; break;
                case "<>": value_check = localThis.selectedFeature.properties[field] != value; break;
                case ">": value_check = localThis.selectedFeature.properties[field] > value; break;
                case "<": value_check = localThis.selectedFeature.properties[field] < value; break;
                default: value_check = false;
            }

            rule_options.check = value_check;
            rule_options.current_operation = current_operation;
            rule_options.value_object = localThis.selectedFeature.properties[field];
            rule_options.value_rule = value;

            var rules = localThis.selectedFeature != null && localThis.selectedFeature.layer != null && localThis.selectedFeature.properties.hasOwnProperty(field) && value_check;
            if (_debug_popups) (rules) ? blinkmsg("value_equals[" + field + "]" + current_operation + "[" + value + "]", _checksTIMEOUT, "success") : blinkmsg("value_equals[" + field + "]" + current_operation + "[" + value + "]", _checksTIMEOUT, "danger");

            return rules;
        },
        "contains_field": function (field) {
            var rules = localThis.selectedFeature != null && localThis.selectedFeature.layer != null && localThis.selectedFeature.properties.hasOwnProperty(field);
            if (_debug_popups) (rules) ? blinkmsg("contains_field[" + field + "]", _checksTIMEOUT, "success") : blinkmsg("contains_field[" + field + "]", _checksTIMEOUT, "danger");
            return rules;
        },
        "layer_id_in": function (_ids) {
            var ids = _ids.split(/,|;|_/).map(function (item) {
                return Number(item.trim());
            });
            var rules = localThis.selectedFeature != null && localThis.selectedFeature.layer != null && ids.indexOf(localThis.selectedFeature.layer.id) >= 0;
            return rules;
        },
        "selection_enabled": function () {
            var rules = localThis.selectionEnabled == true;
            if (_debug_popups) (rules) ? blinkmsg("selection_enabled", _checksTIMEOUT, "success") : blinkmsg("selection_enabled", _checksTIMEOUT, "danger");
            return rules;
        },
        "selection_disabled": function () {
            var rules = _checks.selection_enabled() == false;
            if (_debug_popups) (rules) ? blinkmsg("selection_disabled", _checksTIMEOUT, "success") : blinkmsg("selection_disabled", _checksTIMEOUT, "danger");
            return rules;
        },
        "is_selected": function () {
            var rules = false;
            if (localThis.anyplace == false && localThis.selectedFeature == null) {
                rules = false;
            }
            else if (localThis.anyplace == false && localThis.selectedFeature != null) {
                var _key = "" + localThis.selectedFeature.layer.id + "|" + localThis.selectedFeature.layer.uid + "|" + localThis.selectedFeature.id;
                rules = localThis.features?.some(function (item) {
                    return item.id === _key;
                });
            }
            else if (localThis.anyplace == true) {
                var latx = ("" + localThis.latlng.lat).left(8);
                var lngy = ("" + localThis.latlng.lng).left(8);
                var _key = "000|" + latx + "|" + lngy;
                rules = localThis.features?.some(function (item) {
                    return item.id === _key;
                });
            }
            if (_debug_popups) (rules) ? blinkmsg("is_selected", _checksTIMEOUT, "success") : blinkmsg("is_selected", _checksTIMEOUT, "danger");
            return rules;
        },
        "is_not_selected": function () {
            var rules = _checks.is_selected() == false;
            if (_debug_popups) (rules) ? blinkmsg("is_not_selected", _checksTIMEOUT, "success") : blinkmsg("is_not_selected", _checksTIMEOUT, "danger");
            return rules;
        },
        "is_editable": function () {
            var rules = false;
            if (_checks.is_mylayer()) {
                rules = window.layerListPanel.findUserLayerByUid(localThis.selectedFeature.layer.uid)?.Editors.indexOf(UserModule.userData.Info.Login) > -1;
            }
            if (_checks.is_gilayer()) {
                rules = updateAllowed(window.layerListPanel.findLayerById(localThis.selectedFeature.layer.id)?.id);
            }
            if (_debug_popups) (rules) ? blinkmsg("is_editable", _checksTIMEOUT, "success") : blinkmsg("is_editable", _checksTIMEOUT, "danger");
            return rules;
        },
        "is_line_or_poly": function () {
            var rules = false;
            if (_checks.is_gilayer()) {
                rules = typeHasBoundary(window.layerListPanel.findLayerById(localThis.selectedFeature.layer.id)?.id);
            }
            if (_debug_popups) (rules) ? blinkmsg("is_line_or_poly", _checksTIMEOUT, "success") : blinkmsg("is_line_or_poly", _checksTIMEOUT, "danger");
            return rules;
        },
        "is_deletable": function () {
            var rules = false;
            if (_checks.is_mylayer()) {
                rules = window.layerListPanel.findUserLayerByUid(localThis.selectedFeature.layer.uid)?.Editors.indexOf(UserModule.userData.Info.Login) > -1;
            }
            if (_checks.is_gilayer()) {
                rules = deleteAllowed(window.layerListPanel.findLayerById(localThis.selectedFeature.layer.id)?.id);
            }
            if (_debug_popups) (rules) ? blinkmsg("is_deletable", _checksTIMEOUT, "success") : blinkmsg("is_deletable", _checksTIMEOUT, "danger");
            return rules;
        },
        "is_mylayer": function () {
            var rules = localThis.selectedFeature != null && localThis.selectedFeature.layer != null && localThis.selectedFeature.layer.uid != "00000000-0000-0000-0000-000000000000";
            if (_debug_popups) (rules) ? blinkmsg("is_mylayer", _checksTIMEOUT, "success") : blinkmsg("is_mylayer", _checksTIMEOUT, "danger");
            return rules;
        },
        "editable_mylayer_is_on": function () {
            var rules = window.layerListPanel.getEnabledEditableUserLayers().length > 0;
            if (_debug_popups) (rules) ? blinkmsg("editable_mylayer_is_on", _checksTIMEOUT, "success") : blinkmsg("editable_mylayer_is_on", _checksTIMEOUT, "danger");
            return rules;
        },
        "is_gilayer": function () {
            var rules = localThis.selectedFeature != null && localThis.selectedFeature.layer != null && localThis.selectedFeature.layer.uid == "00000000-0000-0000-0000-000000000000";
            if (_debug_popups) (rules) ? blinkmsg("is_gilayer", _checksTIMEOUT, "success") : blinkmsg("is_gilayer", _checksTIMEOUT, "danger");
            return rules;
        },
        "editable_gilayers_count": function () {
            var _editable_count = 0;
            var lyrs = window.layerListPanel.getEnabledLayers();
            if (lyrs.length > 0) {                
                lyrs.forEach(function (item) {
                    if (createAllowed(item.Id)) {
                        _editable_count += 1;
                    }
                });
            }
            return _editable_count;
        },
        "editable_gilayer_is_on": function () {
            var rules = _checks.editable_gilayers_count() > 0;
            if (_debug_popups) (rules) ? blinkmsg("editable_gilayer_is_on", _checksTIMEOUT, "success") : blinkmsg("editable_gilayer_is_on", _checksTIMEOUT, "danger");
            return rules;
        },
        "any_editable_layer_is_on": function () {
            var rules = _checks.editable_gilayer_is_on() || _checks.editable_mylayer_is_on();
            if (_debug_popups) (rules) ? blinkmsg("any_editable_layer_is_on", _checksTIMEOUT, "success") : blinkmsg("any_editable_layer_is_on", _checksTIMEOUT, "danger");
            return rules;
        },
        "no_features": function () {
            var rules = localThis.selectedFeature == null;
            if (_debug_popups) (rules) ? blinkmsg("no_features", _checksTIMEOUT, "success") : blinkmsg("no_features", _checksTIMEOUT, "danger");
            return rules;
        },
        "is_any_layer": function () {
            var rules = _checks.is_gilayer() || _checks.is_gilayer();
            if (_debug_popups) (rules) ? blinkmsg("is_any_layer", _checksTIMEOUT, "success") : blinkmsg("is_any_layer", _checksTIMEOUT, "danger");
            return rules;
        }
    };

    this.findAction = function (name) {
        return _actions[name];
    };

    var _actions = {
        "selectobject": function () {
            if (localThis.selectionEnabled === false) {
                return;
            }

            var footer = localThis.selfpopup.find(".footer");
            footer.find("[data-action=selectobject]").css({ display: "none" });
            footer.find("[data-action=unselectobject]").css({ display: "block" });

            var _key = "";
            var f = {};

            if (localThis.anyplace == true) {

                var latx = ("" + localThis.latlng.lat).left(8);
                var lngy = ("" + localThis.latlng.lng).left(8);

                _key = "000|" + latx + "|" + lngy;

                f = {
                    id: _key,
                    type: "Feature",
                    layer: {},
                    properties: { "empty": "true" },
                    geometry: Object.assign({}, { "type": "Point", "coordinates": [localThis.latlng.lng, localThis.latlng.lat] })
                };

                f.properties.caption = "MapPin" + "(#" + _key + ")";

            }
            else {
                _key = "" + localThis.selectedFeature.layer.id + "|" + localThis.selectedFeature.layer.uid + "|" + localThis.selectedFeature.id;

                f = {
                    id: _key,
                    type: "Feature",
                    layer: Object.assign({}, localThis.selectedFeature.layer),
                    layer_id: localThis.selectedFeature.layer.id,
                    properties: Object.assign({}, localThis.selectedFeature.properties),
                    geometry: Object.assign({}, localThis.selectedFeature.geometry)
                };

                f.properties.caption = f.layer.name + "(#" + f.properties.id + ")";

                if (f.properties.hasOwnProperty("address")) {
                    f.properties.caption = f.layer.name + "(#" + f.properties.address + ")";
                }

                if (f.properties.hasOwnProperty("sitebk")) {
                    f.properties.caption = "# " + f.properties.sitebk + " (" + f.layer.name + ")";
                }

            }

            localThis.features.push(f);

            enableSelectionLayer();

            localThis.selectionChanged.forEach(function (item) {
                if (typeof item === "function") {
                    item();
                }
            });
        },
        "unselectobject": function () {
            if (localThis.selectionEnabled === false) return;

            var footer = localThis.selfpopup.find(".footer");
            footer.find("[data-action=selectobject]").css({ display: "block" });
            footer.find("[data-action=unselectobject]").css({ display: "none" });

            var _key = "" + localThis.selectedFeature.layer.id + "|" + localThis.selectedFeature.layer.uid + "|" + localThis.selectedFeature.id;
            localThis.features = localThis.features.filter(function (obj) {
                return obj.id !== _key;
            });

            enableSelectionLayer();

            localThis.selectionChanged.forEach(function (item) {
                if (typeof item === "function") {
                    item();
                }
            });
        },
        "myobjectfiles": function () {
            var options = { latlng: localThis.latlng, feature: localThis.selectedFeature };
            window.UlaFiles.files($("body"), options);
        },
        "panoramaYa": function () {
            var c = localThis.latlng;
            var url = "https" +
                "://yandex.ru/maps?l=stv%2Csta&" +
                "ll=" + c.lng + "%2C" + c.lat +
                "&panorama%5Bdirection%5D=178.167772%2C7.490147" +
                "&panorama%5Bpoint%5D=" + c.lng + "%2C" + c.lat +
                "&panorama%5Bspan%5D=120.000000%2C66.588689&z=16";
            clickLink(url, "_blank");
        },
        "copyCoordinates": function () {
            var _uid = generateGUID();
            var c = localThis.latlng;
            var _temp = $("<input>", { id: _uid }).css({ display: "block", position: "absolute", opacity: 0.0, top: 0, left: 0 });
            $("body").append(_temp);
            _temp.val("" + c.lat + "," + c.lng).select();
            var _ok = document.execCommand("copy");
            _temp.remove();
            if (_ok) {
                blinkmsg(gltxt("copied") + " " + "" + c.lat.toFixed(6) + ", " + c.lng.toFixed(6));
            }
        },
        "openOnGmaps": function () {
            var c = localThis.latlng;
            var _coords = c.lat + "," + c.lng;
            var _url = "https" + "://maps.google.com/maps?q=" + _coords + "&ll=" + _coords + "&z=16";
            clickLink(_url, "_blank");
        },
        "openOnYamaps": function () {
            var c = localThis.latlng;
            var _coords = "" + c.lng.toFixed(6) + "%2C" + c.lat.toFixed(6);
            var _coords_weird = c.lat.toFixed(6) + "%2C" + c.lng.toFixed(6);
            var _url = "https" + "://yandex.ru/maps/?ll=" + _coords + "&mode=search&sll=" + _coords + "&text=" + _coords_weird + "&z=16";
            clickLink(_url, "_blank");
        },
        "addobject": function () {
            var userLayerCount = window.layerListPanel.getEnabledEditableUserLayers().length;
            var giLayerCount = _checks.editable_gilayers_count();

            console.table({
                userLayerCount,
                giLayerCount
            })
            
            if ((userLayerCount + giLayerCount) == 0) {
                blinkmsg(gltxt("no_editable_layers"), 1000, "danger");

                return;
            }

            if (userLayerCount > 0 && giLayerCount == 0) {
                _actions.addmyobject();
                
                return;
            }

            if (userLayerCount == 0 && giLayerCount == 1) {
                window.layerListPanel.getEnabledLayers().forEach(function (item) {
                    var param_item = window.layerEditor?._params?.editor_settings?.find(function (lyr) {
                        return (lyr.id == item.Id && lyr.allow_create === true);
                    });
                    if (param_item) {
                        var _name = window.layerListPanel.findLayerById(item.Id).name;
                        localThis.getEditor().layerid = item.Id;
                        localThis.getEditor().layername = _name;
                        localThis.getEditor().fatureid = 0;
                        localThis.getEditor().type = param_item.type;

                        window.layerEditor.run_new_feature(_name, param_item.type, InsertOnSave, localThis.resetEditor, null, null, {
                            save: true,
                            cancel: true,
                            history: true,
                            coordinates: false,
                            geojson: false
                        });

                        window.mapInfoPopupModule?.mapInfoPopup?.hide();

                        return;
                    }
                });

                return;
            }

            if (userLayerCount == 0 && giLayerCount > 1) {
                _contextMenu = new ContextMenuForOld([],
                    {
                        attachTo: document.querySelector(".mapInfoPopup").querySelector(".cards-container"),
                        hasButton: false,
                        which_btn: 1,
                        width_px: 390
                    });
                var layers = window.layerListPanel.getEnabledLayers();
                var idx = 0;
                layers.forEach(function (item) {
                    if (createAllowed(item.Id)) {
                        idx++;
                        if (idx < 6) {
                            var _name = window.layerListPanel.findLayerById(item.Id).name;
                            _contextMenu.addItem({
                                type: "button",
                                group: 1,
                                icon_classes: ["gr-layers", "filter-primary"],
                                text: _name,
                                onClick: function () {
                                    var param_item = window.layerEditor?._params?.editor_settings?.find(function (lyr) {
                                        return (lyr.id == item.Id && lyr.allow_create === true);
                                    });
                                    if (param_item) {
                                        localThis.getEditor().layerid = item.Id;
                                        localThis.getEditor().layername = _name;
                                        localThis.getEditor().fatureid = 0;
                                        localThis.getEditor().type = param_item.type;

                                        if (param_item.type == "Point") {
                                            var _feature = {
                                                "type": "Feature",
                                                "properties": {
                                                    "name": _name,
                                                },
                                                "geometry": {
                                                    "type": "Point",
                                                    "coordinates": [localThis.latlng.lng, localThis.latlng.lat]
                                                }
                                            };
                                            InsertOnSave(_feature);

                                            window.mapInfoPopupModule?.mapInfoPopup?.hide();
                                        }
                                        else {
                                            window.layerEditor.run_new_feature(_name, param_item.type, InsertOnSave, localThis.resetEditor, null, null, {
                                                save: true,
                                                cancel: true,
                                                history: true,
                                                coordinates: false,
                                                geojson: false
                                            });

                                            window.mapInfoPopupModule?.mapInfoPopup?.hide();
                                        }
                                    }
                                },
                                onClose: function () {
                                    _contextMenu = null;
                                }
                            });
                        }
                    }
                });                
                _contextMenu.showAt(document.querySelector(".mapInfoPopup"));
                return;
            }

            if (userLayerCount > 0 && giLayerCount > 0) {
                _contextMenu = new ContextMenuForOld([],
                    {
                        attachTo: document.querySelector(".mapInfoPopup"),
                        hasButton: false,
                        which_btn: 1,
                        width_px: 390
                    });
                var layers = window.layerListPanel.getEnabledLayers();                
                var idx = 0;
                layers.forEach(function (item) {
                    if (createAllowed(item.Id)) {
                        idx++;
                        if (idx < 5) {
                            var _name = window.layerListPanel.findLayerById(item.Id).name;
                            _contextMenu.addItem({
                                type: "button",
                                group: 1,
                                icon_classes: ["gr-layers", "filter-primary"],
                                text: _name,
                                onClick: function () {
                                    var param_item = window.layerEditor?._params?.editor_settings?.find(function (lyr) {
                                        return (lyr.id == item.Id && lyr.allow_create === true);
                                    });
                                    if (param_item) {
                                        localThis.getEditor().layerid = item.Id;
                                        localThis.getEditor().layername = _name;
                                        localThis.getEditor().fatureid = 0;
                                        localThis.getEditor().type = param_item.type;

                                        if (param_item.type == "Point") {
                                            var _feature = {
                                                "type": "Feature",
                                                "properties": {
                                                    "name": _name,
                                                },
                                                "geometry": {
                                                    "type": "Point",
                                                    "coordinates": [localThis.latlng.lng, localThis.latlng.lat]
                                                }
                                            };
                                            InsertOnSave(_feature);

                                            window.mapInfoPopupModule?.mapInfoPopup?.hide();
                                        }
                                        else {
                                            window.layerEditor.run_new_feature(_name, param_item.type, InsertOnSave, localThis.resetEditor, null, null, {
                                                save: true,
                                                cancel: true,
                                                history: true,
                                                coordinates: false,
                                                geojson: false
                                            });

                                            window.mapInfoPopupModule?.mapInfoPopup?.hide();
                                        }
                                    }
                                },
                                onClose: function () {
                                    _contextMenu = null;
                                }
                            });
                        }
                    }
                });

                _contextMenu.addItem({
                    type: "button",
