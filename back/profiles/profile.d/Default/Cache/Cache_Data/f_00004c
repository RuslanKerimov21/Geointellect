        else if (layer === null && ulayer === null) {
            return featureToEmptyHtml(gltxt_f("layer_n_not_found", feature.layer.name));
        }

        localThis.paginator.children(".layer").html(feature.layer.name);
        localThis.paginator.children("button[data-balloon]").attr("data-balloon", feature.layer.name);

        var schema;

        if (layer) { // FIXME "layer !== null" падал когда layer был равен undefined
            schema = layer.schema;

            schema.forEach(function (o1) {

                var name = o1.name;

                if (name.indexOf("picture_url") != -1) {
                    if (feature.properties.hasOwnProperty(name)) {

                        var value = feature.properties[name];
                        if (isValidURL(value)) {
                            var img_block = $('<div data-layer-id="' + feature.layer.id + '" data-feature-id="' + feature.id + '" data-field-name="' + name + '" class="attr-row" j="6"><div class="attr-col"></div></div>');
                            img_block.find(".attr-col").css({
                                width: "100%",
                                height: "250px",
                                "background-image": "url(" + value + ")",
                                "background-repeat": "no-repeat",
                                "background-size": "250px",
                                "background-position": "center"
                            });
                            htm.append(img_block);
                        }
                    }
                }
            });

            schema.forEach(function (o1) {

                var name = o1.name;
                var alias = o1.aliases[0].alias; /*todo: выбрать по локали*/

                if (name.indexOf("lidx") == -1) {
                    if (feature.properties.hasOwnProperty(name)) {

                        var value = feature.properties[name];

                        if ((window.userModule ?? window.UserModule).userData.Info.Roles.containsAny(["superadministrator", "supermanager", "clientadmin", "clientmoderator", "clienteditor"])) {
                            var editing_params = getEditingColumnParams(feature.layer.id, name);

                            if (updateAllowed(feature.layer.id) && editing_params !== null) {
                                var _ed_field = renderEditable(feature.layer.id, feature.id, name, alias, value, editing_params);
                                htm.append(_ed_field);
                            }
                            else {
                                if (name.indexOf("picture_url") == -1) {
                                    var _rd_field = renderSimple(feature.layer.id, feature.id, name, alias, value);
                                    htm.append(_rd_field);
                                }
                            }
                        }
                        else {
                            if (name.indexOf("picture_url") == -1) {
                                var _rd_field = renderSimple(feature.layer.id, feature.id, name, alias, value);
                                htm.append(_rd_field);
                            }
                        }
                    }
                }
            });

        }
        else if (ulayer !== null) {
            schema = ulayer.Schema;

            schema.forEach(function (o1) {

                var name = o1.Name;

                var alias = o1.Caption;

                if (feature.properties.hasOwnProperty(name)) {

                    var value = feature.properties[name];
                    var trimmed_val = trim11("" + value);

                    /*если значение есть, то выводим этот атрибут*/
                    if (true || (trimmed_val !== "" && trimmed_val !== "0" && trimmed_val !== "0.0")) {

                        var tr = $("<div/>").addClass("attr-row");

                        tr.append($("<div/>").addClass("attr-col").html(alias));

                        if (isInt(value) && (name.indexOf("index") !== -1 || name.indexOf("zip") !== -1 || name.indexOf("post") !== -1)) {
                            tr.append($("<div/>").addClass("attr-col2").html(value));
                        }
                        else if (isInt(value)) {
                            tr.append($("<div/>").addClass("attr-col2").html(number_format(value, "0", ".", "&nbsp;")));
                        }
                        else if (isDouble(value)) {
                            tr.append($("<div/>").addClass("attr-col2").html(number_format(value, "2", ".", "&nbsp;")));
                        }
                        else if (isValidURL(value)) {
                            tr.append($("<div/>").addClass("attr-col2").html("<a href='" + value + "' target='_blank' title='"+gltxt("open_in_new_window")+"'>" + (value.length > 20 ? (value.left(20) + "...") : value) + "</a>"));
                        }
                        else if (/^(\d{4})-0?(\d+)-0?(\d+)[T ]0?(\d+):0?(\d+):0?(\d+)$/.test(value)) {
                            var tt = value.split("T")[0].split("-");
                            tr.append($("<div/>").addClass("attr-col2").html(tt[2] + "." + tt[1] + "." + tt[0]));
                        }
                        else {
                            tr.append($("<div/>").addClass("attr-col2").html(value));
                        }

                        htm.append(tr);
                    }

                }

            });
        }

        return htm;
    };

