    function checkShowOnProperty(element) {
        var showOnAttribute = element.getAttribute('show-on');

        if (!showOnAttribute) return true;

        var parts = showOnAttribute.split(',');

        for (var i = 0; i < parts.length; i++) {
            var functionNameAndParam = parts[i].trim().split(':');
            var functionName = functionNameAndParam[0];
            var parameter = functionNameAndParam[1];

            if (typeof _checks[functionName] === 'function') {
                if (parameter) {
                    if (!_checks[functionName](parameter)) {
                        return false;
                    }
                } else {
                    if (!_checks[functionName]()) {
                        return false;
                    }
                }
            } else {
                return false;
            }
        }

        if (element?.getAttribute("data-action") == "showEcoEvents") {
            window.MapInfoPopupEcoEvents.openWindow();
        }

        return true;
    };

