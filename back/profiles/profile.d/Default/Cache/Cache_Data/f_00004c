    var UpdateOnSave = function (_feature) {
        var _layerid = localThis.getEditor().layerid;
        var _fatureid = localThis.getEditor().fatureid;

        var qqq = DoWebApiAction("/layer_update/update_geom", {
            layer_id: _layerid,
            object_id: _fatureid,
            feature: JSON.stringify(_feature)
        });

        qqq.done(function (r) {
            if (r.success == true && r.results == true) {
                blinkmsg(gltxt("saved"));
                localThis.resetEditor();
            }
            else {
                alert(r.message);
            }
        });

        return qqq;
    };

    var InsertOnSave = function (_feature) {
        var _layerid = localThis.getEditor().layerid;

        if (_feature.geometry.type == "Polygon" && localThis.getEditor().type == "MultiPolygon") {
            _feature.geometry.type = "MultiPolygon";
            _feature.geometry.coordinates = [_feature.geometry.coordinates];
        }
        if (_feature.geometry.type == "LineString" && localThis.getEditor().type == "MultiLineString") {
            _feature.geometry.type = "MultiLineString";
            _feature.geometry.coordinates = [_feature.geometry.coordinates];
        }

        var qqq = DoWebApiAction("/layer_update/insert", {
            layer_id: _layerid,
            feature: JSON.stringify(_feature)
        });

        qqq.done(function (r) {
            if (r.success == true && r.results > 0) {
                blinkmsg(gltxt("saved"));
                localThis.resetEditor();
                var _layer = window.layerListPanel.findLayerById(_layerid).mapLayerObject;
                var _params = _layer.wmsParams;
                _params.uid = generateGUID().replace(/-/g, "");
                window.layerListPanel.findLayerById(_layerid).mapLayerObject.setParams(_params);
                window.MAP.invalidateSize();

                var _lyr = window.layerListPanel.findLayerById(_layerid);
                
                if (_lyr && _lyr?.type == "vector-point-multi-cluster") {
                    _lyr?.fetchFeatures();
                }
            }
            else {
                alert(r.message);
            }
        });

        return qqq;
    };

