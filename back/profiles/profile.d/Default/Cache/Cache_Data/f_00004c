    this.renderPage = function(n) {       
        /* xxxxx */
        var f = localThis.results;
        var counter = 0;
        localThis.selectedLayerId = 0;

        localThis.results.forEach(function (item) {
            counter += item.count;
        });

        if (counter === 0 || n === 0) {
            $(".cards-container", localThis.selfpopup).children().remove();

            var query = DoWebApiAction("/geocoder/point2address", {
                point: "" + localThis.latlng.lng + "," + localThis.latlng.lat,
                zoom: window.MAP.getZoom()
            });

            query.done(function (r) {
                if (r.success) {
                    $(".cards-container", localThis.selfpopup).empty().append(featureToEmptyHtml("<br/>" + gltxt("address") + ": " + r.results.Caption));
                 
                } else {
                    $(".cards-container", localThis.selfpopup).empty().append(featureToEmptyHtml());
                }
            });

            query.fail(function () {
                $(".cards-container", localThis.selfpopup).empty().append(featureToEmptyHtml());
            });

            window.mapInfoPopupModule.mapInfoPopup.selectedFeature = null;
            window.mapInfoPopupModule.mapInfoPopup.selectedIndex = -1;

            tryRemoveGeometry(window.mapInfoPopupModule.mapInfoPopup.selectedGeometry);

            toggleButtonsVisibility();

        } else {

            var counter = 0;
            
            f.forEach(function (identified_layer) {
                if (identified_layer.is_pay === true) {
                    for (var i = 0; i < identified_layer.count; i++) {
                        counter += 1;
                        if (counter === n) {
                            localThis.selectedFeature = Object.assign({}, identified_layer);
                            toggleButtonsVisibility();
                            localThis.card_container.children().remove();
                            localThis.card_container.empty().append(featureToPayHtml(i + 1, identified_layer.name));
                        }
                    }
                } else {
                    identified_layer.features.forEach(function (o2) {
                        counter += 1;
                        if (counter === n) {
                            localThis.selectedFeature = Object.assign({}, o2);
                            localThis.selectedFeature = Object.assign(localThis.selectedFeature, {
                                layer: {
                                    name: identified_layer.name,
                                    id: identified_layer.id,
                                    uid: identified_layer.uid,
                                    editable: identified_layer.editable,
                                    schema: identified_layer.schema
                                }
                            });
                            localThis.selectedLayerId = identified_layer.id;
                            window.G.DynamicFlat.setValue('get_selected_layer_object', { selectedFeature: localThis.selectedFeature });
                           
                            localThis.renderGeometry(localThis.selectedFeature);

                            toggleButtonsVisibility();
                            //localThis.toggleEditButtons();
                            localThis.card_container.children().remove();
                            localThis.card_container.empty().append(featureToHtml(localThis.selectedFeature));
                        }
                    });
                }
            });
        }

        localThis.onSelectionChange.forEach(function (f) {
            if (typeof f === "function") {
                f(localThis.selectedFeature);
            }
        });
