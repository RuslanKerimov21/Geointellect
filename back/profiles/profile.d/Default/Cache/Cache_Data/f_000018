function getv(tableName, rowIndex, colIndex, astype) {
    /*get value by row/col and use type from getAttribute('type')*/
    const table = document.querySelector(`table[name="${tableName}"]`);
    if (!table) return '###';

    const tbody = table.tBodies[0];
    const row = tbody && tbody.rows[rowIndex - 1];
    const cell = row && row.cells[colIndex - 1];
    if (!cell) return '###';

    const rawType = (typeof astype !== 'undefined')
        ? astype
        : cell.getAttribute('type') || 'number';
    const type = rawType.toLowerCase();

    let result = '###';
    try {
        if (type === 'checkbox') {
            const cb = cell.querySelector('input[type="checkbox"]');
            result = (cb && cb.checked) ? 1 : 0;

        } else if (type === 'datetime') {
            const dt = cell.querySelector('input[type="date"]');
            result = dt ? dt.value : '';

        } else if (type === 'option') {
            const sel = cell.querySelector('select');
            result = sel ? sel.value : '';

        } else {
            const editor = cell.querySelector('div[contenteditable]') || cell;
            const text = editor.innerHTML
                .replace(/&nbsp;/g, ' ')
                .replace(/<[^>]+>/g, '')
                .trim();

            if (type === 'number' || type === 'int') {
                result = parseInt(text, 10) || 0;
            } else if (type === 'float' || type === 'double') {
                result = parseFloat(text.replace(',', '.')) || 0.0;
            } else {
                result = text;
            }
        }
    } catch (err) {
        console.error(err, tableName, rowIndex, colIndex, type);
    }

    return result;
};

