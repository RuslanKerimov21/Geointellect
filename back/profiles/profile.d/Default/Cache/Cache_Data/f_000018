function guessDataType(array, nullable) {
    if (!Array.isArray(array) || array.length === 0) {
        return 'unknown';
    }

    let hasString = false;
    let hasInt = true;
    let hasDouble = false;
    let hasNull = false;
    let hasContent = false;

    for (const value of array) {
        if (value === null || value === '') {
            hasNull = true;
            continue;
        }

        hasContent = true;

        if (typeof value === 'number') {
            if (!Number.isInteger(value)) {
                hasDouble = true;
                hasInt = false;
            }
            continue;
        }

        const strValue = String(value).trim();

        const commaAsDecimal = /^-?\d{1,3}(?:\.\d{3})*(?:,\d+)$|^-?\d+,\d+$/.test(strValue);
        if (commaAsDecimal) {
            hasDouble = true;
            hasInt = false;
            continue;
        }

        const dotAsDecimal = /^-?\d+\.\d+$/.test(strValue);
        if (dotAsDecimal) {
            hasDouble = true;
            hasInt = false;
            continue;
        }

        const isValidInteger = /^-?\d+$/.test(strValue);
        if (isValidInteger) {
            continue;
        }

        if (strValue === '' || isNaN(strValue) ||
            /[a-df-z]|e[+-]?[^0-9]|\.\.|^0[0-9]|[,%$]|^0x/i.test(strValue)) {
            hasString = true;
            hasInt = false;
            hasDouble = false;
        }
    }

    if (!nullable && hasNull) {
        return 'string';
    }

    if (hasString) {
        return 'string';
    }

    if (hasDouble) {
        return 'double';
    }

    if (hasInt) {
        return 'int';
    }

    return 'string';
};

