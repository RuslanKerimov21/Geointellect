function getLabelByValue(rules, val) {
    if (!Array.isArray(rules) || rules.length === 0) {
        return '---';
    }

    const n = Number(val);
    if (!Number.isFinite(n)) {
        return '---';
    }

    const lastTwo = n % 100;
    if (lastTwo >= 10 && lastTwo < 20) {
        return rules[0].label;
    }

    const lastDigit = n % 10;
    const lastStr = String(lastDigit);

    const rule = rules.find(r => String(r.last).includes(lastStr));

    return rule
        ? rule.label
        : '---';
};

