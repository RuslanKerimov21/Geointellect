var format = {
    "phone": function (phone) {
        if (phone == null) return '';
        phone = String(phone).trim();
        if (!phone) return '';
        if (/[A-Za-zА-Яа-яЁё]/.test(phone)) return phone;

        if (/[,;|\/]/.test(phone)) {
            return phone.split(/[,;|\/]+/).map(p => format.phone(p.trim())).join(', ');
        }

        const isInternational = phone.startsWith('+');
        const digits = phone.replace(/\D/g, '');

        function groupFallback(digs) {
            if (digs.length <= 1) return digs;
            if (digs.length % 2 === 0) {
                let groups = [];
                for (let i = 0; i < digs.length; i += 2) {
                    groups.push(digs.substr(i, 2));
                }
                return groups.join('&nbsp;');
            } else {
                let groups = [digs.substr(0, 3)];
                for (let i = 3; i < digs.length; i += 2) {
                    groups.push(digs.substr(i, 2));
                }
                return groups.join('&nbsp;');
            }
        }

        if (isInternational) {
            if (phone.startsWith('+7') && digits.length === 11) {
                return '+7&nbsp;(' + digits.slice(1, 4) + ')&nbsp;' +
                    digits.slice(4, 7) + '-' +
                    digits.slice(7, 9) + '-' +
                    digits.slice(9, 11);
            } else if (digits.length > 10) {
                const ccLength = digits.length - 10;
                const cc = digits.slice(0, ccLength);
                const local = digits.slice(ccLength);
                return '+' + cc + '&nbsp;' +
                    local.slice(0, 3) + '&nbsp;' +
                    local.slice(3, 6) + (local.length > 6 ? '&nbsp;' + local.slice(6) : '');
            } else {
                return '+' + groupFallback(digits);
            }
        } else {
            if (digits.length === 11 && (digits[0] === '8' || digits[0] === '7')) {
                return digits[0] + '&nbsp;(' + digits.slice(1, 4) + ')&nbsp;' +
                    digits.slice(4, 7) + '-' +
                    digits.slice(7, 9) + '-' +
                    digits.slice(9, 11);
            } else if (digits.length === 10) {
                return '(' + digits.slice(0, 3) + ')&nbsp;' +
                    digits.slice(3, 6) + '-' +
                    digits.slice(6, 8) + '-' +
                    digits.slice(8, 10);
            } else {
                return groupFallback(digits);
            }
        }
    },
    "coordinate": function (value) {
        if (value == null) return '';
        let str = typeof value === 'string' ? value.trim() : String(value);
        if (str.indexOf(',') !== -1 && str.indexOf('.') === -1) {
            str = str.replace(',', '.');
        }
        const num = parseFloat(str);
        if (isNaN(num)) return '';
        return num.toFixed(6);
    }
};



