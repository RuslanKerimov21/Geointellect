function mustBeDouble(str) {
    if (str === null || str === undefined || str === '') {
        return 0;
    }

    const stringValue = String(str).trim();

    if (stringValue === '') {
        return 0;
    }

    const commaAsDecimal = /^-?\d{1,3}(?:\.\d{3})*(?:,\d+)$|^-?\d+,\d+$/.test(stringValue);
    if (commaAsDecimal) {
        const normalized = stringValue.replace(/\./g, '').replace(/,/g, '.');
        const result = parseFloat(normalized);
        return isNaN(result) ? 0 : result;
    }

    const dotAsDecimal = /^-?\d{1,3}(?:,\d{3})*(?:\.\d+)$|^-?\d+\.\d+$/.test(stringValue);
    if (dotAsDecimal) {
        const normalized = stringValue.replace(/,/g, '');
        const result = parseFloat(normalized);
        return isNaN(result) ? 0 : result;
    }

    const isInteger = /^-?\d+$/.test(stringValue);
    if (isInteger) {
        const result = parseInt(stringValue, 10);
        return isNaN(result) ? 0 : result;
    }

    const isScientific = /^-?\d+(?:\.\d+)?[eE][+-]?\d+$/.test(stringValue);
    if (isScientific) {
        const result = parseFloat(stringValue);
        return isNaN(result) ? 0 : result;
    }

    const hasThousands = /^-?\d{1,3}(?:[.,]\d{3})+$/.test(stringValue);
    if (hasThousands) {
        const normalized = stringValue.replace(/[.,]/g, '');
        const result = parseInt(normalized, 10);
        return isNaN(result) ? 0 : result;
    }

    const result = parseFloat(stringValue);
    if (!isNaN(result)) {
        return result;
    }

    return 0;
};

function mustBeInteger(str) {
    return Math.round(mustBeDouble(str));
};

