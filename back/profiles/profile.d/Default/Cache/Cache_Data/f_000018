        "юЙ": "yuY",
        "юй": "yuy",
        "ЮЙ": "YUY",
        "Яй": "Yay",
        "яЙ": "yaY",
        "яй": "yay",
        "ЯЙ": "YAY",
        "Эй": "Ey",
        "эЙ": "eY",
        "эй": "ey",
        "ЭЙ": "EY"
    };

    let SingleLetters = {
        'а': 'a',
        'б': 'b',
        'в': 'v',
        'г': 'g',
        'д': 'd',
        'е': 'e',
        'ё': 'e',
        'з': 'z',
        'и': 'i',
        'й': 'y',
        'к': 'k',
        'л': 'l',
        'м': 'm',
        'н': 'n',
        'о': 'o',
        'п': 'p',
        'р': 'r',
        'с': 's',
        'т': 't',
        'у': 'u',
        'ф': 'f',
        'ы': 'y',
        'э': 'e'
    };

    let DoubleLetters = {
        "ж": "zh",
        "х": "kh",
        "ц": "ts",
        "ч": "ch",
        "ш": "sh",
        "щ": "shch",
        "ю": "yu",
        "я": "ya"
    };

    let VowelsLetters = ['а', 'о', 'и', 'е', 'ё', 'э', 'ы', 'у', 'ю', 'я'];

    function escapeRegExp(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function getTransliteration(value) {
        if (!value) {
            return value;
        }

        let builder = value;

        // 'х' = 'h' if standing after vowels
        let tempBuilder = '';
        for (let i = 0; i < builder.length; i++) {
            let currentChar = builder[i];
            let lowerCurrent = currentChar.toLowerCase();

            if (i > 0 && lowerCurrent === 'х') {
                let prevChar = builder[i - 1];
                let lowerPrev = prevChar.toLowerCase();

                if (VowelsLetters.indexOf(lowerPrev) !== -1) {
                    tempBuilder += currentChar === 'х' ? 'h' : 'H';
                    continue;
                }
            }
            tempBuilder += currentChar;
        }
        builder = tempBuilder;

        // Removing the unpronounceable letters
        builder = builder.replace(/ь/gi, '');
        builder = builder.replace(/ъ/gi, '');

        // Replacing vowel combinations with the letter 'й'
        for (let key in VowelCombinations) {
            if (VowelCombinations.hasOwnProperty(key)) {
                let regex = new RegExp(escapeRegExp(key), 'g');
                builder = builder.replace(regex, VowelCombinations[key]);
            }
        }

        // Uppercase for cyrillic letters with 2+ latin letters
        let resultBuilder = '';
        for (let i = 0; i < builder.length; i++) {
            let currentChar = builder[i];
            let replaced = false;

            for (let cyrillic in DoubleLetters) {
                if (DoubleLetters.hasOwnProperty(cyrillic)) {
                    let upperCyrillic = cyrillic.toUpperCase();

                    if (currentChar === upperCyrillic) {
                        let isNextCharUpper = i < builder.length - 1 &&
                            builder[i + 1].match(/[a-zA-Zа-яА-Я]/) &&
                            builder[i + 1] === builder[i + 1].toUpperCase();
                        let isLastChar = i === builder.length - 1;

                        if (isNextCharUpper || isLastChar) {
                            resultBuilder += DoubleLetters[cyrillic].toUpperCase();
                            replaced = true;
                            break;
                        }
                    }
                }
            }

            if (!replaced) {
                resultBuilder += currentChar;
            }
        }
        builder = resultBuilder;

        // Replacing single letters
        for (let cyrillic in SingleLetters) {
            if (SingleLetters.hasOwnProperty(cyrillic)) {
                let upperCyrillic = cyrillic.toUpperCase();
                let upperLatin = SingleLetters[cyrillic].toUpperCase();

                let regexLower = new RegExp(cyrillic, 'g');
                let regexUpper = new RegExp(upperCyrillic, 'g');

                builder = builder.replace(regexLower, SingleLetters[cyrillic]);
                builder = builder.replace(regexUpper, upperLatin);
            }
        }

        // Replacing double letters with proper casing
        for (let cyrillic in DoubleLetters) {
            if (DoubleLetters.hasOwnProperty(cyrillic)) {
                let upperCyrillic = cyrillic.toUpperCase();
                let latin = DoubleLetters[cyrillic];
                let properCaseLatin = latin.charAt(0).toUpperCase() + latin.slice(1);

                let regexLower = new RegExp(cyrillic, 'g');
                let regexUpper = new RegExp(upperCyrillic, 'g');

                builder = builder.replace(regexLower, latin);
                builder = builder.replace(regexUpper, properCaseLatin);
            }
        }

        return builder;
    }

    return {
        getTransliteration: getTransliteration
    };
})();

function ToUrlSlug(str) {
