function filter2Cql(_filter) {
    var str = "";
    var len = _filter.length;
    if (len === 0) {
        return "";
    }

    var i = -1;
    _filter.forEach(function (o) {
        i++;
        var isQuoted = (!isDouble(o.Value) && !isInt(o.Value));
        var lastOr = (i === (len - 1)) ? "" : " " + o.Next + " ";

        if (o.Condition === "gte" && isQuoted) {
            if (!isDate(o.Value)) {
                str += o.FieldName + " >= '" + o.Value + "'" + lastOr;
            }
            else {
                str += o.FieldName + " >= '" + toIsoDateString(o.Value) + "'" + lastOr;
            }
        }
        else if (o.Condition === "lte" && isQuoted) {
            if (!isDate(o.Value)) {
                str += o.FieldName + " <= '" + o.Value + "'" + lastOr;
            }
            else {
                str += o.FieldName + " <= '" + toIsoDateString(o.Value) + "'" + lastOr;
            }
        }
        else if (o.Condition === "gte" && !isQuoted) {
            str += o.FieldName + " >= " + o.Value + "" + lastOr;
        }
        else if (o.Condition === "lte" && !isQuoted) {
            str += o.FieldName + " <= " + o.Value + "" + lastOr;
        }
        else if (o.Condition === "eq" && isQuoted) {
            if (!isDate(o.Value)) {
                str += o.FieldName + " = '" + o.Value + "'" + lastOr;
            }
            else {
                str += o.FieldName + " = '" + toIsoDateString(o.Value) + "'" + lastOr;
            }
        }
        else if (o.Condition === "eq" && !isQuoted) {
            str += o.FieldName + " = " + o.Value + "" + lastOr;
        }
        else if (o.Condition === "like" && isQuoted) {
            str += o.FieldName + " ilike '" + o.Value.replace(/\*/g, "%").replace(/\?/g, "_") + "'" + lastOr;
        }
        else if (o.Condition === "in") {
            var _words = o.Value.split(",");
            var newIsQuoted = false;
            var newValue = [];
            _words.forEach(function (wrd) {
                if (!isDouble(trim11(wrd)) && !isInt(trim11(wrd))) {
                    newIsQuoted = true;
                }
            });
            _words.forEach(function (wrd) {
                if (newIsQuoted) {
                    newValue.push("'" + trim11(wrd) + "'");
                } else {
                    newValue.push(trim11(wrd));
                }
            });
            str += o.FieldName + " in(" + newValue.join(",") + ")" + lastOr;
        }
        else {
            console.error("filter2Cql", i, o);
        }
    });
    return str;
};

function slider(el, min, max, step) {
    var container = el.parentElement;
    var minInput = container.querySelector('[data-id="min"]');
    var maxInput = container.querySelector('[data-id="max"]');

    minInput.value = min;
    maxInput.value = max;

    var sliderInst = noUiSlider.create(el, {
        start: [min, max],
        connect: true,
        range: { min: min, max: max },
        step: step,
        orientation: 'horizontal',
        behaviour: 'tap-drag'
    });

    sliderInst.on('slide', function (values) {
        var low = Math.round(values[0]),
            high = Math.round(values[1]);

        if (low === high) {
            sliderInst.set([minInput.value, maxInput.value]);
            return;
        }

        minInput.value = low;
        maxInput.value = high;
    });

    function syncInputs() {
        var low = parseInt(minInput.value, 10) || min,
            high = parseInt(maxInput.value, 10) || max;

        if (low >= high) {
            high = low + 1;
            minInput.value = low;
            maxInput.value = high;
        }
        sliderInst.set([low, high]);
    }

    minInput.addEventListener('input', syncInputs);
    maxInput.addEventListener('input', syncInputs);

    return sliderInst;
};

