        if (dt) dt.value = value;
    } else if (type === 'option') {
        const opts = (el.getAttribute('options') || '').split(',');
        const sel = el.querySelector('select');
        if (sel) {
            const idx = opts.findIndex(o => o.toLowerCase() === String(value).toLowerCase());
            sel.selectedIndex = idx >= 0 ? idx : 0;
        }
    }
};

function normalizeRange(a, b) {
    /*ensure start ≤ end*/
    return a < b ? [a, b] : [b, a];
};

function sumv(tableName, r1, c1, r2, c2) {
    /*sum numeric values in a table subrange*/
    const [rowStart, rowEnd] = normalizeRange(r1, r2);
    const [colStart, colEnd] = normalizeRange(c1, c2);
    let sum = 0;
    for (let r = rowStart; r <= rowEnd; r++) {
        for (let c = colStart; c <= colEnd; c++) {
            const val = Number(getv(tableName, r, c, 'number')) || 0;
            sum += val;
        }
    }
    return sum;
};

function minv(tableName, r1, c1, r2, c2) {
    /*min numeric value in a table subrange*/
    const [rowStart, rowEnd] = normalizeRange(r1, r2);
    const [colStart, colEnd] = normalizeRange(c1, c2);
    let min = Infinity;
    for (let r = rowStart; r <= rowEnd; r++) {
        for (let c = colStart; c <= colEnd; c++) {
            const val = Number(getv(tableName, r, c, 'number')) || 0;
            if (val < min) min = val;
        }
    }
    return min === Infinity ? 0 : min;
};

function maxv(tableName, r1, c1, r2, c2) {
    /*max numeric value in a table subrange*/
    const [rowStart, rowEnd] = normalizeRange(r1, r2);
    const [colStart, colEnd] = normalizeRange(c1, c2);
    let max = -Infinity;
    for (let r = rowStart; r <= rowEnd; r++) {
        for (let c = colStart; c <= colEnd; c++) {
            const val = Number(getv(tableName, r, c, 'number')) || 0;
            if (val > max) max = val;
        }
    }
    return max === -Infinity ? 0 : max;
};

