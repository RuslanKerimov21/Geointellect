function limiting_characters(maxSymbols, countElem, textElem) {
    if (countElem?.length > 0) countElem = countElem[0];
    if (textElem?.length > 0) textElem = textElem[0];
    function update() {

        try {
            const text = textElem.textContent;
            if (text.length > maxSymbols) {
                textElem.textContent = text.slice(0, maxSymbols);
            }
            countElem.textContent = maxSymbols - textElem.textContent.length;
        } catch (e) {

        }
    }
    textElem.addEventListener('input', update);
    update();
};

function limiting_characters_inp(maxSymbols, countElem, inp) {
    if (countElem?.length > 0) {
        countElem = countElem[0];
    }
    if (inp?.length > 0) {
        inp = inp[0];
    }
    inp.maxLength = maxSymbols;

    countElem.textContent = maxSymbols;

    function updateCounter() {
        var currentLength = inp.value?.length ?? 0;

        if (currentLength > maxSymbols) {
            inp.value = inp.value.substring(0, maxSymbols);
            currentLength = maxSymbols;
        }

        var remaining = maxSymbols - currentLength;

        if (remaining <= 0) {
            countElem.textContent = '0';
        } else {
            countElem.textContent = remaining;
        }
    }

    inp.addEventListener('input', updateCounter);

    updateCounter();
};

function addLineBreaks(str, maxLen = 20) {
    const words = str.split(' ');
    const lines = [];
    let line = '';

    for (const word of words) {
        const sep = line ? 1 : 0;
        if (line.length + sep + word.length > maxLen) {
            lines.push(line);
            line = word;
        } else {
            line = line ? line + ' ' + word : word;
        }
    }

    if (line) lines.push(line);
    return lines.join('<br/>');
};

