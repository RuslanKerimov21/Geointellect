    function xlsxFileToObjects(file) {
        ping("inside xlsxFileToObjects - 1");
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = function (e) {
                ping("inside xlsxFileToObjects - 2");
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });

                    if (workbook.SheetNames.length !== 1) {
                        return resolve({
                            objects: [],
                            schema: [],
                            errors: ['must have only one sheet']
                        });
                    }
                    ping("inside xlsxFileToObjects - 3");
                    const sheet = workbook.Sheets[workbook.SheetNames[0]];
                    const rows = XLSX.utils.sheet_to_json(sheet, { header: 1 });
                    ping("inside xlsxFileToObjects - 4");

                    if (!rows.length)
                        return resolve({
                            objects: [],
                            schema: [],
                            errors: ['does not have rows']
                        });

                    let schema = rows[0].map(rw => ({ title: rw, key: null, type: "string", width: "50px" }));
                    ping("inside xlsxFileToObjects - 5");

                    /*
                    for (var i = 0; i < schema.length; i++) {
                        if (detectEncoding(schema[i].title) == "cp1251") {
                            schema[i].title = convert1251ToUTF8(schema[i].title);
                        }
                    }
                    */

                    const headers = schema.map(s => s.title).map(ToUrlSlug);
                    ping("inside xlsxFileToObjects - 6");

                    const objects = rows.slice(1).map(row => {
                        const obj = {};
                        headers.forEach((h, i) => {
                            obj[h] = row[i] ?? "";
                        });
                        return obj;
                    });
                    ping("inside xlsxFileToObjects - 7");

                    for (var i = 0; i < headers.length; i++) {
                        schema[i].key = headers[i];
                    }
                    ping("inside xlsxFileToObjects - 8");

                    resolve({
                        objects: objects,
                        schema: schema,
                        errors: []
                    });
                } catch (err) {
                    reject(err);
                }
            };
            reader.onerror = reject;
            reader.readAsArrayBuffer(file);
        });
    };

    function detectEncoding(buffer) {
        const view = new Uint8Array(buffer);
        let win1251Score = 0;
        let utf8Score = 0;

        for (let i = 0; i < view.length; i++) {
            const byte = view[i];

            if (byte >= 0xC0 && byte <= 0xFF) {
                win1251Score++;
            }

            if (byte >= 0xC0 && byte <= 0xDF && i + 1 < view.length) {
                const nextByte = view[i + 1];
                if (nextByte >= 0x80 && nextByte <= 0xBF) {
                    utf8Score++;
                    i++;
                }
            }
        }

        return win1251Score > utf8Score ? 'cp1251' : 'utf-8';
    };

    function convert1251ToUTF8(input) {
        let buffer;
        if (typeof input === 'string') {
            const encoder = new TextEncoder();
            buffer = encoder.encode(input).buffer;
        } else if (input instanceof ArrayBuffer) {
            buffer = input;
        } else {
            throw new Error('Input must be string or ArrayBuffer');
        }

        const decoder = new TextDecoder('windows-1251');
        return decoder.decode(buffer);
    };

    function convert1251ToUTF8BOM(input) {
        let buffer;
        if (typeof input === 'string') {
            const encoder = new TextEncoder();
            buffer = encoder.encode(input).buffer;
        } else if (input instanceof ArrayBuffer) {
            buffer = input;
        } else {
            throw new Error('Input must be string or ArrayBuffer');
        }

        const decoder = new TextDecoder('windows-1251');
        const decodedText = decoder.decode(buffer);

        return decodedText;
    };

    function GetForbiddenKeys(schema) {
        const names = schema.map(ob => ob.key.trim().toLowerCase());
        const uniqueNames = new Set(names);
        const forbiddenKeys = ["id", "geom", "uniqueid", "login", "recdate"];
        return forbiddenKeys.filter(item => uniqueNames.has(item));
    };

    function HasDuplicateKeys(schema) {
        console.log("schema", schema);
        const names = schema.map(ob => ob.key.trim().toLowerCase());
        return names.filter((item, index) => names.indexOf(item) !== index);
    };

    function FindGeoColumns(schema, objects) {
        ping("inside FindGeoColumns - 1");
        let complete = [["x", "y"]];
        let partial = [["lng", "lat"], ["lon", "lat"], ["dol", "shir"]];
        let names = schema.map(ob => ob.key.toLowerCase());

        let found = [];

        complete.forEach((i) => {
            let f0 = names.indexOf(i[0]);
            let f1 = names.indexOf(i[1]);
            if ((f0 >= 0 && f1 >= 0) && (schema[f0].type == "double" && schema[f1].type == "double")) {
                found.push([schema[f0].key, schema[f1].key]);
            }
        });

        partial.forEach((i) => {
            let fi0 = names.find((n) => n.indexOf(i[0]) >= 0);
            let fi1 = names.find((n) => n.indexOf(i[1]) >= 0);
            if (fi0 && fi1) {
                let f0 = names.indexOf(fi0);
                let f1 = names.indexOf(fi1);
                if ((schema[f0].type == "double" && schema[f1].type == "double")) {
                    found.push([schema[f0].key, schema[f1].key]);
                }
            }
        });

        ping("inside FindGeoColumns - 2");
        return found;
    };

};

