            }
        })
        .catch((error) => console.error(error));
};

function UlaStep5Rights(stepData, navigate, win) {
    let note_md = `${gltxt("layer_new_who_will_have_access")}`;

    win.ShowLoading(gltxt("please_wait_for_operation_to_complete") + "...");

    let main_content = document.createElement('div');
    main_content.className = 'wizard-step';

    let data_loaded = false;

    let _userRights = {
        editors: stepData.userRights?.editors || [],
        viewers: stepData.userRights?.viewers || []
    };

    let left_buttons = [
        new gButton({
            iconClass: "gr-arrow-left-bold",
            text: gltxt("back"),
            className: "info",
            onClick: function () {
                navigate('previous', {
                    userRights: _userRights
                });
            }
        })
    ];

    var priv = DoWebApiAction("/user/getlogins", { content: "{}" });
    priv.done(function (e) {
        if (e.success) {
            data_loaded = true;

            const _me = UserModule?.userData?.login ?? "me_unknown";

            const users = [...[_me], ...e.results.filter(s => s != _me)];

            const userRights = new gUsersRights({
                title: gltxt("access_control"),
                owner: _me,
                users: users,
                editors: _userRights.editors || [],
                viewers: _userRights.viewers || [],
                maxHeight: "350px",
                onRightsChange: function (rights) {
                    _userRights = rights;
                }
            });

            main_content.appendChild(userRights.getElement());

            let right_buttons = [
                new gButton({
                    iconClass: "gr-arrow-right-bold",
                    text: gltxt("next"),
                    className: "default",
                    onClick: function () {
                        navigate('next', { me: _me, userRights: _userRights });
                    }
                })
            ];

            win.SetContent(
                [main_content],
                left_buttons,
                right_buttons,
                note_md
            );
        }
    });

    priv.always(function () {
        win.HideLoading();
        if (data_loaded == false) {
            win.SetContent(
                [],
                left_buttons,
                [],
                `${gltxt("unable to load logins")}`
            );
        }
    });
};

function UlaStep6Summary(stepData, navigate, win) {
    let note_md = null;

    let main_content = document.createElement('div');
    main_content.className = 'wizard-step';

    let filtered_schema = stepData.schema.filter(o => stepData.selectedProps?.indexOf(o.key) != -1);

    if (!stepData.featureCollection) {
        stepData.featureCollection = new FeatureCollection();
        stepData.featureCollection.buildSchema(filtered_schema);
    }
    
    function _getFCType() {
        if (stepData.featureCollection.features.length == 0) {
            return gltxt("collection_points");
        }
        switch (stepData.featureCollection.features[0].geometry.type) {
            case "Point":
                return gltxt("collection_points");
            default:
                return gltxt("NO_DATA");
        }
    };

    function _getGeomType() {
        if (stepData.featureCollection.features.length == 0) {
            return "point";
        }
        switch (stepData.featureCollection.features[0].geometry.type) {
            case "Point":
                return "point";
            default:
                return "point";
        }
    };

    let _stats = {};
    _stats[gltxt("features_1")] = number_format(stepData.featureCollection?.features?.length || 0, 0, ".", " ");
    _stats[gltxt("columns_1")] = String(filtered_schema.length);

    if (stepData.wrong && stepData.wrong.length > 0) {
        _stats[gltxt("error")] = String(stepData.wrong.length);        
    }

    let left_buttons = [
        new gButton({
            iconClass: "gr-arrow-left-bold",
            text: gltxt("back"),
            className: "info",
            onClick: function () {
                navigate('previous', {});
            }
        })
    ];

    let right_buttons = [
        new gButton({
            iconClass: "gr-play",
            text: gltxt("layer_new_create"),
            className: "success",
            onClick: function () {

                win.ShowLoading(gltxt("please_wait_for_operation_to_complete") + "...");

                ping("FC analysis - before");

                let _newfc = new FeatureCollection();
                _newfc.buildSchema(filtered_schema);

                for (var i = 0; i < stepData.featureCollection.features.length; i++) {
                    let _newprops = {};
                    stepData.selectedProps.forEach((key) => {
                        _newprops[key] = stepData.featureCollection.features[i].properties[key];
                    });
                    _newfc.add({
                        type: "Feature",
                        geometry: stepData.featureCollection.features[i].geometry,
                        properties: _newprops
                    });
                }

                ping("FC analysis - new props");

                for (var i = 0; i < filtered_schema.length; i++) {
                    let the_key = filtered_schema[i].key;
                    if (filtered_schema[i].type == "double") {
                        for (var fi = 0; fi < _newfc.features.length; fi++) {
                            let the_value = _newfc.features[fi].properties[the_key];
                            _newfc.features[fi].properties[the_key] = mustBeDouble(the_value);
                        }
                    }
                    else if (filtered_schema[i].type == "int") {
                        for (var fi = 0; fi < _newfc.features.length; fi++) {
                            let the_value = _newfc.features[fi].properties[the_key];
                            _newfc.features[fi].properties[the_key] = mustBeInteger(the_value);
                        }
                    }
                    else if (filtered_schema[i].type == "string") {
                        for (var fi = 0; fi < _newfc.features.length; fi++) {
                            let the_value = _newfc.features[fi].properties[the_key];
                            if (!the_value) {
                                _newfc.features[fi].properties[the_key] = "";
                            }
                        }
                    }
                }

                ping("FC analysis - after");
                
                //uuid
                let _data = {
                    name: stepData.layer_name,
                    collection: JSON.stringify(_newfc),
                    geomtype: _getGeomType(),
                    viewers: JSON.stringify(stepData.userRights.viewers || []),
                    editors: JSON.stringify(stepData.userRights.editors || []),
                    icon: stepData.selectedIcon.split(".")[0]
                };

                /*
                console.log("create", {
                    name: stepData.layer_name,
                    collection: _newfc,
                    geomtype: _getGeomType(),
                    viewers: stepData.userRights.viewers || [],
                    editors: stepData.userRights.editors || [],
                    icon: stepData.selectedIcon.split(".")[0]
                });
                */

                let svc = DoWebApiAction("/ulayers/create", _data);

                svc.done((r) => {
                    if (r.success) {
                        let svc_info = DoWebApiAction("/ulayers/info", { layer_uid: r.results });

                        svc_info.done((uid) => {
                            if (uid.success) {
                                alert(gltxt("layer_new_msg_created"));

                                var ul = new UserLayer(uid.results, window.layerListPanel);

                                if (ul.initialized) {
                                    window.layerListPanel.addUserLayer(ul);
                                    ul.on();
                                    window.layerListPanel.toggleGroupsVisibility();
                                }

                                navigate('next', {});
                            }
                            else {
                                alert(`${uid.message} => ${uid.details}`);
                            }
                        });
                    }
                    else {
                        alert(`${svc.message} => ${svc.details}`);
                    }
                });

                svc.always(() => {
                    win.HideLoading();
                });
                
            }
        })
    ];


    const summaryCard = new layerSummaryCard({
        layerName: stepData.layer_name,
        layerType: _getFCType(),
        iconUrl: getNextImagesHost() + "/icon/" + stepData.selectedIcon,
        statistics: _stats,
        owner: stepData.me,
        editors: stepData.userRights.editors || [],
        viewers: stepData.userRights.viewers || []
    });

    main_content.appendChild(summaryCard.getElement());

    win.SetContent(
        [main_content],
        left_buttons,
        right_buttons,
        note_md
    );
};
