function UlaXlsxWindow(_parent, _max_count) {
    let steps = [Ula0Welcome, UlaStep1SelectFile, UlaStep2AnalyzeSheetFile, UlaStep3Props, UlaStep4Icons, UlaStep5Rights, UlaStep6Summary];
    let currentIndex = 0;
    let win = null;
    let stepData = {
        max_rows: _max_count
    };

    stepData.videoLink = "/resources/funcparts/layer-list-panel-new-layer-plugin/help/importlayer_example.mp4";

    function initializeWizard() {
        win = new LeftWindow({
            target: _parent.layersWindow[0],
            title: gltxt("menu_create_layer_from_file"),
            subtitle: `XLSX, CSV`,
            icon: "gr-import"
        });

        win.Show();

        loadStep(currentIndex);
    }

    function loadStep(index) {
        if (index < 0 || index >= steps.length) return;

        const stepFunction = steps[index];
        const stepContent = stepFunction(stepData, navigateStep, win);
    }

    function navigateStep(direction, data = {}) {
        /*stepData = Object.assign({}, stepData, data);*/
        stepData = { ...stepData, ...data };

        if (direction === 'next') {
            if (currentIndex < steps.length - 1) {
                currentIndex++;
                loadStep(currentIndex);
            } else {
                completeWizard();
            }
        } else if (direction === 'previous') {
            if (currentIndex > 0) {
                currentIndex--;
                loadStep(currentIndex);
            }
        }
    }

    function completeWizard() {
        console.log("Wizard completed with data:", stepData);
        win.Close();
    }

    initializeWizard();

    return {
        close: () => win?.Close(),
        getCurrentStep: () => currentIndex,
        getData: () => stepData
    };
};

