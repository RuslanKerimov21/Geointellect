function LayerListPanelNewlayerPlugin() {
    var _parent = window.layerListPanel;
    this.id = "layer-list-panel-new-layer-plugin";

    var add2 = $("<div/>", { "class": "context-menu-item gr-plus icon-item" }).text(gltxt("menu_create_layer"));
    var xlsx2 = $("<div/>", { "class": "context-menu-item icon-item gr-import" }).text(gltxt("menu_create_layer_from_file"));

    let max_count = 10000;

    const init = () => {

        let qqq = getModuleParams(this.id, "max-rows-count");
        qqq.done(function (res) {
            max_count = parseInt(res.results.param_value);
        });

        qqq.always(function () {
            add2[0].addEventListener("click", function () {
                const wizard = UlaNewWindow(window.layerListPanel, max_count);
            });
            _parent.contextMenu.append(add2);

            xlsx2[0].addEventListener("click", function () {
                const wizard = UlaXlsxWindow(window.layerListPanel, max_count);
            });
            _parent.contextMenu.append(xlsx2);

            _parent.showHideBtnContextMenu();
        });
    };

    init();
};

