    var recalculateSegments = function (_line, _last_coords) {
        if (!_line || _line.geometry.coordinates.length < 1) {
            return;
        }
        localThis.line_total = JSON.parse(JSON.stringify(_line));

        if (_last_coords && _last_coords.length >= 2) {
            localThis.line_total.geometry.coordinates.push(_last_coords);
        }

        var tt = localThis.line_total.geometry.coordinates;

        localThis.line_last_segment = {
            type: "Feature",
            properties: {},
            geometry: {
                type: "LineString",
                coordinates: [
                    tt[tt.length - 2],
                    tt[tt.length - 1]
                ]
            }
        };

        localThis.line_segments = [];
        localThis.line_segments.length = 0;

        for (var i = 0; i < tt.length; i++) {
            if (i != 0) {
                localThis.line_segments.push({
                    type: "Feature",
                    id: "" + i,
                    properties: {
                        id: i
                    },
                    geometry: {
                        type: "LineString",
                        coordinates: [
                            tt[i - 1],
                            tt[i]
                        ]
                    }
                });
            }
        }
    };

