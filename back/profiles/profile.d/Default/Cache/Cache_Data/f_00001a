    var insersectPointInGraphics = function (pp) {
        var point = turf.point([pp.latlng.lng, pp.latlng.lat]);
        var draw_graphics = null;
        if (localThis.options?.graphics) {
            draw_graphics = localThis.options?.graphics.toGeoJSON();
        }

        var intersect_geom = false;
        switch (draw_graphics.geometry.type) {
            case "Polygon":
                var polygon = turf.polygon(draw_graphics.geometry.coordinates);
                intersect_geom = turf.booleanPointInPolygon(point, polygon);
                break;
            case "MultiPolygon":
                var multiPolygon = turf.multiPolygon(draw_graphics.geometry.coordinates);
                intersect_geom = turf.booleanPointInPolygon(point, polygon);

                var polygons = turf.flatten(multiPolygon);
                var count_intersect = 0;
                polygons.features.forEach(function (polygon) {
                    intersect_geom = turf.booleanPointInPolygon(point, polygon);
                    if (intersect_geom) {
                        count_intersect++;
                    }                    
                });

                intersect_geom = count_intersect > 0;
                break;
            case "LineString":
                var line = turf.lineString(draw_graphics.geometry.coordinates);
                var bufferDistance = zoomToRadius(window.MAP.getZoom());
                var buffered = turf.buffer(line, bufferDistance, { units: 'meters' });
                intersect_geom = turf.booleanPointInPolygon(point, buffered);
                break;
            case "MultiLineString":
                var lines = draw_graphics.geometry.coordinates;
                intersect_geom = lines.some(line => {
                    var lineGeo = turf.lineString(line);
                    var bufferDistance = zoomToRadius(window.MAP.getZoom());
                    var buffered = turf.buffer(lineGeo, bufferDistance, { units: 'meters' });
                    return turf.booleanPointInPolygon(point, buffered);
                });
                break;
            case "Point":
                var check_point = turf.point(draw_graphics.geometry.coordinates);
                intersect_geom = turf.booleanEqual(point, check_point);
                break;
            case "MultiPoint":
                var multiPoint = turf.multiPoint(draw_graphics.geometry.coordinates);
                intersect_geom = multiPoint.geometry.coordinates.some(function (coordinate) {
                    var multiPoint = turf.point(coordinate);
                    return turf.booleanEqual(point, multiPoint);
                });
                break;
            case "Buffer":

                break;
            default:
                break;
        }

        return intersect_geom;
    };

