        if (bytes === 0) return "0 Байт";
        var k = 1024;
        var sizes = ["Байт", "КБ", "МБ", "ГБ", "ТБ", "ПБ", "ЕБ", "ЗБ", "ЙБ"];
        var i = Math.floor(Math.log(bytes) / Math.log(k));
        return (bytes / Math.pow(k, i)).toPrecision(3) + " " + sizes[i];
    };

    /*сгенерировать список с файлами*/
    var generateFileList = function () {
        localThis.parts.files.children().remove();
        var readfiles = DoWebApiAction("/attachments/get_attachments", { layer_uid: localThis.feature.layer.uid, object_uid: localThis.feature.properties.uniqueid });
        readfiles.done(function (r) {
            if (r.success && r.results !== null) {
                localThis.filearray.length = 0;
                localThis.filearray.length = [];
                localThis.filearray = r.results;
                $.each(localThis.filearray, function (i, fileinfo) {
                    localThis.parts.files.append(generateOneFileRow(fileinfo));
                });
                localThis.onSelectionChanged();
            }
        });
        localThis.setActiveForm("list", "files");
    };

    /*возвращает инфу о файле из массива filearray по айдишнику этого файла*/
    var getFileInfoById = function (fileId) {
        var file = null;
        $.each(localThis.filearray, function (i, fi) {
            if (fi.Uid === fileId) {
                file = $.extend({}, fi);
            }
        });
        return file;
    };

    /*привязать к кнопкам события*/
    var bindDialogEvents = function () {
