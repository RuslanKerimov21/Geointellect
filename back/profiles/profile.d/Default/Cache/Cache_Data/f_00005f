        localThis.dialog.find("[data-role=buttons]").css({ display: "inline-block" });
        localThis.dialog.find("[data-role=newObjectAttributes]").transit({ opacity: 1.0, delay: 0, duration: 300, scale: 1.0, top: "0px" });
