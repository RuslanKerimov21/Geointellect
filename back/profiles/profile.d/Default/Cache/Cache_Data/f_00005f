function PixiLayerMarkerRenderer() {
    const instance = this;

    this.module = "layer-list-panel/vector-point-marker";

    this.logger = new LocalLogger("layer-list-panel/vector-point-marker");

    function CanvasClickManager() {
        const state = {
            subscribed: false,
            canvas: null,
            clicked: false,
        };

        function handle(e) {
            if (state.clicked) {
                e.stopPropagation();
            }

            state.clicked = false;
        }

        function subscribe(utils) {
            if (state.subscribed) return;
            state.subscribed = true;
            state.canvas = utils.getRenderer().view;
            state.canvas.addEventListener("click", handle);
            state.canvas.addEventListener("mousedown", handle);
            state.canvas.addEventListener("touchstart", handle);
        }

        function unsubscribe() {
            state.canvas.removeEventListener("click", handle);
            state.canvas.removeEventListener("mousedown", handle);
            state.canvas.removeEventListener("touchstart", handle);
            state.canvas = null;
            state.subscribed = false;
        }

        function click() {
            state.clicked = true;
        }

        return {
            click,
            subscribe,
            unsubscribe,
        };
    }

    const click_manager = CanvasClickManager();

    this.store = zustand.createStore(
        zustand.subscribeWithSelector(() => ({
            features: [],
            /** @type {{ distance: number, points: number, noise: boolean }} */
            cluster: null,
            opacity: 1,
            /** @type {{ radius: number | Record<string, number>; color: string; stroke: { width: number; color: string | { property: string; values: Array<{ value: string; color: string; }> } }; text: { size: number; color: string; } }} */
            style: {
                radius: 16,
                color: "#FFFFFF",
                stroke: {
                    width: 2,
                    color: "#000000",
                },
                text: {
                    size: 12,
                    color: "#000000",
                },
            },
        })),
    );

    function resolve_radius(radius, length) {
        if (typeof radius === "number") return radius;

        const breakpoints = Object.keys(radius)
            .map((x) => parseInt(x, 10))
            .sort((a, b) => b - a);

        for (const breakpoint of breakpoints) {
            if (breakpoint <= length) {
                return radius[breakpoint];
            }
        }
    }

    function resolve_count(feature, property) {
        if ("dataset" in feature.properties) {
            return feature.properties.dataset.reduce(
                (sum, feature) => sum + resolve_count(feature, property),
                0
            );
        }

        if (property in feature.properties) {
            const value = feature.properties[property];
            
            /**
             * if value is object that means that is a group.
             * key - property value as string
             * value - number of features with that property
             * so we need to sum them up.
             */
            if (typeof value === "object") {
                return Object.entries(value).reduce(
                    (sum, [key, value]) => sum + parseInt(key, 10) * value,
                    0
                );
            }
            
            if (typeof value === "number") {
                return value;
            }
        }

        /**
         * count is number of features in a group.
         */
        if ('count' in feature.properties) {
            return feature.properties.count;
        }

        return 1;
    }

    function resolve_pichart_data(feature, property, counting = true, result = {}) {
        if ("dataset" in feature.properties) {
            for (const item of feature.properties.dataset) {
                resolve_pichart_data(item, property, counting, result);
            }
        }

        if (property in feature.properties) {
            const value = feature.properties[property];
            if (typeof value === "object") {
                for (const [name, count] of Object.entries(value)) {
                    result[name] ??= 1;
                    counting && (result[name] += count);
                }
            } else {
                result[value] ??= 1;
                counting && (result[value] += 1);
            }
        }

        return result;
    }

    function redraw() {
        if (!instance.Layer.utils) return;

        const container = instance.Layer.utils.getContainer();
        container.removeChildren();

        const { features, style } = instance.store.get();

        for (const feature of features) {
            // TODO: put a property in module params.
            const count = resolve_count(feature, "event_group");
            const radius = resolve_radius(style.radius, count);

            const clickPopup = new MarkerLayerPopup({ feature });

            const marker = new PointRenderer(feature, instance.Layer)
                .when(
                    typeof style.stroke.color === "string",
                    builder => builder.lineStyle(style.stroke.width, style.stroke.color),
                    builder => {
                        const { property, values } = style.stroke.color;

                        return builder.addPiechart({
                            // TODO: put counting flag in module params.
                            data: resolve_pichart_data(feature, property, false),
                            palette: Object.fromEntries(
                                values.map((pair) => [pair.value, pair.color]),
                            ),
                            innerRadius: radius,
                            radius: radius + style.stroke.width,
                            startAngle: 0,
                        });
                    }
                )
                .addCircle({
                    radius,
                    fillColor: style.color,
                })
                .addText({
                    content: count,
                    fontSize: style.text.size,
                    fill: style.text.color,
                })
                .addEventListener("click", () => {
                    click_manager.click();
                    clickPopup.show("widgets", [
                        {
                            type: "text",
                            content: "Test Heading",
                        },
                        {
                            type: "table",
                            header: ["Категория", "Кол-во"],
                            data: [
                                {
                                    operation: "select",
                                    property: 'area_group_name',
                                },
                                {
                                    operation: "count",
                                    property: 'area_group_name',
                                }
                            ],
                        },
                        {
                            type: "list",
                            property: "area_group_name",
                        },
                        {
                            type: "link",
                            text: "Link",
                            href: "https://google.com",
                        },
                    ]);
                });

            container.addChild(marker.get());
        }
    }

    function render() {
        if (!instance.Layer.utils) return;

        /** @type {import("@pixi/display").Container} */
        const container = instance.Layer.utils.getContainer();
        /** @type {import("@pixi/core").Renderer} */
        const renderer = instance.Layer.utils.getRenderer();
        const scale = instance.Layer.utils.getScale();

        container.children.forEach(function (child) {
            // child.scale.set(1 / Math.max(Math.min(20, scale), 0));
            child.scale.set(1 / scale);
        });

        renderer.render(container);
    }

    this.Layer = L.pixiOverlay(
        (utils) => {
            click_manager.subscribe(utils);
            render();
        },
        new PIXI.Container(),
        {
            layerType:
                "multi-cluster" /* to exclude multi cluster layers from pdf generation */,
            doubleBuffering: /iPad|iPhone|iPod/.test(navigator.userAgent),
            pane: "markerPane",
            preserveDrawingBuffer: true,
        },
    );

    this.store.subscribe(
        (state) => state.features,
        (features) => {
            if (features.length === 0) {
                if (window.MAP.hasLayer(instance.Layer)) {
                    click_manager.unsubscribe();
                    window.MAP.removeLayer(instance.Layer);
                }

                return;
            }

            if (!window.MAP.hasLayer(instance.Layer)) {
                window.MAP.addLayer(instance.Layer);
            }

            redraw();
            render();
        },
    );

    this.store.subscribe(
        (state) => state.opacity,
        (opacity) => {
            if (!instance.Layer.utils) return;

            const renderer = instance.Layer.utils.getRenderer();
            const container = instance.Layer.utils.getContainer();

            container.alpha = opacity;

            renderer.render(container);
        },
    );

    /**
     * @param {Array<GeoJSON.Feature>} features
     * @param {{ distance: number, points: number, noise: boolean }} options
     */
    function clustersDbscan(features, options) {
        const { distance, points = 0, noise = true } = options;

        const clusters = [];
        const noise_clusters = [];

        const dbscan = turf.clustersDbscan(
            turf.featureCollection(features),
            distance,
            { minPoints: points },
        );

        for (const feature of dbscan.features) {
            if (feature.properties.dbscan === "noise") {
                if (noise) {
                    noise_clusters.push(feature);
                }

                continue;
            }

            const cluster = (clusters[feature.properties.cluster] ??= []);
            cluster.push(feature);
        }

        return clusters
            .map((cluster, id) =>
                turf.centerOfMass(turf.featureCollection(cluster), {
                    properties: {
                        cluster: id,
                        dataset: cluster,
                    },
                }),
            )
            .concat(noise_clusters);
    }

    this.cluster = (cluster) => {
        instance.store.set({ cluster });
    };

    this.style = (style) => {
        instance.store.set({ style });
    };

    let cluster_cleanup = null;
    this.features = (features) => {
        const state = instance.store.get();
        if (state.cluster !== null) {
            if (cluster_cleanup) {
                cluster_cleanup();
                cluster_cleanup = null;
            }

            cluster_cleanup = this.store.subscribe(
                (state) => state.cluster,
                (cluster) => {
                    instance.store.set({
                        features: clustersDbscan(features, cluster)
                    });
                }
            );
            
            instance.store.set({
                features: clustersDbscan(features, state.cluster)
            });

            return;
        }

        instance.store.set({ features });
    };
}

function VectorPointMarkerLayer(_options, layerPanel) {
    if (typeof _options === "undefined" || _options === null) return null;

    const instance = this;

    this.logger = new LocalLogger("layer-list-panel/vector-point-marker");
    this.fetcher = new LayerDataFetcher(_options.id, layerPanel.globalStore);
    this.renderer = new PixiLayerMarkerRenderer();

    const template = `
    <div class="layer-item" data-id="{{lid}}" data-index="" data-url="{{lurl}}" data-type="{{ltype}}" data-isactive="{{lactive}}"   data-expanded="{{lexpanded}}" data-visible="false">
        <div class="top-panel">
            <div class="checkbox" data-action="checked_selected"></div>
            <div class="filter-container"  title="{{layer_filter_applied}}" style="background-repeat:no-repeat;background-position:center"></div>
            <div class="caption" title="{{lname}}">{{lname}}</div>
            <div class="arrow gr-down-l" data-action="to_expand"></div>
        </div>
        <div class="waiter" data-visible="false" oncontextmenu="false">
            <div class="progress"></div>
        </div>
    </div>`;

    // const store = zustand.createStore(zustand.subscribeWithSelector(function (set,get) {
    //     return {
    //         cql: "",
    //     }
    // }));

    /**
     * @type {{ dataset: { id: number; join: { source: string; target: string } }, zooms: Record<string, { geom: number, group: string }>, cluster: { distance: Record<string, number> } }}
     */
    this.params = {};
    this.dataset_layer = null;
    var mapLayerObject = null;
    let elementLayer = null;
    let options = new LayerOptions(_options);
    let getStore = layerPanel.globalStore.getState();

    /*Нам надо положить опшины в глоб. стейт */
    getStore.addOptions({
        id: options.id,
        options: { ...options },
    });

    let opts = getStore.getOptions(_options.id).options;

    layerPanel.globalStore.subscribe(
        function (state) {
            return state.getOptions(_options.id).options.isactive;
        },
        function (isActive) {
            if (isActive !== undefined) {
                isActive ? on() : off();
            }
        },
    );

    layerPanel.layerCityStorage.addLayerCities(
        opts.id,
        _options?.listTerra ?? [],
    );

    let parts = {
        self: null,
        top: null,
        tools: null,
        legend: null,
    };

    this.filter = [];
    this.rules = [];
    this.timelineYears = opts.timelineYears;
    this.getOptions = function () {
        return opts;
    };

    function createMapObject() {
        let index;
        elementLayer?.getIndexLayer() == ""
            ? (index = opts.Zindex)
            : (index = elementLayer?.getIndexLayer());
        let zIndex = index;

        let layer_options = {
            pane: "geoLayers",
            layers: "Geointellect",
            attribution: "",
            format: "image/png",
            transparent: true,
            version: "1.1.1",
            opacity: 1,
            maxZoom: 22,
            zIndex: zIndex,
            subdomains: opts.hsts.subdomains,
        };
        mapLayerObject = L.tileLayer.wms(opts.source_url, layer_options);
        mapLayerObject.setOpacity(opts.opacity);
        mapLayerObject.options.opacity = opts.opacity;
        refresh();
    }

    function destroyMapObject() {
        mapLayerObject = null;
    }

    function applyWaiter(_state) {
        waiters = layerPanel.layersWindow[0].querySelectorAll(
            ".layer-list .scroll-container .layer-item[data-id='" +
                opts.id +
                "']",
        );
        waiters.forEach(function (_waiter) {
            const waiter = _waiter.querySelector(".waiter");
            waiter.setAttribute("data-visible", _state);
        });
    }

    function on() {
        instance.enabled = true;
        // applyWaiter(true);
        createMapObject();

        const promises = [instance.fetcher.fetch()];

        if (instance.dataset_layer) {
            const { setOptions } = layerPanel.globalStore.get();
            setOptions(instance.dataset_layer.id, { isactive: true });
            const promise = instance.dataset_layer.fetcher.fetch();
            promises.push(promise);
        }

        Promise.all(promises)
            .then(function () {
                update_render_features();
                // applyWaiter(false);
                window.ClusterPopup?.toggleWidget(true);

                layerPanel.selectionChanged();
                layerPanel.saveSelectedLayers();
            })
            .catch((e) => {
                // applyWaiter(false);
                e && console.error(e);
            });
    }

    function off() {
        instance.enabled = false;
        if (instance.dataset_layer) {
            layerPanel.globalStore
                .get()
                .setOptions(instance.dataset_layer.id, { isactive: false });
        }

        instance.renderer.add([]);

        layerPanel.selectionChanged();
        layerPanel.saveSelectedLayers();
        destroyMapObject();
        window.ClusterPopup?.toggleWidget(false);
    }

    function getMapObject() {
        return mapLayerObject;
    }

    function refresh() {
        var _date1 = Cookies.get("date_from");
        var _date2 = Cookies.get("date_to");
        var _dirty = _date1 + "_" + _date2;

        opts.wmsParams = {
            ...mapLayerObject?.wmsParams,
            is_public: window._is_public ?? false ? "true" : "false",
            public_credentials: window._public_credentials,
            dstate: _dirty,
            gi_city: window.G.Dynamic.getValue(GiEvents.TerraId),
        };

        if (mapLayerObject) {
            mapLayerObject.wmsParams = {
                ...mapLayerObject.wmsParams,
                is_public: opts.wmsParams.is_public,
                public_credentials: opts.wmsParams.public_credentials,
                dstate: opts.wmsParams.dstate,
                gi_city: opts.wmsParams.gi_city,
            };

            mapLayerObject.setParams(mapLayerObject.wmsParams);
        }
    }

    function sendOneObjectToServer(_feature) {
        var _data = {
            layerid: opts.id,
            feature: JSON.stringify(_feature),
        };

        return DoWebApiAction("/layer_update/insert", _data);
    }

    function checkAttribute(_name_attribute) {
        let _check = false;
        _check =
            opts.schema.filter((xx) => xx.name === _name_attribute).length > 0;
        if (!_check) {
            _check =
                opts.schema.filter(
                    (xx) => xx.aliases[0].alias === _name_attribute,
                ).length > 0;
        }
        return _check;
    }

    function checkLayerHasTerra(_terra_id) {
        return (
            layerPanel?.layerCityStorage.layerHasCity(opts.id, _terra_id) ??
            false
        );
    }

    function getHtmlElement() {
        return parts.self;
    }

    this.store = zustand.createStore(
        zustand.subscribeWithSelector((set) => ({
            grouping: {
                geom: null,
                group: null,
            },
            chooseGrouping(params, zoom) {
                const zoomBreakpoints = Object.keys(params.zooms)
                    .sort((a, b) => a - b)
                    .reverse();

                for (const breakpointZoom of zoomBreakpoints) {
                    if (breakpointZoom <= zoom) {
                        const grouping = params.zooms[breakpointZoom];
                        return set({ grouping });
                    }
                }

                const grouping = params.zooms[zoomBreakpoints.at(-1)];
                return set({ grouping });
            },
        })),
    );

    /* called on layer activation and fetchers update */
    function update_render_features() {
        const features = [];

        instance.fetcher.eachlookup((lookup, group) => {
            const { geometry } = lookup[0];
            let dataset = lookup;

            if (instance.dataset_layer) {
                dataset = [];
                for (const feature of lookup) {
                    const join = instance.params.dataset.join.source;
                    const key = feature.properties[join];
                    const data = instance.dataset_layer.fetcher.lookup(key);
                    if (data) {
                        data.forEach((item) => dataset.push(item));
                    }
                }
            }

            if (dataset.length) {
                features.push({
                    type: "Feature",
                    geometry,
                    properties: {
                        group,
                        dataset,
                    },
                });
            }
        });

        instance.renderer.add(features);

        window.ClusterPopup?.setWidgetContent({
            year: 2025,
            month: 9,
            current: {
                eventsCount: features.reduce(
                    (acc, val) => (acc += val.properties?.dataset?.length ?? 0),
                    0,
                ),
            },
            prev: {
                eventsCount: 0,
            },
        });
    }

    function init() {
        if (!layerPanel?.layersWindow) return;

        let layersContainer = layerPanel.layersWindow[0].querySelector(
            ".layer-list .scroll-container",
        );

        elementLayer = new LayerElementContollers(
            opts,
            layersContainer,
            instance,
            template,
        );

        parts = elementLayer.getParts();

        opts.initialized = true;

        loadModuleParams().then((params) => {
            instance.params = params;
            if (!params) return;
            if (params.dataset) {
                instance.dataset_layer = layerPanel.layerList.find(
                    (l) => l.id == params.dataset.id,
                );
                instance.dataset_layer.fetcher
                    .group(
                        (feature) =>
                            feature.properties[params.dataset.join.target],
                    )
                    .subscribe(update_render_features);

                instance.dataset_layer.fetcher.settings.subscribe((state) => {
                    instance.elementLayer.markAsFiltered(state.cql !== "");
                });

                instance.dataset_layer.fetcher.store.subscribe(
                    (state) => state.loading,
                    applyWaiter,
                );

                if (params.cluster) {
                    instance.renderer.cluster(params.cluster);
                }

                if (params.style) {
                    instance.renderer.style(params.style);
                }

                const zoom = window.MAP.getZoom();
                instance.store.get().chooseGrouping(params, zoom);
                window.MAP.addEventListener("zoomend", () => {
                    const zoom = window.MAP.getZoom();
                    instance.store.get().chooseGrouping(params, zoom);
                });

                if (instance.enabled) {
                    instance.dataset_layer.fetcher.fetch();
                }
            }
        });

        instance.fetcher.subscribe(({ features }) => {
            if (instance.dataset_layer) {
                const sources = features.map(
                    (feature) =>
                        feature.properties[instance.params.dataset.join.source],
                );
                if (sources.length) {
                    // instance.dataset_layer.fetcher.settings.set({ where: `int ${instance.params.dataset.join.target} in ${sources.join(",")}` })
                }
            }

            update_render_features();
        });

        instance.fetcher.store.subscribe((state) => state.loading, applyWaiter);

        instance.store.subscribe(
            (state) => state.grouping,
            ({ geom, group }) => {
                if ((geom === null) | (group === null)) return;
                console.log("change geouting", geom, group);
                instance.fetcher.group(
                    (feature) => feature.properties[group],
                    (feature) => {
                        if (feature.geometry.type === "MultiPoint") {
                            return {
                                type: feature.type,
                                id: feature.id,
                                properties: feature.properties,
                                geometry: {
                                    type: "Point",
                                    coordinates:
                                        feature.geometry.coordinates[geom],
                                },
                            };
                        }

                        return feature;
                    },
                );
            },
        );

        /* sync opacity */
        layerPanel.globalStore.subscribe(
            (state) => state.options[_options.id]?.options.opacity,
            (opacity) => instance.renderer.store.set({ opacity }),
        );

        if (opts.timelineYears.length > 0) {
            window.G.DynamicArray.addUniqueItems(
                GiEvents.TimelineYears,
                instance.timelineYears ?? [],
            );
        }

        createMapObject();
    }

    function showInfo() {
        var a = DoWebApiAction("/layers/metadoc", { layerid: opts.id });
        a.done(function (r) {
            if (r.success) {
                layerPanel.showLayerInfo(r.results, opts.name);
            }
        });
    }

    function showFilter() {
        if (instance.dataset_layer) {
            var filter = new LayerFilterSelect(
                instance.dataset_layer,
                layerPanel.layersWindow[0],
            );
            filter.init();
        } else {
            var filter = new LayerFilterSelect(
                instance,
                layerPanel.layersWindow[0],
            );
            filter.init();
        }
    }

    this.applyFilter = function (filters) {
        if (filters) {
            layerPanel.globalStore.get().setOptions(instance.id, {
                filter: filters.map((filter) => ({
                    Alias: filter.Alias ?? filter.alias,
                    Condition: filter.Condition ?? filter.condition,
                    FieldName: filter.FieldName ?? filter.field_name,
                    Next: filter.Next ?? filter.next,
                    Value: filter.Value ?? filter.value,
                })),
            });
        }
    };

    function loadModuleParams() {
        return new Promise((resolve, reject) => {
            getModuleParams(
                "layer-list-panel",
                "vector-point-marker-layers_settings",
            ).done((r) => {
                if (!r.success || r.results == null) {
                    blinkmsg(
                        "Не указаны параметры для vector-point-marker-layers_settings",
                        10000,
                        "danger",
                    );
                    console.log(r);
                    reject();

                    return;
                }

                try {
                    const params = JSON.parse(r.results.param_value);

                    if (!params[instance.opts.id]) {
                        throw new Error(
                            `В параметрах vector-point-marker-layers_settings не указаны настройки для слоя ${instance.opts.id}`,
                        );
                    }

                    instance.params = params[instance.opts.id];

                    resolve(instance.params);
                } catch (error) {
                    blinkmsg(error.message, 10000, "danger");
                    console.log(error);
                    reject();
                }
            });
        });
    }

    init();

    this.id = opts.id;

    this.name = opts.name;
    this.type = opts.type;
    this.url = opts.url;
    this.hasTimeline = opts.timeline > 0;
    this.hasCityId = opts.hasCityId;
    this.timelineYears = opts.timelineYears;
    this.tag = opts.tag;
    this.opacity = opts.opacity;
    this.opts = opts;
    this.o = options;
    this.initialized = opts.initialized;
    this.isactive = opts.isactive;
    this.visible = opts.visible;
    this.zIndex = opts.zIndex;
    this.schema = opts.schema;
    this.legend = opts.legend;
    this.legendLoaded = opts.legendLoaded;
    this.isFavorite = opts.isFavorite;

    this.elementLayer = elementLayer;
    this.template = template;

    this.addButton = elementLayer.addButton;

    this.selfelement = parts.self;
    this.mapLayerObject = mapLayerObject;
    this.layerList = layerPanel;

    this.createMapObject = createMapObject;
    this.destroyMapObject = destroyMapObject;

    this.getMapObject = getMapObject;

    this.checkAttribute = checkAttribute;
    this.checkLayerHasTerra = checkLayerHasTerra;
    this.sendOneObjectToServer = sendOneObjectToServer;
    this.init = init;
    this.refresh = refresh;
    this.getHtmlElement = getHtmlElement;
    this.on = on;
    this.off = off;
    this.showFilter = showFilter;
    this.showInfo = showInfo;
    this.makeFavorite = elementLayer.makeFavorite;
    this.unmakeFavorite = elementLayer.unmakeFavorite;
    this.setOpacityFx = elementLayer.setOpacityFx;
    this.hide = elementLayer.hide;
    this.show = elementLayer.show;
    this.markAsFiltered = elementLayer.markAsFiltered;
}


