function createLayerCityStorage() {
    const layerToCities = new Map();
    const cityToLayers = new Map();

    function addLayerCities(layerId, cityIds) {
        if (!cityIds || cityIds.length == 0) return;
        const cities = new Set(cityIds);
        layerToCities.set(layerId, cities);

        for (const cityId of cities) {
            if (!cityToLayers.has(cityId)) {
                cityToLayers.set(cityId, new Set());
            }
            cityToLayers.get(cityId).add(layerId);
        }
    };

    function layerHasCity(layerId, cityId) {
        const cities = layerToCities.get(layerId);
        return cities ? cities.has(cityId) : false;
    };

    function getLayersForCity(cityId) {
        const layers = cityToLayers.get(cityId);
        return layers ? Array.from(layers) : [];
    };

    function removeLayer(layerId) {
        const cities = layerToCities.get(layerId);
        if (cities) {
            for (const cityId of cities) {
                const layers = cityToLayers.get(cityId);
                if (layers) {
                    layers.delete(layerId);
                    if (layers.size === 0) {
                        cityToLayers.delete(cityId);
                    }
                }
            }
            layerToCities.delete(layerId);
        }
    };

    return {
        addLayerCities,
        layerHasCity,
        getLayersForCity,
        removeLayer,
    };
};
var LayerFilter = function (layer, container) {

    let layerInfo = layer;
    var selfcontainer = null;

    let table = null;

    let G_filter_key = "";
    let G_layer_tag = "";
    let opts = layer.getOptions();
    let applied = true;
    const _max_conditions = 5;

    let pre_filter = [];
    
    let Conditions = [];

    const templateFilterWindow = `
      <div id="layerFilterWindow" data-has-items="false" data-windowtype="panel" class="bg-color-fon">
        <div class="head-container">
          <div class="icon gr-pic gr-filter-1"></div>
          <label class="title">{{layer_filter}}</label>
          <label class="subtitle">{{dlayer_name}}</label>
          <div class="close" title="{{close}}">
            <span class="gr-pic gr-close-x-r"></span>
          </div>
        </div>
        <div class="empty-body-container">
            <span style="pointer-events:none">
                {{filter_not_set}}</br>
                {{filter_add_to_configure}}
            </span>
        </div>
        <div class="body-container">
            <div class="note">
                * - {{layer_filter_help_zvezda}}<br/>
                ? - {{layer_filter_help_one_any_symbol}}<br/><br/>
                {{layer_filter_help_example_for_contains}}:<br/>
                {{layer_filter_help_contains_example_text}}<br/>
                {{result}}: {{layer_filter_help_contains_example_text_r1}}
                {{layer_filter_help_contains_example_text_r2}}
                {{layer_filter_help_contains_example_text_r3}}
            </div>
            <div class="container">
                <div class="items">

                </div>
                <div class="buttons">
                    <div class="left">
                    </div>
                    <div class="right">
                    </div>
                </div>
            </div>
        </div>
      </div>
    `;

    function buildWindow() {

        selfcontainer?.replaceChild();
        pre_filter = [];
        pre_filter.length = 0;

        selfcontainer = HtmlElementFromText(localizeHtml(templateFilterWindow), [
            { key: "dlayer_name", value: opts.name }
        ]);
       
        let closeBtn = selfcontainer.querySelector('.close');
        closeBtn?.addEventListener('click', function () {
            function doCloseAnimation() {
                var el = selfcontainer;
                el.style.transition = 'top 200ms ease, opacity 200ms ease';
                el.style.top = '200px';
                el.style.opacity = '0';
                el.addEventListener('transitionend', function handler() {
                    el.removeEventListener('transitionend', handler);
                    kill();
                });
            };

            if (!applied) {
                var question = gltxt("layer_filter_close_question");
                var okBtn = {
                    type: "ok",
                    action: doCloseAnimation,
                    title: "",
                    text: gltxt("yes"),
                    icon: false,
                    "class": "btn_confirm"
                };
                var cancelBtn = {
                    type: "skip",
                    action: function () { },
                    title: "",
                    text: gltxt("no"),
                    icon: false,
                    "class": "btn_confirm customAlertBtnCancel"
                };
                customConfirm(question, null, [okBtn, cancelBtn], 400, 120);
            } else {
                doCloseAnimation();
            }
        });

        let filter_read = window.G.DynamicArray.getValue(G_filter_key);

        if (filter_read == null || typeof filter_read == "undefined") { filter_read = opts.filter; }

        if (filter_read && filter_read.length > 0) {
            selfcontainer.setAttribute("data-has-items", "true");
            filter_read.forEach(function (item) {               
                pre_filter.push(CreateFilterItem({
                    name: item.FieldName,
                    condition: item.Condition,
                    value: item.Value
                }));
            });
            renderFilterPart();
        }

        if (!opts.schema) return;

        const addBtn = new gButton({
            iconClass: "gr-plus",
            text: gltxt("add"),
            className: "default",
            onClick: onAddClick
        });
        selfcontainer.querySelector('.left').appendChild(addBtn.getElement());
        selfcontainer.querySelector('.empty-body-container').appendChild(addBtn.clone().getElement());

        const clearBtn = new gButton({
            iconClass: "gr-trash",
            text: gltxt("clear"),
            className: "danger",
            onClick: removeAllConditions
        });
        selfcontainer.querySelector('.right').appendChild(clearBtn.getElement());

        const applyBtn = new gButton({
            iconClass: "gr-arrow-right-bold",
            text: gltxt("apply"),
            className: "default",
            onClick: function () {
                if (checkFilter()) {
                    applyFilter();                  
                }
            }
        });
        selfcontainer.querySelector('.right').appendChild(applyBtn.getElement());
    };

    function onAddClick(e) {
        if (pre_filter.length >= _max_conditions) {
            blinkmsg(gltxt("layer_filter_max_conditions").replace("{0}", _max_conditions), 3000, "warning");
            return;
        }
        
        pre_filter.push(CreateFilterItem());
        renderFilterPart();
    };

    function CreateFilterItem(_options) {        
        let _properties = opts.schema.map(function (prop) {
            return {
                name: prop.name,
                alias: prop.aliases[0]?.alias ?? prop.name,
                selected: false
            };
        });

        let _name = _options?.name ?? _properties[0].name;

        _properties.forEach(function (item) {
            item.selected = item.name === _name;
        });

        return new gFieldFilterItem({
            name: _name,
            condition: _options?.condition ?? "eq",
            value: _options?.value ?? "",
            properties: _properties,
            onRemove: function (id, e) {
                animateDeleteItemPromise(id).then(function () {
                    pre_filter = pre_filter.filter(function (item) {
                        return item.id !== id;
                    });
                    renderFilterPart();
                });
            }
        });
    };

    function clearFilter() {
        pre_filter = [];
        pre_filter.length = 0;
        selfcontainer.querySelectorAll(".gfield-filter-item").forEach(function (item) {
            item.remove();
        });
    };

    function renderFilterPart() {
        selfcontainer.querySelectorAll(".gfield-filter-item").forEach(function (item) {
            item.remove();
        });

        if (!opts.schema) return;

        pre_filter.forEach(function (item) {
            selfcontainer.querySelector(".items").appendChild(item.getElement());
        });

        if (pre_filter.length == 0) {
            selfcontainer.setAttribute("data-has-items", "false");
            saveFilter(); // сохраняем фильтры, иначе выбросит на экран, где нет кнопки "Применить"
        }
        else {
            selfcontainer.setAttribute("data-has-items", "true");
        }
    };

    function removeAllConditions() {
        const okBtn = {
            type: "ok",
            action: function () {
                clearFilter();
                applyFilter();
              /*  layerInfo.markAsFiltered(false);*/
                applied = false;
            },
            title: "",
            text: gltxt("yes"),
            icon: false,
            "class": "btn_confirm"
        };

        const cancelBtn = {
            type: "skip",
            action: function () { },
            title: "",
            text: gltxt("no"),
            icon: false,
            "class": "btn_confirm"
        };

        const questionText = gltxt("layer_filter_clear_question");
        customConfirm(questionText, null, [okBtn, cancelBtn], 400, 100);
    };

    function show() {
        const win = selfcontainer;
        if (!win) return;
        const parent = container || document.body;
        parent.appendChild(win);

        win.style.transition = 'left 200ms ease, opacity 200ms ease';
        win.style.left = '1px';
        win.style.opacity = '1';
    };

    function kill() {
        if (selfcontainer) {
            selfcontainer.remove();
        }
    };

    function animateDeleteItemPromise(id) {
        return new Promise((resolve) => {
            const item = document.getElementById(id);
            if (item) {
                item.querySelectorAll("*").forEach(function (child) {
                    child.remove();
                });
                item.style.pointerEvents = 'none';
                item.style.padding = '2rem';
                item.style.transition = 'opacity 200ms ease, height 200ms ease, transform 200ms ease';
                item.style.opacity = '0.7';
                item.style.height = '1px';
                item.addEventListener('transitionend', function handler(e) {
                    if (e.propertyName !== 'opacity') return;
                    item.removeEventListener('transitionend', handler);

                    item.style.transition = 'opacity 200ms ease, padding 200ms ease, transform 200ms ease';
                    item.style.opacity = '0';
                    item.style.padding = '0px';
                    item.style.transform = 'translateX(-400px)';
                    item.addEventListener('transitionend', function lasthandler(evnt) {
                        if (evnt.propertyName !== 'opacity') return;
                        item.removeEventListener('transitionend', lasthandler);
                        resolve();
                    });
                });
            }
        });
    };

    function applyFilter() {
        const win = selfcontainer;
        if (!win) return;

        win.style.transition = 'top 200ms ease, left 200ms ease, transform 200ms ease, opacity 200ms ease';
        win.style.top = '200px';
        win.style.left = '500px';
        win.style.transform = 'scale(0.6)';
        win.style.opacity = '0.7';

        win.addEventListener('transitionend', function phaseOne(e) {
            if (e.propertyName !== 'opacity') return;
            win.removeEventListener('transitionend', phaseOne);

            win.style.transition = 'transform 200ms ease, opacity 200ms ease';
            win.style.transform = 'scale(0.2)';
            win.style.opacity = '0';

            win.addEventListener('transitionend', function phaseTwo(e2) {
                if (e2.propertyName !== 'opacity') return;
                win.removeEventListener('transitionend', phaseTwo);

                saveFilter();
                layerInfo.applyFilter();
                kill();
            });
        });

        const map = document.getElementById('themap');
        if (map) {
            map.style.transition = 'transform 200ms ease';
            map.style.transform = 'scale(1.1)';

            map.addEventListener('transitionend', function mapUp(e) {
                if (e.propertyName !== 'transform') return;
                map.removeEventListener('transitionend', mapUp);

                map.style.transition = 'transform 200ms cubic-bezier(0.455,0.03,0.515,0.955)';
                map.style.transform = 'scale(1)';
            });
        }
    };

