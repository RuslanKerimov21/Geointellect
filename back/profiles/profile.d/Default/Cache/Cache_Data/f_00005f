        removeLegend();
        parts.legend = null;
        parts.legend = HtmlElementFromText(localizeHtml(template_dynamicLayer_legend));
       
        let gRules = globalStore.getOptions(_opts.id).options.rules;

        for (var i = 0; i < gRules.length; i++) {
            if (gRules[i].filter && gRules[i].filter.length >= 3) {
                renderAllLegendToggler();
                break;
            }
        }

        for (var i = 0; i < gRules.length; i++) {
         
            RenderOneLegendItem(gRules[i]);
            legendItems.push(gRules[i].elem);
        }
        parts.self.appendChild(parts.legend);
        
    };

    function removeLegend() {
        parts.legend?.remove();
    };

    function renderAllLegendToggler() {
        var legend_item = HtmlElementFromText(localizeHtml(template_dynamicLayer_legend_item));
        var img_container = legend_item.querySelector(".legend-image");
        img_container?.replaceChildren();
        
        legend_item.querySelectorAll("[data-field=title]").forEach(function (item) {
            item.setAttribute("title", gltxt("toggle_all"));
            item.innerHTML = gltxt("toggle_all");
        });

        parts.legend.querySelector(".legend-content")?.appendChild(legend_item);

        parts.checkboxAllLegendItem = legend_item.querySelectorAll(".checkbox")[0];

        parts.checkboxAllLegendItem.setAttribute("data-active", checkedUnCheckedAllTagsLegend());

        parts.checkboxAllLegendItem.addEventListener("click", (e) => {
            let checked = e.target.dataset.active;
            e.target.dataset.active === "true" ? checked = false : checked = true;
            // globalStore.getOptions(_opts.id).options.rules.forEach(function (r) { r.is_checked = checked; });

            let rules = globalStore.getOptions(_opts.id).options.rules.map(function (rule) {
                return {
                    ...rule,
                    is_checked: checked,
                }
            });
            
            globalStore.updateOptions(_opts.id, { rules })
            legendItems.forEach((_item) => {
                _item.querySelector(".checkbox")?.setAttribute("data-active", checked);
            });
            checkedUnCheckedAllTagsLegend();

            moduleLayers.uploadLegend();
            _layerController.instansLayer.applyFilter();
        });

        parts.checkboxAllLegendItem.style.display = "block";
        parts.checkboxAllLegendItem.style.opacity = "1";
        parts.checkboxAllLegendItem.style.pointerEvents = "all";
    };

    function RenderOneLegendItem(legend) {
        legend.elem = HtmlElementFromText(localizeHtml(template_dynamicLayer_legend_item));
        var img_container = legend.elem.querySelector(".legend-image");
        img_container?.replaceChildren();

        legend.is_checked ??= true;

        var checkbox = legend.elem.querySelectorAll(".checkbox");
        checkbox.forEach(function (item) {
            item.setAttribute("data-active", legend.is_checked);
        });

        if (legend.symbol) {

            legend.symbol.forEach(s => {
                switch (s.type) {

                    case 'url': {
                        const img = document.createElement('img');
                        img.src = s.icon_url;
                        img.setAttribute('data-field', 'image');
                        img.style.width = s.icon_size + 'px';
                        img_container.appendChild(img);
                        break;
                    }

                    case 'square':
                    case 'circle':
                    case 'polygon': {
                        const template = {
                            square: svg_square,
                            circle: svg_circle,
                            polygon: svg_poly
                        }[s.type];

                        const SVGReplacements = {
                            'fill': s.fill_color,
                            'fill-opacity': s.fill_opacity,
                            'stroke': s.stroke_color,
                            'stroke-opacity': s.stroke_opacity,
                            'width': (s.stroke_width ?? '0.5') + 'px'
                        }

                        let svgtxt = template; 
                     
                        Object.entries(SVGReplacements).forEach(([property, value]) => {
                            if (value != null) {
                                svgtxt = ReplaceSvgProperty(svgtxt, property, value);
                            }
                        });

                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = svgtxt;
                        const img = tempDiv.firstChild;
                        img.setAttribute('data-field', 'image');
                        img.style.width = s.icon_size + 'px';
                        img_container.appendChild(img);
                        break;
                    }

                    case 'line': {
                        const template = {
                            line: svg_line
                        }[s.type];

                        const SVGReplacements = {
                            'stroke': s.stroke_color,
                            'width': (s.stroke_width ?? '1.5') + 'px'
                        };

                        let svgtxt = template; 

                        Object.entries(SVGReplacements).forEach(([property, value]) => {
                            if (value != null) {
                                svgtxt = ReplaceSvgProperty(svgtxt, property, value);
                            }
                        });

                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = svgtxt;
                        const img = tempDiv.firstChild;
                        img.setAttribute('data-field', 'image');
                        img.style.width = s.icon_size + 'px';
                        img_container.appendChild(img);
                        break;
                    }

                    default: {
                        break;
                    }
                }
            });
        }

        legend.elem.querySelectorAll("[data-field=title]").forEach(function (item) {
            item.setAttribute("title", legend.title);
            item.innerHTML = legend.title;
        });
       
        parts.legend.querySelector(".legend-content")?.appendChild(legend.elem);

        if (legend.filter && legend.filter.length >= 3) {
            checkbox.forEach(function (item) {
                item.setAttribute("data-active", legend.is_checked);

                item.addEventListener("click", function (e) {
                    let checked = legend.is_checked;
                    legend.is_checked ? checked = false : checked = true;
                    legend.is_checked = checked;
                    e.target.dataset.active = checked;

                    globalStore.updateOptions(_opts.id, { rules: updateValueRules(legend) });
                    moduleLayers.uploadLegend();
                    checkedUnCheckedAllTagsLegend();

                    _layerController.instansLayer.applyFilter();
                });

                item.style.display = "block";
                item.style.opacity = "1";
                item.style.pointerEvents = "all";
            });
        } else {
            checkbox.forEach((_checkbox) => { _checkbox.remove(); })
            legend.elem.classList.add("checkbox-not-required");
            _layerController.instansLayer.store.get().cql = "";
        }

    };

    /*Заберем легенду (включенные || отключенные галочки) с модуль парамсов или с ссылки */
    function getLegendModuleParams() {
        let activeRules = moduleLayers.findLegendRules(_opts.id);
        if (activeRules?.length === 0 || activeRules===null) return;
        if (activeRules) {            
            let rules = globalStore.getOptions(_opts.id).options.rules;
            rules.forEach((rul) => {
                rul.is_checked = false;
                for (let i = 0; i < activeRules.length; i++) {
                    if (rul.idx === activeRules[i]) {
                        rul.is_checked = true;
                    }
                }
            });       
            _layerController.instansLayer.applyFilter();
        }
    };

    function updateValueRules(_item) {
        let item = _item;
        let arrRules = [...globalStore.getOptions(_opts.id).options.rules]; // пересоздаём массив, чтобы сабскрайберы получили обновление рулов
        const index = arrRules.findIndex(rul => rul.idx === item.idx );
        if (index !== -1) { arrRules[index] = { ...arrRules[index], ...item }; }
        return arrRules;
    };

    this.loadLegend = loadLegend;
    this.removeLegend = removeLegend;
}


