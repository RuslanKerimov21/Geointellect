function LayerDataFetcher(layerid, global) {
    const instance = this;

    const state = {
        active: false,
        group: undefined,
    };
    
    this.logger = new LocalLogger(layerid);

    this.settings = zustand.createStore(zustand.subscribeWithSelector(() => ({        
        cql: "",
        where: "",
        timeline: [],
        data: {},
    })));

    function GetLegendCql(rules) {
        if (!rules || rules.length === 0) return "";

        if (rules.every(rule => !rule.is_checked)) {
            return null;
        }

        if (rules.every(rule => rule.is_checked)) {
            return "";
        }
        
        return rules
            .filter(rule => rule.is_checked)
            .map(rule => rule.filter)
            .join(" OR ");
    };

    // sync filters
    global.subscribe(
        (state) => state.options[layerid]?.options,
        ({ isactive, rules, filter }) => {
            state.active = isactive;

            const legend = GetLegendCql(rules);
            if (legend === null) {
                instance.settings.set({ cql: null });
            }

            let cql = filter2Cql(filter);

            if (cql === "")
            {
                cql = legend;
            }
            else if (legend !== "")
            {
                cql = "(" + cql + ") AND (" + legend + ")";
            }

            instance.settings.set({ cql });
        }
    );

    // sync timeline
    function handleTimeline(value) {
        if (!state.active) return;
        if (!global.get().options[layerid]?.options.timeline) return;
        instance.settings.set({ timeline: value });
    }

    handleTimeline(window.G.DynamicArray.getValue(GiEvents.TimelineAppliedDates));
    window.G.DynamicArray.addListener(GiEvents.TimelineAppliedDates, ({ value }) => handleTimeline(value));

    this.settings.subscribe((current, previous) => {
        if (!state.active) return;
        if (current.cql === previous.cql && current.timeline === previous.timeline && current.data === previous.data) return;
        instance.fetch();
    });

    this.store = zustand.createStore(zustand.subscribeWithSelector(() => ({     
        loading: false,  
        features: [],
        lookup: undefined,
    })));

    function groupby(items, keys, values) {
        const result = {};

        for (let i = 0; i < items.length; i++) {
            const item = items[i];
            const key = keys(item, i);
            
            if (!result[key]) {
                result[key] = [];
            }

            result[key].push(values(item));
        }

        return result;
    }

    function identity(value) {
        return value;
    }

    /**
     * @param {(item: import("geojson").Feature, i: number) => string | number} kyes
     * @param {(item: import("geojson").Feature, i: number) => import("geojson").Feature} values
     * @returns {void}
     */
    this.group = function (kyes, values = identity) {
        state.group = {
            kyes,
            values
        };

        const { features } = instance.store.get();
        if (features.length) {
            instance.store.set({
                lookup: groupby(features, state.group.kyes, state.group.values)
            });
        }

        return instance;
    }

    /**
     * @returns {Array<import("geojson").Feature>}
     */
    this.fetch = (more_data) => {
        const { cql, where, timeline, data } = instance.settings.get();

        if (cql === null) {
            instance.store.set({ features: [], lookup: undefined });
            return Promise.resolve([]);
        }

        const body = { layerid, ...data, ...more_data };

        if (timeline.length == 1) {
            const [year] = timeline;
            body.where = `int year = ${year}`;
        }

        if (timeline.length == 2) {
            const [date_from, date_to] = timeline;         
            body.date_from = date_from;
            body.date_to = date_to;
        }

        if (cql == "") {
            return request(body);
        }

        if (where) {
            body.where = where;
        }

        instance.store.set({ loading: true });

        return new Promise((resolve, reject) => {
            instance.logger.info("Loading record reference (1/3)");
            DoWebApiAction("/record-reference", { content: cql })
            .then(function (reference) {
                instance.logger.info("Record reference request completed (2/3)");
                if (reference.success && reference.results) {
                    body.record_reference = reference.results;
                    request(body).then(resolve).catch(reject);
                    return;
                }

                instance.logger.error("Record reference loading error. ERROR: ", response.message);
                blinkmsg(`Ошибка загрузки объектов слоя (ID ${layerid})`, 5000, "danger");
            })
            .catch(function (error) {
                instance.logger.error("Cannot succeed record-reference request. ERROR: ", error);
                blinkmsg(`Ошибка загрузки объектов слоя (ID ${layerid})`, 5000, "danger");
                reject(error);
            });
        })
    }

    function request(data) {
        instance.logger.info("Loading features (1/2)");
        
        if (state.controller) {
            state.controller.abort();
            instance.logger.info("previous get objects request was aborted INTENTIONALLY to avoid race condition");
        }

        const controller = new AbortController();
        state.controller = controller;
        
        return new Promise((resolve, reject) => {
            controller.signal.addEventListener('abort', reject);

            DoWebApiAction('/glayer/features.stream', data, controller.signal)
                .then(function (response) {
                    instance.logger.info("Features loaded (2/2)");

                    try {
                        instance.store.set({ 
                            features: response,
                            lookup: state.group && groupby(response, state.group.kyes, state.group.values)
                        });
                    } catch (error) {
                        console.warn(error)
                    }

                    state.request = null;
                    instance.store.set({ loading: false });
                    resolve(response.results);
                })
                .catch(function (error) {
                    if(controller.signal.aborted) {
                        return;
                    };
                    
                    instance.store.set({ loading: false });
                    instance.logger.error("Cannot succeed feature loading request. ERROR: ", error);
                    blinkmsg(`Ошибка загрузки объектов слоя (ID ${layerid})`, 5000, "danger");
                    reject();
                });
        });
    }

    this.subscribe = this.store.subscribe;

    /**
     * @returns {Array<import("geojson").Feature>}
     */
    this.features = () => {
        const { features } = instance.store.get();
        return features;
    }

    /**
     * @param {string | number} key
     * @returns {Array<import("geojson").Feature>}
     */
    this.lookup = (key) => {
        const { lookup } = instance.store.get();
        return lookup?.[key];
    }

    this.eachlookup = (action) => {
        const { lookup } = instance.store.get();
        for (const key in lookup) {
            action(lookup[key], key);
        }
    }
}

