function MultiClusterLayers() {
    var local = this;
    this.module = 'layer-list-panel';
    this.initialized = true;
    this.Layer = null;
    this.params;
    
    /** @type {{get: () => { features: GeoJSON.FeatureCollection<GeoJSON.Point>[] }, set: (next: { features: GeoJSON.FeatureCollection<GeoJSON.Point>[] }) => void, subscribe: (listner: () => void) => void) }}}  */
    this.store = zustand.createStore(zustand.subscribeWithSelector(function () {
        return {
            features: [],
            cluster: [],
            selected: null,
            opacity: 1,
        }
    }));
    
    var { get, set, subscribe } = this.store;

    var redraw = true;

    function render(utils) {

        var container = utils.getContainer();
        var renderer = utils.getRenderer();

        function rerender() {
            var start = performance.now();

            var scale = utils.getScale();
            
            container.children.forEach(function (child) {
                child.scale.set(1 / Math.max(Math.min(8, scale), 2));
            });

            renderer.render(container);

            console.log("render", performance.now() - start, "мс");
        }

        var { cluster, opacity } = get();

        /**
         * @param {[number, number][]} part
         * @param {{ x: number; y: number }} offset
         * @param {number} collor
         */
        function create_sector(part, offset, collor) {
            /** @type {import("@pixi/graphics").Graphics} */
            var graphics = new PIXI.Graphics();
            graphics.beginFill(collor, opacity);

            for (let i = 0; i < part.length; i++) {
                var p = part[i];
                var { x, y } = utils.latLngToLayerPoint([p[1], p[0]]);
                i === 0 ? graphics.moveTo(x - offset.x, y - offset.y) : graphics.lineTo(x - offset.x, y - offset.y);
            }

            return graphics.endFill();
        }

        /**
         * @param {GeoJSON.Feature<GeoJSON.Point>} midpoint
         */
        function draw_devided_circle(midpoint) {
            /** @type {import("@pixi/display").Container} */
            var outer_container = new PIXI.Container();
            var center_container = new PIXI.Container();

            var p = midpoint.geometry.coordinates;
            var center_point = utils.latLngToLayerPoint([p[1], p[0]]);
            center_container.position.set(center_point.x, center_point.y);
            
            // var opened = false;
            var center;
            var leaves = [];
            var spreaded_leaves = [];

            function open() {
                outer_container.removeChildren();
                center_container.removeChildren();
                
                if(!spreaded_leaves.length) {
                    midpoint.properties.cluster.forEach(function (point) {
                        var leave_container = new PIXI.Container();

                        var p = point.geometry.coordinates;
                        var center_point = utils.latLngToLayerPoint([p[1], p[0]]);
                        leave_container.position.set(center_point.x, center_point.y);

                        var circle = turf.circle(point, 0.25, { steps: 24 });
                        leave_container.addChild(
                            create_sector(
                                circle.geometry.coordinates[0],
                                center_point,
                                point.properties.collor,
                            )
                        );

                        leave_container.interactive = true;
                        leave_container.cursor = 'pointer';
                        leave_container.click = function () {
                            var { selected } = get();
                            set({ selected: Object.assign(selected, { point }) });
                        }

                        spreaded_leaves.push(leave_container);
                    });
                }

                spreaded_leaves.forEach(function (leave) { outer_container.addChild(leave); });
                outer_container.addChild(center_container);

                // opened = true;
            }

            function close() {
                outer_container.removeChildren();
                center_container.removeChildren();
                
                if(!leaves.length) {
                    var collors = midpoint.properties.cluster.reduce(function (array, point) {
                        if(!array.includes(point.properties.collor)) {
                            array.push(point.properties.collor);
                        }
                        return array;
                    }, []);

                    var count = collors.length;
                    var steps = Math.max(count * 6, 24);
                    var vertices = steps / count;

                    var inner = turf.circle(midpoint, 0.75, { steps }).geometry.coordinates[0];
                    var outer = turf.circle(midpoint, 1, { steps }).geometry.coordinates[0];

                    center = create_sector(inner, center_point, 0xFFFFFF);
                    var text = new PIXI.Text(midpoint.properties.cluster.length, { fontSize: 12, fill: 0x000000 })
                    text.anchor.set(0.5, 0.5);
                    center.addChild(text);

                    for (let i = 0; i < count; i++) {
                        var offset = vertices * i;
                        var inner_part = inner.slice(offset, offset + vertices + 1);
                        var outer_part = outer.slice(offset, offset + vertices + 1).reverse();
                        
                        leaves.push(
                            create_sector(
                                [...inner_part, ...outer_part, inner_part[0]],
                                center_point,
                                collors[i],
                            )
                        );
                    }
                }

                leaves.forEach(function (leave) { center_container.addChild(leave); });
                center_container.addChild(center);
                outer_container.addChild(center_container);

                // opened = false;
            }

            center_container.interactive = true;
            center_container.cursor = 'pointer';
            center_container.click = function () {
                var { selected } = get();

                if(selected) {
                    if(!Object.is(midpoint, selected.point)) {
                        selected.close();
                        set({ selected: { point: midpoint, open, close }});
