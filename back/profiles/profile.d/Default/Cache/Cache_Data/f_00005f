function WidgetPanelBuilder() {
    const instance = this;

    const state = {};

    const elements = [];

    this.element = (element) => {
        elements.push(element);
        return instance;
    };

    this.text = (content, attributes = {}) => {
        elements.push(span(attributes, text(content)));
        return instance;
    };

    this.hr = (attributes = {}) => {
        elements.push(hr(attributes));
        return instance;
    };

    function territory_display_name(territory) {
        if (!territory) return "";

        switch (territory.Type) {
            case "Республик ":
            case "Городской округ":
                return territory.Type + " " + territory.Name;
            case "Страна":
            case "Город федерального значения":
            // TODO: fix spelling in database.
            case "Город федерального значени":
            case "Город республиканского значения":
                return territory.Name;
            default:
                return territory.Name + " " + territory.Type;
        }
    }

    this.territory = () => {
        if ("territory" in state) {
            elements.push(state["territory"]);
            return instance;
        }

        const element = span({ class: "territory" });

        element.innerText = territory_display_name(
            window.G.DynamicFlat.getValue(GiEvents.TerraInfo),
        );

        window.G.DynamicFlat.addListener(
            GiEvents.TerraInfo,
            function ({ value }) {
                element.innerText = territory_display_name(value);
            },
        );

        elements.push((state["territory"] = element));

        return instance;
    };

    function period_display([date_from, date_to]) {
        const from = new Date(date_from);
        const to = new Date(date_to);

        let month = "";
        let year = "";

        const month_from = from.getMonth();
        const month_to = to.getMonth();
        if (month_to - month_from === 0) {
            month = capitalizeFirstLetter(
                to.toLocaleString("ru-Ru", { month: "long" }),
            );
        }

        if (month_from === 0 && month_to === 2) {
            month = "1 Квартал";
        }

        if (month_from === 3 && month_to === 5) {
            month = "2 Квартал";
        }

        if (month_from === 6 && month_to === 8) {
            month = "3 Квартал";
        }

        if (month_from === 9 && month_to === 11) {
            month = "4 Квартал";
        }

        if (month_from === 0 && month_to === 5) {
            month = "1 Полугодие";
        }

        if (month_from === 0 && month_to === 5) {
            month = "1 Полугодие";
        }

        const year_from = from.getFullYear();
        const year_to = to.getFullYear();
        if (year_from === year_to) {
            year = year_to.toString() + "г";
        }

        return month + " " + year;
    }

    this.period = () => {
        if ("period" in state) {
            elements.push(state["period"]);
            return instance;
        }

        const element = span({ class: "period" });

        element.innerText = period_display(
            window.G.DynamicArray.getValue(GiEvents.TimelineAppliedDates),
        );

        window.G.DynamicArray.addListener(
            GiEvents.TimelineAppliedDates,
            ({ value }) => {
                element.innerText = period_display(value);
            },
        );

        elements.push((state["period"] = element));

        return instance;
    };

    this.reset = () => {
        elements.length = 0;
    };

    this.build = () => elements;
}

