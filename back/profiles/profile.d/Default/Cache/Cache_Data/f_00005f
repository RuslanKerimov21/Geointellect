                data.append("object_uid", localThis.feature.properties.uniqueid);
                data.append("layer_uid", localThis.feature.layer.uid);
                data.append("fileinfo", JSON.stringify(localThis.uploadinfo));

                var response = DoWebApiActionAjax("/attachments/uploadfile", data);

                response.done(function (r) {
                    if (r.status === "error") {
