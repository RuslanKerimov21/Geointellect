        if (!window.journal) {
            window.journal = {};
        }

        if (!window.journal[moduleName]) {
            window.journal[moduleName] = [];
        }

        this.journal = window.journal[moduleName];

        this.info = function(message) {
            console.log(`[${moduleName}]\n${message}`);

            instance.journal.push(`${Date.now()}; ${moduleName}; INFO; ${message}`);
        }

        this.log = this.info;

        this.warn = function(message) {
            console.warn(`[${moduleName}]\n${message}`);

            instance.journal.push(`${Date.now()}; ${moduleName}; WARN; ${message}`);
        }

        this.error = function(message) {
            console.error(`[${moduleName}]\n${message}`);

            instance.journal.push(`${Date.now()}; ${moduleName}; ERROR; ${message}`);
        }

        this.debug = function(message) {
            if (localStorage.getItem("logger-debug") != "enabled") return;

            console.log(`%c[${moduleName}]\n${message}`, "color: orange;");

            instance.journal.push(`${Date.now()}; ${moduleName}; DEBUG; ${message}`);
        }

