        if (localThis.isopen) return;

        createDialogBodyNew(options);

        localThis.dialog.css({ opacity: 0.0 });

        container.find("[data-type=lyr-edit-object]").remove();
        container.append(localThis.dialog);
        localThis.isopen = true;
        localThis.dialog.transit({ opacity: 1.0, "margin-top": "0px", duration: 200, easing: "snap" },
            function () {
                
            });
    };

    /*закрыть окно с кноструктором*/
    this.close = function () {
        if (!localThis.initialized) return;
        localThis.isopen = false;
        localThis.dialog.transit({ opacity: 0.0, "margin-top": "300px", duration: 200, easing: "snap" },
            function () {
                localThis.dialog.remove();
            });
