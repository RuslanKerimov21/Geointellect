        //             }
        //         });
        //     }
        // });

        // instance.renderer.add(features);

        // window.ClusterPopup?.setWidgetContent({
        //     year: 2025,
        //     month: 9,
        //     current: {
        //         eventsCount: features.reduce((acc, val) => acc += val.properties?.dataset?.length ?? 0, 0),
        //     },
        //     prev: {
        //         eventsCount: 0
        //     }
        // });

        const features = instance.fetcher.features();

        instance.renderer.add(features);
    }

    function init() {
        if (!layerPanel?.layersWindow) return;
        let layersContainer = layerPanel.layersWindow[0].querySelector(
            ".layer-list .scroll-container",
        );

        elementLayer = new LayerElementContollers(
            opts,
            layersContainer,
            instance,
            template,
        );
        parts = elementLayer.getParts();

        opts.initialized = true;

        loadModuleParams().then((params) => {
            instance.params = params;

            if (!params) return;

            instance.fetcher.subscribe(update_render_features);
            instance.fetcher.subscribe((state) => {
                instance.elementLayer.markAsFiltered(state.cql !== "");
            });
            instance.fetcher.store.subscribe(
                (state) => state.loading,
                applyWaiter,
            );

            if (instance.enabled) {
                instance.fetcher.fetch();
            }
        });

        instance.fetcher.store.subscribe((state) => state.loading, applyWaiter);

        /* sync opacity */
        layerPanel.globalStore.subscribe(
            (state) => state.options[_options.id]?.options.opacity,
            (opacity) => instance.renderer.store.set({ opacity }),
        );

        if (opts.timelineYears.length > 0) {
            window.G.DynamicArray.addUniqueItems(
                GiEvents.TimelineYears,
                instance.timelineYears ?? [],
            );
        }

        createMapObject();
    }

    function showInfo() {
        var a = DoWebApiAction("/layers/metadoc", { layerid: opts.id });
        a.done(function (r) {
            if (r.success) {
                layerPanel.showLayerInfo(r.results, opts.name);
            }
        });
    }

    function showFilter() {
        if (instance.dataset_layer) {
            var filter = new LayerFilterSelect(
                instance.dataset_layer,
                layerPanel.layersWindow[0],
            );
            filter.init();
        } else {
            var filter = new LayerFilterSelect(
                instance,
                layerPanel.layersWindow[0],
            );
            filter.init();
        }
    }

    this.applyFilter = function (filters) {
        if (filters) {
            layerPanel.globalStore.get().setOptions(instance.id, {
                filter: filters.map((filter) => ({
                    Alias: filter.Alias ?? filter.alias,
                    Condition: filter.Condition ?? filter.condition,
                    FieldName: filter.FieldName ?? filter.field_name,
                    Next: filter.Next ?? filter.next,
                    Value: filter.Value ?? filter.value,
                })),
            });
        }
    };

    function loadModuleParams() {
        return new Promise((resolve, reject) => {
            getModuleParams("layer-list-panel", "marker-layers_settings").done(
                (r) => {
                    if (!r.success || r.results == null) {
                        blinkmsg(
                            "Не указаны параметры для marker-layers_settings",
                            10000,
                            "danger",
                        );
                        console.log(r);
                        reject();

                        return;
                    }

                    try {
                        const params = JSON.parse(r.results.param_value);

                        if (!params[instance.opts.id]) {
                            throw new Error(
                                `В параметрах marker-layers_settings не указаны настройки для слоя ${instance.opts.id}`,
                            );
                        }

                        instance.params = params[instance.opts.id];

                        resolve(instance.params);
                    } catch (error) {
                        blinkmsg(error.message, 10000, "danger");
                        console.log(error);
                        reject();
                    }
                },
            );
        });
    }

    init();

    this.id = opts.id;

    this.name = opts.name;
    this.type = opts.type;
    this.url = opts.url;
    this.hasTimeline = opts.timeline > 0;
    this.hasCityId = opts.hasCityId;
    this.timelineYears = opts.timelineYears;
    this.tag = opts.tag;
    this.opacity = opts.opacity;
    this.opts = opts;
    this.o = options;
    this.initialized = opts.initialized;
    this.isactive = opts.isactive;
    this.visible = opts.visible;
    this.zIndex = opts.zIndex;
    this.schema = opts.schema;
    this.legend = opts.legend;
    this.legendLoaded = opts.legendLoaded;
    this.isFavorite = opts.isFavorite;

    this.elementLayer = elementLayer;
    this.template = template;

    this.addButton = elementLayer.addButton;

    this.selfelement = parts.self;
    this.mapLayerObject = mapLayerObject;
    this.layerList = layerPanel;

    this.createMapObject = createMapObject;
    this.destroyMapObject = destroyMapObject;

    this.getMapObject = getMapObject;

    this.checkAttribute = checkAttribute;
    this.checkLayerHasTerra = checkLayerHasTerra;
    this.sendOneObjectToServer = sendOneObjectToServer;
    this.init = init;
    this.refresh = refresh;
    this.getHtmlElement = getHtmlElement;
    this.on = on;
    this.off = off;
    this.showFilter = showFilter;
    this.showInfo = showInfo;
    this.makeFavorite = elementLayer.makeFavorite;
    this.unmakeFavorite = elementLayer.unmakeFavorite;
    this.setOpacityFx = elementLayer.setOpacityFx;
    this.hide = elementLayer.hide;
    this.show = elementLayer.show;
    this.markAsFiltered = elementLayer.markAsFiltered;
}

class MarkerLayerPopup {
    popup = L.popup({
        closeOnClick: false,
        autoClose: false,
        autoPan: false,
        className: "incidents-popup",
    });
    feature;
    palette;
    data;

    /** @type {() => {}} */
    onOpen;

    /** @type {() => {}} */
    onClose;

    disabled = false;

    templatesUrls = {
        title: "/resources/funcparts/layer-list-panel/_import/MarkerLayer/templates/title.html",
        list: "/resources/funcparts/layer-list-panel/_import/MarkerLayer/templates/incidents-list.html",
        listRow:
            "/resources/funcparts/layer-list-panel/_import/MarkerLayer/templates/incidents-list-row.html",
        table: "/resources/funcparts/layer-list-panel/_import/MarkerLayer/templates/incidents-table.html",
        row: "/resources/funcparts/layer-list-panel/_import/MarkerLayer/templates/incidents-table-row.html",
        info: "/resources/funcparts/layer-list-panel/_import/MarkerLayer/templates/incident-info.html",
    };
    templates = {};

    /**
     * @param {{
     *   feature: {any},
     *   palette: {[name: string]: number}
     *   data: {Array<{ name: string, value: number }>}
     *   onOpen: {() => {}},
     *   onClose: {() => {}},
     *   type: {"full" | "preview"}
     * }} param0
     */
    constructor({ feature, palette, data, onOpen, onClose }) {
        this.feature = feature;
        this.palette = palette;
        this.data = data;
        this.popup.setLatLng(
            L.latLng(
                feature.geometry.coordinates[1],
                feature.geometry.coordinates[0],
            ),
        );
        this.onOpen = onOpen;
        this.onClose = onClose;

        this.#loadStyles();

        this.popup.on("remove", () => this.onClose?.());
        // this.popup.setContent("Загрузка...");
        // this.#getTemplates().then(() => this.#render());
    }

    #loadStyles() {
        appendHeadStyle(
            "/resources/funcparts/layer-list-panel/_import/MarkerLayer/style.css",
        );
    }

    async #getTemplates() {
        for (const [name, url] of Object.entries(this.templatesUrls)) {
            if (this.templates[name]) continue;

            this.templates[name] = await $.get(url);
        }
    }

    #hydrate(template, dictionary) {
        for (const [key, value] of Object.entries(dictionary)) {
            template = template.replaceAll(`{{${key}}}`, value);
        }

        return template;
    }

    #renderClusterView() {
        const title = this.#hydrate(this.templates.title, {
            incidents_count: this.feature.properties.features.length,
        });
        const listRows = this.feature.properties.features
            .map((incidentFeature) =>
                this.#hydrate(this.templates.listRow, {
                    name: incidentFeature.properties.event_name || "Без имени",
                    date: incidentFeature.properties.create_date_utc,
                    id: incidentFeature.properties.dval_requisite_id,
                    color: `#${(
                        this.palette[
                            incidentFeature.properties.form_short_name
                        ] ?? 0xff0000
                    ).toString(16)}`,
                }),
            )
            .join("");
        const list = this.#hydrate(this.templates.list, {
            incidents: listRows,
        });
        const rows = this.data
            .map((data) =>
                this.#hydrate(this.templates.row, {
                    category: data.name,
                    count: data.value,
                    prev_year_period: "0%",
                    color: `#${(this.palette[data.name] ?? 0xff0000).toString(
                        16,
                    )}`,
                }),
            )
            .join("");
        const table = this.#hydrate(this.templates.table, {
            rows,
        });

        const listElement = document.createElement("div");
        listElement.innerHTML = list;
        listElement.addEventListener("click", (e) => {
            const incidentElement = e.target.closest(".incident");

            if (!incidentElement) return;

            const id = incidentElement.dataset["id"];
            const feature = this.feature.properties.features.find(
                (v) => v.properties.dval_requisite_id == id,
            );

            this.#renderSingleView(feature);
        });

        const titleElement = document.createElement("div");
        titleElement.innerHTML = title;

        const tableElement = document.createElement("div");
        tableElement.innerHTML = table;

        const buttonElement = document.createElement("button");

        buttonElement.innerText = "URL";
        buttonElement.addEventListener("click", () => alert("open url"));

        const wrapperElement = document.createElement("div");

        wrapperElement.className = "incidents-popup-wrapper";
        wrapperElement.appendChild(titleElement);
        wrapperElement.appendChild(tableElement);
        wrapperElement.appendChild(listElement);
        wrapperElement.appendChild(buttonElement);

        // const content = `
        //     <div class="incidents-popup-wrapper">
        //         ${title}
        //         ${table}
        //         ${listElement}
        //     </div>
        // `;
        const content = wrapperElement;

        this.popup.setContent(content);
    }

    #renderSingleView(feature) {
        // this.popup.setContent(JSON.stringify(feature, null, 2));

        const container = document.createElement("div");

        container.classList.add("incident-single-view");

        for (const [key, value] of Object.entries(feature.properties)) {
            container.innerHTML += `
                <div>${key}</div><div>${value}</div>
            `;
        }

        this.popup.setContent(container);
    }

    #renderHoverView() {
        const title = this.#hydrate(this.templates.title, {
            incidents_count: this.feature.properties.features.length,
        });

        const rows = this.data
            .map((data) =>
                this.#hydrate(this.templates.row, {
                    category: data.name,
                    count: data.value,
                    prev_year_period: "0%",
                    color: `#${(this.palette[data.name] ?? 0xff0000).toString(
                        16,
                    )}`,
                }),
            )
            .join("");
        const table = this.#hydrate(this.templates.table, {
            rows,
        });

        const content = `
            <div class="incidents-popup-wrapper">
                ${title}
                ${table}
            </div>
        `;

        this.popup.setContent(content);
    }

    #renderWidgetsView(config) {
        const content = [];

        for (const widget of config) {
            if (widget.type === "text") {
                let text = "";

                switch (true) {
                    case "content" in widget:
                        text = widget.content;
                        break;
                    case "property" in widget:
                        text = this.feature.properties[widget.property];
                        break;
                    default:
                        break;
                }

                content.push(span({ text }));
                continue;
            }

            if (widget.type === "table") {
                const table = div({
                    style: {

                    }
                });
                
                for (const cell of config.header) {
                    table.appendChild(span({ text: cell }))
                }

                content.push(table);
                continue;
            }

            if (widget.type === "list") {
                const list = new Set();

                this.feature.properties.features.forEach((feature) => {
                    const item = feature.properties[widget.property];
                    if (item) {
                        list.add(item);
                    }
                });

                content.push(
                    div(
                        {},
                        Array.from(list).map((item) => div({ text: item })),
                    ),
                );

                continue;
            }

            if (widget.type === "link") {
                content.push(
                    div(
                        {},
                        a({
                            text: widget.text,
                            href: widget.href,
                        }),
                    ),
                );
                continue;
            }
        }

        this.popup.setContent(
            div({ class: "incidents-popup-wrapper" }, content),
        );
    }

    #render(mode, config) {
        // if (this.type == "hover") {
        //     this.#renderHoverView();

        //     return;
        // }

        if (mode === "widgets") {
            this.#renderWidgetsView(config);
            return;
        }

        if (mode == "preview") {
            this.#renderHoverView();

            return;
        }

        if (this.feature.properties.features.length > 0) {
            this.#renderClusterView();

            return;
        }

        this.#renderSingleView();
    }

    show(mode, config) {
        if (this.disabled) return;

        this.#getTemplates().then(() => {
            this.#render(mode, config);
            this.popup.openOn(window.MAP);
            this.onOpen?.();
        });
    }

    hide() {
        window.MAP.removeLayer(this.popup);
        this.onClose?.();
    }

    disable() {
        this.disabled = true;
    }

    enable() {
        this.disabled = false;
    }
}

function TerrritoryClusteringLayer(_options, layerPanel) {
    const instance = this;

    this.initialized = false;
    this.loaded = false;

    const options = new LayerOptions(_options);
    this.fetcher = new LayerDataFetcher(_options.id, layerPanel.globalStore);
    this.renderer = new PixiLayerMarkerRenderer();
    this.widget = new WidgetPanel();

    const template = `
    <div class="layer-item" data-id="{{lid}}" data-index="" data-url="{{lurl}}" data-type="{{ltype}}" data-isactive="{{lactive}}"   data-expanded="{{lexpanded}}" data-visible="false">
        <div class="top-panel">
            <div class="checkbox" data-action="checked_selected"></div>
            <div class="filter-container"  title="{{layer_filter_applied}}" style="background-repeat:no-repeat;background-position:center"></div>
            <div class="caption" title="{{lname}}">{{lname}}</div>
            <div class="arrow gr-down-l" data-action="to_expand"></div>
        </div>
        <div class="waiter" data-visible="false" oncontextmenu="false">
            <div class="progress"></div>
        </div>
    </div>`;

    this.id = options.id;

    /*Нам надо положить опшины в глоб. стейт */
    let getStore = layerPanel.globalStore.getState();
    getStore.addOptions({
        id: options.id,
        options: { ...options },
    });

    this.opts = getStore.getOptions(_options.id).options;

    this.getOptions = function () {
        return getStore.getOptions(_options.id).options;
    };

    layerPanel.globalStore.subscribe(
        function (state) {
            return state.getOptions(_options.id).options.isactive;
        },
        function (isActive) {
            if (typeof isActive === "undefined") return;
            isActive ? instance.on() : instance.off();
        },
    );

    this.store = zustand.createStore(
        zustand.subscribeWithSelector(() => ({
            grouping: {
                property: null,
                geometry: null,
            },
            cluster: {
                distance: 100,
                points: 20,                
            },
        })),
    );

    function setGrouping(level) {
        if (typeof level === "undefined") return;
        if (!instance.params) return;
        instance.store.set({ grouping: instance.params.grouping[level] });
    }

    /* used by search box in layer panel */
    this.name = this.opts.name;
    this.tag = this.opts.tag;

    /* used for extracting tag */
    this.type = this.opts.type;

    this.schema = _options.schema;
    this.hasTimeline = _options.timeline > 0;
    this.timelineYears = _options.timelineYears;

    /* have to do this. called ty filter panel. */
    this.applyFilter = function (filters) {
        if (filters) {
            layerPanel.globalStore.get().setOptions(instance.id, {
                filter: filters.map((filter) => ({
                    Alias: filter.Alias ?? filter.alias,
                    Condition: filter.Condition ?? filter.condition,
                    FieldName: filter.FieldName ?? filter.field_name,
                    Next: filter.Next ?? filter.next,
                    Value: filter.Value ?? filter.value,
                })),
            });
        }
    };

    // do nothing (заглушка для favorits)
    this.hide = function () {};

    /* have to do this. called ty initLayerSettings. */
    this.setOpacityFx = function () {};

    /* have to do this. called by LayerListPanel.collapseAll */
    this.collapse = function () {};

    this.on = function () {
        instance.enabled = true;

        if (!instance.loaded) return;

        instance.fetcher.fetch().then(() => {
            instance.widget.show();
            layerPanel.selectionChanged();
        });
    };

    this.off = function () {
        instance.enabled = false;
        instance.renderer.features([]);
        instance.widget.hide();
        layerPanel.selectionChanged();
    };

    this.refresh = function () {
        instance.fetcher.fetch();
    };

    // register territories for a layer
    layerPanel.layerCityStorage.addLayerCities(
        instance.opts.id,
        _options?.listTerra ?? [],
    );

    // called when GiEvents.TerraId changed
    this.checkLayerHasTerra = (terra_id) => {
        return layerPanel.layerCityStorage.layerHasCity(
            instance.opts.id,
            terra_id,
        );
    };

    this.showFilter = () => {
        new LayerFilter(instance, layerPanel.layersWindow[0]).init();
    };

    function init() {        
        appendHeadStyle("/resources/funcparts/layer-list-panel/styles/WidgetPanel.css");

        if (!layerPanel?.layersWindow) return;

        let layersContainer = layerPanel.layersWindow[0].querySelector(
            ".layer-list .scroll-container",
        );

        elementLayer = new LayerElementContollers(
            instance.opts,
            layersContainer,
            instance,
            template,
        );

        parts = elementLayer.getParts();

        instance.initialized = true;
        instance.opts.initialized = true;

        if (instance.timelineYears.length > 0) {
            window.G.DynamicArray.addUniqueItems(
                GiEvents.TimelineYears,
                instance.timelineYears ?? [],
            );
        }

        // sync filter with global state
        window.G.Dynamic.addListener(
            `G_layer_filter_${instance.id}`,
            ({ value }) => instance.applyFilter(JSON.parse(value)),
        );

        // show/hide filter icon on layer control
        instance.fetcher.settings.subscribe((state) => {
            elementLayer.markAsFiltered(state.cql !== "");
        });

        loadModuleParams().then((params) => {
            instance.params = params;

            setGrouping(window?.ClusteringSwitch.store.get().level);
            window?.ClusteringSwitch.store.subscribe(
                (state) => state.level,
                setGrouping,
            );

            if (params.style) {
                instance.renderer.style(params.style);
            }
            
            if (params.cluster) {
                instance.store.set({ cluster: params.cluster });
            }
            
            instance.loaded = true;

            if (instance.enabled) {
                instance.on();
            }
        });

        instance.store.subscribe(
            (state) => state.grouping,
            ({ property, geometry }) => {
                if ((property === null) | (geometry === null)) return;                
                instance.fetcher.settings.set({
                    data: { ascentroid: true, group: property, geom_column: geometry },
                });
            },
        );

        instance.store.subscribe(
            (state) => state.cluster,
            (cluster) => {
                if (cluster === null) return;
                instance.renderer.store.set({
                    cluster: {
                        distance: cluster.distance,
                        points: cluster.points,
                        noise: false,
                    },
                });
            },
        );

        instance.fetcher.subscribe(({ features }) => {
            if (!features) return;

            instance.renderer.features(features);

            const count = features.reduce((sum, feature) => sum + feature.properties.count, 0);

            instance.widget.content((x) => x
                .territory()
                .element(
                    div(
                        { class: "stats" },
                        span({ text: count, class: "count" }),
                        div({ text: "0.00%", class: "percentage" }),
                    ),
                )
                .period()
                .hr({ class: "delimiter" })
                .element(
                    div(
                        { class: "prev-year-period" },
                        span({ text: "АППГ: ", class: "name" }),
                        span({ text: count, class: "value" }),
                    ),
                ),
            );
        });

        /* sync opacity */
        layerPanel.globalStore.subscribe(
            (state) => state.options[_options.id]?.options.opacity,
            (opacity) => instance.renderer.store.set({ opacity }),
        );
    }

    function loadModuleParams() {
        return new Promise((resolve, reject) => {
            getModuleParams(
                "layer-list-panel",
                "territory-cluster_settings",
            ).done((r) => {
                if (!r.success || r.results == null) {
                    blinkmsg(
                        "Не указаны параметры для territory-cluster_settings",
                        10000,
                        "danger",
                    );
                    console.log(r);
                    reject();
                    return;
                }

                try {
                    const params = JSON.parse(r.results.param_value);

                    if (!params[instance.opts.id]) {
                        throw new Error(
                            `В параметрах territory-cluster_settings не указаны настройки для слоя ${instance.opts.id}`,
                        );
                    }

                    instance.params = params[instance.opts.id];

                    resolve(instance.params);
                } catch (error) {
                    blinkmsg(error.message, 10000, "danger");
                    console.log(error);
                    reject();
                }
            });
        });
    }

    init();
}

