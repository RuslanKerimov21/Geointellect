    }

    /**
     * Создаёт функцию для рисования сектора диаграммы. Необходимо
     * для создания замыкания на переменной угла.
     * 
     * @param {number} startingAngle начальный угол
     * @returns {(
     *   item: {
    *      label: string,
    *      value: number,
    *      color: number
    *    },
     *   total: number,
     *   centerX: number,
     *   centerY: number,
     *   r: number,
     *   rInner: number,
     *   opacity: number
     * ) => PIXI.Container} функция для рисования сектора диаграммы
     */
    function createDrawSector(startingAngle) {
        let currentAngle = startingAngle;

        return (item, total, layerX, layerY, centerX, centerY, r, rInner, opacity) => {
            const graphics = new PIXI.Graphics();
            const sectorContainer = new PIXI.Container();
            const angle = (item.value / total) * Math.PI * 2;
            const startAngle = currentAngle;
            const endAngle = currentAngle + angle;
            
            const sectorMidAngle = (startAngle + endAngle) / 2;
            const sectorMidX = centerX + r * Math.cos(sectorMidAngle);
            const sectorMidY = centerY + r * Math.sin(sectorMidAngle);
            const layerMidX = sectorMidX + layerX;
            const layerMidY = sectorMidY + layerY;

            graphics
                .lineStyle(1, 0xFFFFFF)
                .beginFill(item.color, opacity)
                .arc(centerX, centerY, r, startAngle, endAngle)
                .arc(centerX, centerY, rInner, endAngle, startAngle, true)
                .closePath()
                .endFill();

            currentAngle += angle;
            sectorContainer.interactive = "true";

            sectorContainer.on("pointerover", () => {
                local.hoveredSectorData = `${item.label} | ${(+item.value.toFixed(2)).toString()} | ${Math.round((item.value / total) * 100)}%`;
            });

            sectorContainer.on("pointerout", () => {
                local.hoveredSectorData = null;
            });

            sectorContainer.addChild(graphics);
            
            return sectorContainer;
        }
    }

