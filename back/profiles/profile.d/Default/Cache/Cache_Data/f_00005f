            <div class="arrow gr-down-l" data-action="to_expand"></div>
        </div>
    </div>`;
    const store = zustand.createStore(zustand.subscribeWithSelector(function (set,get) {

        return {
            cql: ""
        }
    }));
    let layerList = parent;
    var localThis = this;
    var mapLayerObject = null;
    let elementLayer = null;
    let options = new LayerOptions(_options);
    let getStore = layerList.globalStore.getState();

   
    /*Нам надо положить опшины в глоб. стейт */
    getStore.addOptions({
        id: options.id,
        options: { ...options }
    });

    let opts = getStore.getOptions(_options.id).options;

    const subscribeIsActive = layerList.globalStore.subscribe(
        function (state) {
            // console.log(state, _options.id)
            return state.getOptions(_options.id).options.isactive;
        },
        function (isActive) {
            if (isActive !== undefined) {
               /* console.log("isactiveMAP изменился:", isActive);*/
                isActive ? on() : off();
            }
        }
    );

    layerList.layerCityStorage.addLayerCities(opts.id, _options?.listTerra ?? []);

    let parts = {
        self: null,
        top: null,
        tools: null,        
        legend: null,
    };

   
    this.filter = [];
    this.rules = [];
    this.timelineYears = opts.timelineYears;
    this.getOptions = function () {
        return opts;
    };

    

    function createMapObject() {
        let index;
        if (elementLayer?.getIndexLayer() == "")
        {
            index = opts.Zindex;
        }
        else {
            index = elementLayer?.getIndexLayer();
        }

        let zIndex = index; 

        if (false) {
            if (opts.type.indexOf("polygon") != -1) {
                if (opts.type.indexOf("vector") == -1) {
                    zIndex += 10000;
                }
                else {
                    zIndex += 15000;
                }
            }
            else if (opts.type.indexOf("line") != -1) {
                if (opts.type.indexOf("vector") == -1) {
                    zIndex += 20000;
                }
                else {
                    zIndex += 25000;
                }
            }
            else if (opts.type.indexOf("point") != -1) {
                if (opts.type.indexOf("vector") == -1) {
                    zIndex += 30000;
                }
                else {
                    zIndex += 35000;
                }
            }
            else {
                zIndex += 40000;
            }
        };

        let layer_options = {
            pane: "geoLayers",
            layers: "Geointellect",
            attribution: "",
            format: "image/png",
            transparent: true,
            version: "1.1.1",
            opacity: 1,
            maxZoom: 22,
            zIndex: zIndex,
            subdomains: opts.hsts.subdomains
        };
        mapLayerObject = L.tileLayer.wms(opts.source_url, layer_options);
        mapLayerObject.setOpacity(opts.opacity);
        mapLayerObject.options.opacity = opts.opacity;
        refresh();
    };

    function destroyMapObject() {
        mapLayerObject = null;
    };

    function on() {
        createMapObject();
        mapLayerObject.addTo(window.MAP);
        applyFilter();
        layerList.selectionChanged();
        window.MAP.invalidateSize();
        layerList.saveSelectedLayers();
    };

    function off() {
        window.MAP?.removeLayer(mapLayerObject);
        layerList.selectionChanged();
        window.MAP.invalidateSize();
        layerList.saveSelectedLayers();
        destroyMapObject();
        /*
        TODO: надо прятат конкретно этот слой, а не перерендривать весь список
        layerList.applyLayerListFilter();
        */
    };

    function getMapObject() {
        return mapLayerObject;
    };

    function GetLegendCql() {
        if (!getStore.getOptions(_options.id).options.rules || getStore.getOptions(_options.id).options.rules.length <= 1) return "";
        var cql = "";
        var anyChecked = false;
        var checked_count = 0;

        for (var i = 0; i < getStore.getOptions(_options.id).options.rules.length; i++) {
            if (getStore.getOptions(_options.id).options.rules[i].is_checked) {
                anyChecked = true;
                checked_count++;
                if (cql.length > 0) cql += " OR ";
                cql += getStore.getOptions(_options.id).options.rules[i].filter;
            }
        }

        if (checked_count == getStore.getOptions(_options.id).options.rules.length) {
            return "";
        }

        if (!anyChecked) {
            return "id < 0"; 
        }

        return cql;
    };

    function GetFormCql() {
        return filter2Cql(opts.filter);
    };

    function GetCombinedCql() {
        var formCql = GetFormCql();
        var legendCql = GetLegendCql();
        var cql;

        if (legendCql === "" && formCql === "")
        {
            cql = "";
        }
        else if (legendCql === "")
        {
            cql = formCql;
        }
        else if (formCql === "")
        {
           
            cql = legendCql;
        }
        else
        {
            cql = "(" + formCql + ") AND (" + legendCql + ")";
        }

        if (store.getState(cql)?.cql === cql) {
            mapLayerObject.wmsParams.CQL_FILTER = cql;
        }

        store.set({ cql });
       
    };
    
    store.subscribe(
       
        function (state) {  
            return state.cql;
        },
        function (cql) {
            if (cql === "") {
                elementLayer.markAsFiltered(false);
                delete mapLayerObject.wmsParams.CQL_FILTER;
               
            } else {
                DoWebApiAction("/record-reference", { content: cql })
                    .done(function (r) {
                    if (r.success) {
                        if (r.results) {
                            mapLayerObject.wmsParams.CQL_FILTER = r.results;
                            elementLayer.markAsFiltered(true);
                        }
                    } else {
                        mapLayerObject.wmsParams.CQL_FILTER = cql;
                        elementLayer.markAsFiltered(true);
                    } 
                   
                        mapLayerObject.setParams(mapLayerObject.wmsParams);
                       
                });
            }
            
        }
    );

    function refresh() {
        var _date1 = Cookies.get("date_from");
        var _date2 = Cookies.get("date_to");
        var _dirty = _date1 + "_" + _date2;

        opts.wmsParams = {
            ...mapLayerObject?.wmsParams,
            is_public: (window._is_public ?? false) ? "true" : "false",
            public_credentials: window._public_credentials,
