        var year = Cookies.get("current_year") ?? (new Date()).getFullYear();
        var where = localThis.hasTimeline ? `int year = ${year}` : undefined;
        const { cql } = store.get();

        console.log("cql in the moment of fething features", cql)

        if (localThis.getObjectsRequest) {
            localThis.getObjectsRequest?.abort?.();
            console.log("previous get objects request was aborted INTENTIONALLY to avoid race condition");
        }
        
        if (cql == "") {
            if (mapLayerObject) {
                delete mapLayerObject.wmsParams.CQL_FILTER;
                elementLayer.markAsFiltered(false);
            }

            return new Promise((resolve, reject) => {
                localThis.getObjectsRequest = DoWebApiAction('/glayer/objects', { layerid: options.id, where, ascentroid: true });
                    
                localThis.getObjectsRequest.done(function (r) {
                    localThis.logger.info("Features request completed (2/3)")

                    if (r.success && r.results) {
                        localThis.logger.info("Features loaded (3/3)")
                        
                        resolve(r);
                        
                        return
