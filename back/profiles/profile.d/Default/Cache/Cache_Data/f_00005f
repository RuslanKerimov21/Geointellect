                $(this).parent().children("[data-field=filename]").html(fileName);

                if (localThis.checkFile($(this))) {
                    localThis.file = $(this)[0].files[0];

                    localThis.uploadinfo = {
                        Uid: "",
                        Name: fileName,
                        ClientId: -1,
                        Login: window.UserModule.userData.Info.Login,
                        Size: 0,
                        Format: "",
                        Mime: "",
                        LayerUid: localThis.feature.layer.uid,
                        /*ObjectId: localThis.feature.Id,*/
                        ObjectUid: localThis.feature.properties.uniqueid,
                        Url: ""
                    };

                } else {
                    localThis.cancel();
                }
            });
    };

    /*вызывается при включении/отключении галочек*/
    this.onSelectionChanged = function () {
        
        var selectedFiles = localThis.getSelectedFiles();
        $(".countFiles > span").html(selectedFiles.length);
        localThis.parts.controlsContainer.children("[data-ext]").each(function () {
            var formats = $(this).attr("data-ext").split(",");
            if (selectedFiles.length === 1 && (formats.indexOf(selectedFiles[0].Format) !== -1 || $(this).attr("data-ext") === "*")) {
                $(this).css({ display: "inline-block" });
            } else if (selectedFiles.length >= 1 && $(this).attr("data-ext") === "**") {
                $(this).css({ display: "inline-block" });
            } else {
                $(this).css({ display: "none" });
            }
            if (selectedFiles.length >= 1 && selectedFiles[0].Format === "url" && $(this).attr("data-role") === "downloadfile") {
                $(this).css({ display: "none" });
