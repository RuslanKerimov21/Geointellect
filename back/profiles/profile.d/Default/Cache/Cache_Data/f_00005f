        localThis.dialog.find("[data-role=newObjectAttributes]").transit({ opacity: 0.0, delay: 100, duration: 200, scale: 0.2, top: "-30px" });
        localThis.dialog.find("[data-role=waiter]").css({ display: "inline-block" });
