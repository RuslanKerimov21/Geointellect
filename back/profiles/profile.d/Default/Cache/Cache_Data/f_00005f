    /*создаём объект в формате geoJson*/
    this.createGeoJsonFeature = function () {
        var feature = {};
        feature.properties = attributes2Json();
        feature.type = "Feature";
        feature.geometry = {
            type: "Point",
            coordinates: transformPairCoordinatesTo3857(
                localThis.latlng.lng,
                localThis.latlng.lat
            )
        };
        feature.geometry = addCRSToGeoJSONGeometry3857(feature.geometry);
        return feature;
    };
    
    /*пытаемся отправить заявку модератору*/
    var trySend = function () {

        localThis.data = null;
        localThis.data = new FormData();
        if (localThis.file !== null) {
            localThis.data.append("thefile", localThis.file);
        }

        localThis.data.append("object_id", localThis.feature.Id);
        localThis.data.append("feature", JSON.stringify(localThis.createGeoJsonFeature()));
        localThis.data.append("fileinfo", JSON.stringify(localThis.fileinfo));

        var response = DoWebApiActionAjax("/ulayers/addeditrequest", localThis.data);

