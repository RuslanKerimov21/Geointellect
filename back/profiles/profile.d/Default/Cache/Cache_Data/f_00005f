    /*создаёт див со слоем и вставляет в окно слоёв*/
    var init = function () {
        if (localThis.layerList.layersWindow === null) {
            return;
        }

        buildHtml();

        /*клик по стрелочке для разворачивания слоя*/
        localThis.selfelement
            .children(".top-panel")
            .children(".arrow")
            .click(function () {
                if (localThis.expanded === true) {
                    localThis.collapse();
                } else {
                    localThis.expand();
                }
            });

        /*клик по чекбоксу (вкл/выкл слоя)*/
        localThis.selfelement
            .children(".top-panel")
            .children(".checkbox")
            .click(function () {
                if (localThis.isactive === true) {
                    localThis.off();
                } else {
                    localThis.on();
                }
            });

        localThis.selfelement
            .find(".tool-panel .opacity-item")
            .click(function () {
                /*клик по кругляшу с прозрачностью*/

                /*проверяем, если уже нажата эта кнопка, то выходим*/
                if ($(this).attr("data-active") === "1") return;

                var oldval = parseFloat(
                    localThis.selfelement
                        .find(".tool-panel .opacity-item[data-active=1]")
                        ?.attr("data-opacity")
                        ?.replace(",", "."),
                );
                var newval = parseFloat(
                    $(this).attr("data-opacity").replace(",", "."),
                );

                localThis.opacity = newval;

                localThis.setOpacityFx(newval, oldval);
            });

        localThis.layerList.layersWindow
            .children(".layer-list")
            .find("[data-type=user-layer-group]")
            .find(".group-layer-list")
            .append(localThis.selfelement);
        if (!localThis.initialized) localThis.initialized = true;
    };

    this.show = function () {
        /*делает строку со слоем видимой*/
        localThis.selfelement.attr({ "data-visible": "true" });
        localThis.visible = true;
    };

    this.hide = function () {
        /*делает строку со слоем невидимой*/
        localThis.selfelement.attr({ "data-visible": "false" });
        localThis.visible = false;
    };

    this.removeUserLayer = function (uid) {
        if (confirm("Удалить слой навсегда?")) {
            var svc = DoWebApiAction("/ulayers/delete_ulayer", {
                layer_uid: uid,
            });

            svc.done(function (r) {
                if (r.success && r.results === true) {
                    localThis.off();
                    localThis.collapse();
                    localThis.selfelement.remove();
                    window.ulaGroup.refreshGroupVisibility();
                } else {
                    alert(r.message);
                }
            });
        }
    };

    this.expand = function () {
        /*разворачивает свойства слоя*/
        if (localThis.expanded === false) {
            localThis.layerList.collapseAll();
            localThis.expanded = true;
            localThis.selfelement.attr("data-expanded", "true");
        }
    };

    /*сворачивает строку слоя*/
    this.collapse = function () {
        localThis.expanded = false;
        localThis.selfelement.attr("data-expanded", "false");
    };

    this.setOpacityFx = function (newval, oldval) {
        /*плавное, красивое изменение прозрачности слоя*/
        localThis.selfelement
            .find(".tool-panel .opacity-item")
            .attr("data-active", "0");
        localThis.selfelement
            .find('.tool-panel .opacity-item[data-opacity="' + newval + '"]')
            .attr("data-active", "1");
        if (!localThis.isactive) return;
        localThis.geoData.eachLayer(function (object) {
            object.setOpacity(localThis.opacity);
        });
    };

    /*загружает легенду с сервера, если ещё не загрузили*/
    this.loadLegend = function () {
        if (localThis.legendLoaded) return;
        localThis.legendLoaded = true;
        var q = getNextImagesHost() + "/icon/" + localThis.Legend.symbol;
        var icondiv = localThis.selfelement
            .children(".top-panel")
            .children(".icon-container[data-icon]");
        icondiv.attr("data-icon", localThis.Legend.symbol);
        icondiv.css({
            "background-image": "url(" + q + ")",
            "background-size": "24px",
        });

        var editicondiv = localThis.selfelement
            .children(".top-panel")
            .children(".icon-container[data-iseditable]");
        if (
            localThis.Editors.indexOf(
                window.UserModule.userData.Info.Login.toLowerCase(),
            ) !== -1
        ) {
            editicondiv
                .addClass("pencil-ico")
                .attr("title", "У Вас есть права на редактирование этого слоя");
        }
    };

    /*включить слой (галочка)*/
    this.on = function () {
        localThis.isactive = true;
        var a = DoWebApiAction("/ulayers/get_features", {
            layer_uid: localThis.Uid,
        });
        a.done(function (r) {
            if (r.success) {
                localThis.Legend.iconUrl =
                    getNextImagesHost() + "/icon/" + localThis.Legend.symbol;
                var data = r.results;
                var img = new Image();
                img.onload = function () {
                    localThis.Legend.iconSize = [this.width, this.height];
                    localThis.Legend.iconAnchor = [
                        this.width / 2,
                        this.height / 2,
                    ];
                    localThis.Legend.popupAnchor = [this.width / 2, 0];
                    localThis.renderUserLayer(data);
                };
                img.src = localThis.Legend.iconUrl;
            }
        });
        localThis.selfelement.attr("data-isactive", "true");
        localThis.layerList.selectionChanged();
        window.MAP.invalidateSize();
    };

    /*отключить слой (галочка)*/
    this.off = function () {
        localThis.isactive = false;
        tryRemoveGeometry(localThis.geoData);
        localThis.geoData = null;
        localThis.selfelement.attr("data-isactive", "false");
        localThis.layerList.selectionChanged();
        window.MAP.invalidateSize();
    };

    /*todo:меняет прозрачность слоя*/

    /*отображает слой на карте*/
    this.renderUserLayer = function (data) {
        localThis.geoData = L.geoJSON();
        localThis.geoData.addTo(window.MAP);
        L.setOptions(localThis.geoData, {
            pointToLayer: function (feature, latlng) {
                var marker = L.marker(latlng, {
                    icon: L.icon(localThis.Legend),
                    clickable: false,
                    opacity: localThis.opacity,
                    pane: "userLayers",
                    keyboard: false,
                });
                return marker;
            },
        });
        $.each(data, function (i, f) {
            localThis.addOneObjectToMap(f);
        });
    };

    /*добавляет один объект в слой в БД*/
    this.sendOneObjectToServer = function (feature) {
        var da = {
            layer_uid: localThis.Uid,
            feature: JSON.stringify(feature),
        };
        return DoWebApiAction("/ulayers/add_feature", da);
    };

    /*обновляет атрибуты одного объекта в слое в БД*/
    this.updateOneObjectOnServer = function (feature, id) {
        var da = {
            layer_uid: localThis.Uid,
            object_uid: id,
            feature: JSON.stringify(feature),
        };
        return DoWebApiAction("/ulayers/update_feature", da);
    };

    /*добавляет один объект в слой на карте*/
    this.addOneObjectToMap = function (feature) {
        if (localThis.geoData === null) return;
        localThis.geoData.addData(feature);
    };

    /*стирает один объект в слой с карты*/
    this.eraseOneObjectFromMap = function (id) {
        if (localThis.geoData === null) return;
        var lz = localThis.geoData._layers;
        $.each(lz, function (key, value) {
            try {
                if (lz[key].feature.properties.uniqueid === id) {
                    localThis.geoData.removeLayer(lz[key]);
                }
            } catch (e) {}
        });
    };

    /*удаляет один объект из слоя*/
    this.deleteOneObject = function (featureId) {
        return DoWebApiAction("/ulayers/delete_feature", {
            layer_uid: localThis.Uid,
            object_uid: featureId,
        });
    };

    init();
};

function UlaRightsInnerWindow(_parent, layer_info) {
    let steps = [UlaRightsInnerStep];
    let currentIndex = 0;
    let win = null;
    let stepData = {
        owner: layer_info.owner,
        userRights: {
            editors: layer_info.editors || [],
            viewers: layer_info.viewers || [],
        },
        uid: layer_info.uid,
    };

    const _me = UserModule?.userData?.login ?? "me_unknown";

    function initializeWizard() {
        win = new LeftWindow({
            target: _parent.layersWindow[0],
            title: gltxt("access_control"),
            readOnly: _me != layer_info.owner,
            subtitle: layer_info.name,
            icon: "gr-lock",
        });

        win.Show();

        loadStep(currentIndex);
    }

    function loadStep(index) {
        if (index < 0 || index >= steps.length) return;

        const stepFunction = steps[index];
        const stepContent = stepFunction(
            stepData,
            navigateStep,
            win,
            layer_info,
        );
    }

    function navigateStep(direction, data = {}) {
        stepData = { ...stepData, ...data };

        if (direction === "next") {
            if (currentIndex < steps.length - 1) {
                currentIndex++;
                loadStep(currentIndex);
            } else {
                completeWizard();
            }
        } else if (direction === "previous") {
            if (currentIndex > 0) {
                currentIndex--;
                loadStep(currentIndex);
            }
        }
    }

    function completeWizard() {
        win.Close();
    }

    initializeWizard();

    return {
        close: () => win?.Close(),
        getCurrentStep: () => currentIndex,
        getData: () => stepData,
    };
}

