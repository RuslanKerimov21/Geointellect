        parts.tools.querySelectorAll('.opacity-item').forEach(function (item) {
            if (item.getAttribute('data-opacity') == opacity) { item.setAttribute("data-active", "1"); }
            item.addEventListener('click', function (e) {
                if (e.target.dataset.active === '1') return;

                var newVal = parseFloat(this.getAttribute('data-opacity').replace(",", "."));
                moduleLayers.globalStore.get().updateOptions(opts.id, { opacity: newVal });
            });
        });



        // if (/* opts.isFavorite */ moduleLayers.get().getOptions(opts.id).options.isFavorite) {
        if (/* opts.isFavorite */ moduleLayers.globalStore.get().getOptions(opts.id).options.isFavorite) {
