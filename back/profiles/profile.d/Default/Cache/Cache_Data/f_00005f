            return sum + feature.cluster.reduce(function (sum, cluster) {
                return sum + cluster.properties.cluster.reduce(function (dates, c) {
                    if(ids.includes(c.properties.id)) {
                        if('event_finish_date' in c.properties) {
                            if(!dates.includes(c.properties.event_finish_date)) {
                                dates.push(c.properties.event_finish_date);
                            }
                        } else {
