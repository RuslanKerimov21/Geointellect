var LayerGroup = function (name, container, alwaysVisible, type) {
    /*компонент с группой слоёв*/
    var localThis = this;

    this.id = generateGUID();
    this.name = name || "NoName";
    this.alwaysVisible = (alwaysVisible == true);

    this.initialized = false;
    this.isactive = false;
    this.visible = true;
    this.expanded = false;

    this.layerListContainer = container;
    this.layerList = []; /*html элементы */
    this.idsLayers = []; /*ID-ки слоев */
    this.selfelement = null;
    this.toolpanel = null;
    this.type = type || "layer-group";
    const arrFolders = localThis.layerListContainer.folders;

    let _state = this.layerListContainer.globalStore.getState();

    let opts = {
        id: localThis.id,
        type: localThis.type,
        is_active: localThis.isactive,
        name: localThis.name,
        expanded: localThis.expanded
    };

    this.folder = {
        id: opts.id,
        is_checked: "unchecked", /*Checked Unchecked Indeterminate */
        layers: [],
        checkFolder: () => {
            let hasActive = false; /*Выбранные элементы */
            let hasInactive = false; /*Не выбранные элементы */

            for (const layer of this.folder.layers) {
                const options = _state.getOptions(layer).options;
                if (options.visible) {
                    if (options.isactive) {
                        hasActive = true;
                    }
                    else {
                        hasInactive = true;
                    }
                }
            }

            if (hasActive && hasInactive) {
                this.is_checked = "indeterminate";  /*есть и активные, и неактивные*/
            } else if (hasActive) {
                this.is_checked = "checked";        /*все активные*/
            } else {
                this.is_checked = "unchecked";     /* все неактивные или невидимые*/
            }

            if (this.is_checked === "indeterminate" || this.is_checked === "checked") {
                opts.is_active = true;
            } else {
                opts.is_active = false;
            }

            localThis.selfelement.setAttribute("data-isactive", this.is_checked);
        }
    };

    function buildHtml() {

        localThis.selfelement = HtmlElementFromText(localizeHtml(`
    <div class="layer-item-group" data-id="{{gid}}"  data-type="{{gtype}}" data-isactive="false" data-expanded="{{gexpanded}}" data-visible="false">
        <div class="top-panel">
          <div class="checkbox" data-action="checked_selectedGroup"></div>
          <div class="icon-folder gr-folder"></div>
            <div class="badge font-primary" title="{{layer_group_count}}">0</div>
            <div class="caption" title="{{gname}}">
                <span class="gr-name font-primary"> {{gname}}</span>
            </div>
            <div class="arrow gr-down-l" data-action="toggleExpand"></div>
        </div>
        <div class="group-layer-list"></div>
    </div>
`), [
            { key: "gid", value: opts.id },
            { key: "gactive", value: opts.url },
            { key: "gtype", value: opts.type },
            { key: "gname", value: opts.name },
            { key: "gexpanded", value: opts.expanded }
        ]);

        /*Мои слои, удалим чекбокс */
        if (localThis.alwaysVisible) {
            localThis.selfelement.querySelector(".checkbox").remove();
        }

        localThis.selfelement.addEventListener("click", (e) => {
            let _target = e.target.dataset.action;
            if (_target === "toggleExpand") {
                if (!opts.expanded) {
                    localThis.expand()
                } else {
                    localThis.collapse();
                }
            }

            if (_target === "checked_selectedGroup") {
                if (!opts.is_active) {
                    toggleGroup(true);
                } else {
                    toggleGroup(false);
                }
            }
        });
    };

    function toggleGroup(_activeState) {
        localThis.selfelement.setAttribute("data-isactive", _activeState);
        localThis.folder.layers.forEach(layerId => {
            const isActiveLayer = _state.getOptions(layerId).options.isactive;
            const isVisibleLayer = _state.getOptions(layerId).options.visible;

            /* Если состояние слоя не совпадает с желаемым*/
            if (isActiveLayer !== _activeState && isVisibleLayer === true) {
                _state.updateOptions(layerId, { isactive: _activeState });
            }

            opts.is_active = _activeState;

            /* Проверяем другие папки (кроме текущей)*/
            arrFolders.forEach(_folder => {
                if (_folder.id !== opts.id) {
                    _folder.checkFolder();
                }
            });
        });
    };

    function group_visibility() {
        let layersInGroup = localThis.selfelement.querySelectorAll(".layer-item");
        let count = 0;
        layersInGroup.forEach((_layer) => {
            let element = _layer;
            if (element.getAttribute('data-visible') === 'true') {
                count++;
            }
        });

        setLayersGroupCount(count);

        if (localThis.alwaysVisible) {
            localThis.show();
            return;
        }

        if (count === 0) {
            localThis.hide();
        } else {
            localThis.show();
        }

        localThis.folder.checkFolder();
    };

    function setLayersGroupCount(_count) {
        localThis.selfelement.querySelector(".badge").textContent = _count;
    };

    this.group_visibility = group_visibility;

    function init() {
        /*создаёт див с группой и вставляет в окно слоёв*/
        if (localThis.layerListContainer.layersWindow === null) return;

        buildHtml();
        localThis.layerListContainer.layersWindow[0].querySelector(".scroll-container").append(localThis.selfelement);

        if (!localThis.initialized) localThis.initialized = true;

        try {
            /* window.terrasPanel.loadCurentTerras();*/
            arrFolders.push(localThis.folder);

        } catch (e) {
            DoNothing();
        }

    };

    this.setGroupIDToLayer = function (_layer) {
        _layer.additionalOptions.groupID = opts.id;
    };

    this.show = function () {
        localThis.selfelement.setAttribute("data-visible", true);
    };

    this.hide = function () {
        localThis.selfelement.setAttribute("data-visible", false);
    };

    this._addLayer = function (_layer) {
        localThis.folder.layers = localThis.idsLayers;
        /*Положим слой в массив группы */
        localThis.layerList.push(_layer);
        localThis.selfelement.querySelector(".group-layer-list").append(_layer);
        localThis.group_visibility();
    }

    this.checkVisibleLayers = function () {
        localThis.layerList.forEach((_layer) => {
            let idLayer = _layer.getAttribute("data-id");
            let isVisible = _state.getOptions(parseInt(idLayer)).options.visible;
            _layer.setAttribute("data-visible", isVisible);
        });
    };

    this.getGroup = function () {
        return localThis.selfelement.querySelector(".group-layer-list");
    };


    this.expand = function () {
        if (opts.expanded === true) return;
        opts.expanded = true;
        localThis.selfelement.setAttribute("data-expanded", true);
    };

    this.collapse = function () {
        if (opts.expanded === false) return;
        opts.expanded = false;
        localThis.selfelement.setAttribute("data-expanded", false);
    };

    init();
};
