                            localThis.logger.info("Features request completed (2/3)")

                            if (objectsRequest.success && objectsRequest.results) {
                                localThis.logger.info("Features loaded (3/3)")
                                
                                resolve(objectsRequest);
                                 
                                return
                            }

                            localThis.logger.error("Features loading error");
                            blinkmsg(`Ошибка загрузки объектов слоя (ID ${options.id})`, 5000, "danger");
                            applyWaiter(false);
                        })
                        .fail(function (error) {
                            localThis.logger.error("Cannot succeed feature loading request")
                            console.error('API Error:', error);
                            reject(error);

                            blinkmsg(`Ошибка загрузки объектов слоя (ID ${options.id})`, 5000, "danger");
                            applyWaiter(false);
                        });
                    } else {
                        mapLayerObject.wmsParams.CQL_FILTER = cql;
                        elementLayer.markAsFiltered(true);
                    }
                
                    mapLayerObject.setParams(mapLayerObject.wmsParams);
                });
        })
