                name: localThis.Name,
                viewers: localThis.Viewers,
                editors: localThis.Editors,
                uid: localThis.Uid,
            });
        });

        localThis.selfelement.find(".tool-panel .action-buttons").append(btn);
    };

    var appendRemoveLayerButton = function () {
        var btn = $("<div/>", {
            "data-uid": localThis.Uid,
            "data-tool": "layer-del",
        }).addClass("tool gr-trash filter-hover-danger");
        btn.attr({ title: gltxt("delete") });
