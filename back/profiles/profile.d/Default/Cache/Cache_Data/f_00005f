            return state.getOptions(_opts.id).options.isFavorite;
        },
        function (isFavorite) {
            if (isFavorite !== undefined) {
                isFavorite ? makeFavorite() : unmakeFavorite();
            }
        }
    );

    const subscribeOpacity = moduleLayers.globalStore.subscribe(
        function (state) {
            return state.getOptions(_opts.id).options.opacity;
        },
        function (opacity) {
            if (opacity !== undefined) {
                moduleLayers.uploadOpacity();
                setOpacity(opacity);
            }
        }
    );

    function removeTools() {
        parts.tools?.remove();
    };

    function setOpacity(opacity) {
        opts.opacity = opacity;
        queueMicrotask(() => {
            if (parts.tools) {
                parts.tools.querySelectorAll('.opacity-item').forEach(function (item) {
                    item.setAttribute("data-active", "0");
                    if (parseFloat(item.getAttribute('data-opacity').replace(",", ".")) == opacity) {
