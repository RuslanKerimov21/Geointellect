    function and_or(Next, a, b) {
        switch (Next) {
            case "AND":
                return a && b;
            case "OR":
                return a || b;
            default:
                return b;
        }
    }

    /**
     * Фильтрует фичи в соответствии с настройками слоя и легендой
     * 
     * @param {*} features 
     * @returns массив фич
     */
    function filterFeatures(features) {
        var globalStore = window.layerListPanel.globalStore.getState();
        var { filter, rules } = globalStore.getOptions(instanceOptions.id)?.options;

        // if (rules.length == 0) return { layer: feature.layer }

        // var rulesFilter = parseRulesToFilters(
        //     rules.filter(function(rule) {
        //         return rule.is_checked == true
        //     })
        // );

        // if (!rulesFilter.length) return features;

        filter = [...filter, /*...rulesFilter*/];

        console.log("rules", rules)

        console.log("features before filtering", features);
        console.log("filters combined:", filter);

        // TODO: сделать как в кластерах

        if(!filter.length) return features;
        
        const featuresFiltered = features.filter(function (feature) {
            var filtered = true;
            var next;

            filter.forEach(function (f) {
                switch (f.Condition) {
                    case "eq":
                        filtered = and_or(next, filtered, feature.properties[f.FieldName] == f.Value);
                        break;
                    case "gte":
                        filtered = and_or(next, filtered, feature.properties[f.FieldName] >= f.Value);
                        break;
                    case "lte":
                        filtered = and_or(next, filtered, feature.properties[f.FieldName] <= f.Value);
                        break;
                    case "like":
                        filtered = and_or(next, filtered, feature.properties[f.FieldName].includes(f.Value));
                        break;
                    case "in":
                        filtered = and_or(next, filtered, f.Value.split(',').reduce(function (acc, curr) {
                            return acc || (feature.properties[f.FieldName] == curr);
                        }, false));
                        break;
                    default:
                        break;
                }

                next = f.Next;
            });

            return filtered;
        });

        return featuresFiltered;
    }

    /**
     * Преобразует настройки легенды в фильтры.
     * TODO: дописать другие условия (если необходимо)
     * 
     * @param {*} rules 
     * @returns фильтры
     */
    function parseRulesToFilters(rules) {
        var filters = rules.map(function(rule) {
            var ruleParsingResult = rule.filter.matchAll(/(.*)\s\=\s\'(.*)\'/gm).toArray();
            var [, fieldName, value] = ruleParsingResult[0]; // TODO: ломается

            return {
                Condition: "eq",
                FieldName: fieldName,
                Next: "OR",
                Value: value,
            };
        })

        return filters;
    }

    /**
     * Принимает функцию и обворачивает её в дебаунс. Первый вызов функции
     * будет происходить мгновенно, но каждый последующий вызов
     * будет происходить не чаще одного раза в заданный интервал.
     * Полезно для событий, которые могут происходить очень часто:
     * зум и перемещение карты, ввод в текстовое поле и т. п.
     * 
     * @param {Function} fn
     * @param {number} delay задержка в мс
     * @returns {Function}
     */
    function debounce(fn, delay) {
        let timeout; // This variable will hold the timeout ID
      
        return function(...args) {
            const context = this; // Preserve the 'this' context
        
            // Clear any existing timeout to reset the timer
            clearTimeout(timeout);
        
            // Set a new timeout to execute the function after the delay
            timeout = setTimeout(() => {
                fn.apply(context, args); // Execute the original function with its arguments and context
            }, delay);
        };
    }

