function VectorPointPiechartLayers(instanceOptions, logger, applyWaiter) {
    var local = this;
    this.module = 'layer-list-panel';
    this.initialized = true;
    this.Layer = null;
    this.wasSectorClickedFlag = false;
    this.isClickPopupOpenFlag = false;
    this.isDraggingFlag = false;
    this.logger = logger;

    local.logger.info("Module loaded")

    this.params;
    this.store = zustand.createStore(zustand.subscribeWithSelector(function () {
        return {
            features: [],
            selected: null,
            opacity: 1,
        }
    }));
    this.schema = getPropertiesSchema(instanceOptions);
    this.colorPalette = [
        0xf7df1e,
        0x32a852,
        0xf89820,
        0x3776ab,
        0xeb4034,
        0x4287f5
    ];
    this.hoverPopup = L.popup({
        closeButton: false,
        closeOnClick: false,
        autoClose: false,
        autoPan: false
    });
    this.hoveredSectorData = null;
    
    var { get, set, subscribe } = this.store;

    function onCanvasClick(e) {
        if (local.wasSectorClickedFlag) {
            e.stopPropagation();
        }

        local.wasSectorClickedFlag = false;
    }

    this.Layer = L.pixiOverlay(
        function (utils) {
            const canvas = utils.getRenderer().view;
            
            canvas.addEventListener('click', onCanvasClick);
            canvas.addEventListener('mousedown', onCanvasClick);
            canvas.addEventListener('touchstart', onCanvasClick);

            draw();
            render();
        },
        new PIXI.Container(), {
            layerType: 'multi-cluster', /* to exclude multi cluster layers from pdf generation */
            doubleBuffering: /iPad|iPhone|iPod/.test(navigator.userAgent),
            pane: "markerPane",
        },
    );

    /**
     * Второй этап рендеринга: отрисовка основного контейнера на слое
     */
    function render() {
        if (!local.Layer.utils) return;

        
        var container = local.Layer.utils.getContainer();
        var renderer = local.Layer.utils.getRenderer();
        
        var scale = local.Layer.utils.getScale();

        local.logger.debug(`Rendering ${container?.children?.length} children`);

        container.children.forEach(function (child) {
            child.scale.set(1 /scale);
        });

        renderer.render(container);
    }

    /**
     * Принимает массив цветов в формате шестнадцатиричного числа.
     * Возвращает функцию, которая позволяет получать цвета из палитры,
     * чередуя их по порядку
     * 
     * @param {number[]} colors 
     * @returns {() => number} функция, которая возвращает следующий цвет из палитры
     */
    function createOrdinalColorPalette(colors) {
        let lastUsedIndex = -1;

        return function() {
            if (lastUsedIndex + 1 > colors.length - 1) {
                lastUsedIndex = 0;

                return colors[lastUsedIndex];
            }

            return colors[++lastUsedIndex];
        }
    }

    /**
     * Преобразует чё угодно в положительное числовое значение
     * 
     * @param {*} value 
     * @returns {number}
     */
    function normalizeValue(value) {
        value = Number(value);

        if (isNaN(value)) {
            value = 0;
        }

        return Math.abs(value);
    }

    /**
     * Конвертирует неудобную схему в удобную, где по ключу в мапе указано
     * название свойства, а значением является объект, где ключ - локаль,
     * а значение - локализированное название
     * 
     * @param {*} layerOptions 
     * @returns {Map<string, {
     *   [key: string]: string
     * }>}
     */
    function getPropertiesSchema(layerOptions) {
        return layerOptions.schema.reduce((result, schemaEntry) => {
            result.set(
                schemaEntry.name,
                schemaEntry.aliases.reduce((result, aliasEntry) => {
                    result[aliasEntry.language] = aliasEntry.alias;

                    return result;
                }, {})
            );

            return result;
        }, new Map());
    };

    /**
     * Конвертирует цвет в формате "#FFFFFF" в формат 0xFFFFFF (PIXI другой не жрёт)
     * 
     * @param {string} color 
     * @returns {number | null} hex number or null
     */
    function parseColorString(color) {
        if (color == undefined || color == null) return null;

        const cleanHexString = color.startsWith('#') ? color.substring(1) : color;

        return parseInt(cleanHexString, 16);
    }

    /**
     * Преобразовывает данные из параметров фичи в формат, пригодный для рисования
     * диаграммы. Учитывает только те поля, которые разрешены в параметрах модуля
     * 
     * @param {*} properties 
     * @param {() => number} getColor 
     * @returns {{
     *   data: {
     *     label: string,
     *     value: number,
     *     color: number
     *   }[],
     *   total: number
     * }}
     */
    function parseDataFromFeatureProps(properties, getColor) {
        const data = Object.entries(properties).reduce((result, [key, value]) => {
            if (!local.params[instanceOptions.id].allowedFields.includes(key)) {
                return result;
            }

            const colorFromModuleParams = local.params[instanceOptions.id].fieldsColors?.[key];

            result.push({
                label: local.params[instanceOptions.id].fieldAliases?.[key] ?? local.schema.get(key)?.["ru-RU"] ?? key,
                value: normalizeValue(value),
                color: parseColorString(colorFromModuleParams) ?? getColor(),
            });

            return result;
        }, [])

        const total = data.reduce((sum, item) => sum + item.value, 0);

        return {
            data,
            total,
        }
    }

    /**
     * Переводит расстояние в метрах в пиксели
     * 
     * @param {L.Map} map - экземпляр карты Leaflet
     * @param {number} meters - расстояние в метрах
     * @param {L.LatLng} [center] - опционально: центральная точка (для учёта искажений проекции)
     * @returns {number} расстояние в пикселях
     */
    function metersToPixels(map, meters, center) {
        // Если центр не задан, используем центр карты
        const latLng = center || map.getCenter();

        // Находим точку на востоке на заданном расстоянии
        const pointEast = L.GeometryUtil.destination(latLng, 90, meters); // 90° — направление на восток

        // Получаем пиксельные координаты
        const p1 = map.latLngToLayerPoint(latLng);
        const p2 = map.latLngToLayerPoint(pointEast);

        // Возвращаем расстояние между точками в пикселях
        return Math.abs(p2.x - p1.x);
    }

    /**
     * Рисует один серый сектор на все 360° для того,
     * чтобы показать отсутствие данных для диаграммы
     * 
     * @param {number} x 
     * @param {number} y 
     * @param {number} r 
     * @param {number} rInner 
     * @param {number} angle 
     * @returns {PIXI.Container}
     */
    function drawMissingDataSector(screenX, screenY, x, y, r, rInner, angle, opacity) {
        const graphics = new PIXI.Graphics();
        const noDataContainer = new PIXI.Container();

        // TODO: попап
        let hoverMarker;

        graphics
