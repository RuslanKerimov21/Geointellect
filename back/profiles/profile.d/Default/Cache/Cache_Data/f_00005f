function LoggerManager() {
    const store = zustand.createStore(function () {
        return {            
            enabled: localStorage.getItem("logger") == "enabled",
            journal: localStorage.getItem("logger-journal") == "enabled",
            debug: localStorage.getItem("logger-debug") == "enabled",
        }
    });

    this.subscribe = function(listener) {
        listener(store.get());
        return store.subscribe(listener);
    } 

    const logger = new LocalLogger("logger-manager", this);

    this.info = logger.info;
    this.warn = logger.warn;
    this.error = logger.error;
    this.debug = logger.debug;

    this.enable = function() {
        localStorage.setItem("logger", "enabled");
        store.set({ enabled: true });
    }

    this.disable = function() {
        localStorage.removeItem("logger");
        store.set({ enabled: false });
    }

    this.enableDebug = function() {
        localStorage.setItem("logger-debug", "enabled");
        store.set({ debug: true });
    }

    this.disableDebug = function() {
        localStorage.removeItem("logger-debug");
        store.set({ debug: true });
    }

    this.enableJournal = function() {
        localStorage.setItem("logger-journal", "enabled");
        store.set({ journal: true });
    }

    this.disableJournal = function() {
        localStorage.removeItem("logger-journal");
        store.set({ journal: true });
    }
}

function LocalLogger(module, manager = window.logger) {
    const instance = this;
    const state = {
        enabled: false,
        journal: false,
        debug: false,
    }
    
    if (!window.journal) {
        window.journal = {};
    }

    if (!window.journal[module]) {
        window.journal[module] = [];
    }

    instance.journal = window.journal[module];

    manager.subscribe((logger) => {
        state.enabled = logger.enable;
        state.debug = logger.debug;
        state.journal = logger.journal;
    })

    /**
     * @param {string} message
     * @returns {void}
     */
    this.info = function(message) {
        if (state.enabled) {
            console.log(`[${module}] ${message}`);            
        }

        if (state.journal) {
            instance.journal.push(`[${Date.now()}] [${module}] INFO: ${message}`);
        }
    }

    /**
     * @param {string} message
     * @returns {void}
     */
    this.warn = function(message) {
        if (state.enabled) {
            console.warn(`[${module}] ${message}`);            
        }

        if (state.enabled) {
            instance.journal.push(`[${Date.now()}] [${module}] WARN: ${message}`);
        }
    }

    /**
     * @param {string} message
     * @returns {void}
     */
    this.error = function(message) {
        if (state.enabled) {
            console.error(`[${module}] ${message}`);            
        }
        
        if (state.enabled) {
            instance.journal.push(`[${Date.now()}] [${module}] ERROR: ${message}`);
        }
    }

    /**
     * @param {string} message
     * @returns {void}
     */
    this.debug = function(message) {
        if (state.debug) {
            console.log(`%c[${module}] ${message}`, "color: orange;");
        }

        if (state.enabled) {
            instance.journal.push(`[${Date.now()}] [${module}] DEBUG: ${message}`);
        }
    }

    this.enable = function() {
        state.enabled = true;
    }

    this.disable = function() {
        state.enabled = false;
    }

    this.enableDebug = function() {
        state.debug = true;
    }

    this.disableDebug = function() {
        state.debug = false;
    }

    this.enableJournal = function() {
        state.journal = true;
    }

    this.disableJournal = function() {
        state.journal = true;
    }
}

