            function () {
                localThis.close();
            });

        localThis.dialog.on("click", ".content-brick > [data-action]",
            function () {
                if (localThis.hasOwnProperty($(this).attr("data-action"))) {
                    localThis[$(this).attr("data-action")]();
                }
            });

        localThis.dialog.on("click", ".controlsContainer > [data-role]",
            function () {
                localThis[$(this).attr("data-role")]();
            });

        localThis.dialog.on("change", "[data-role=selectFile] > .fileform > input:file",
            function () {
                var fileName = $(this).val();

                $(this).parent().children("[data-field=filename]").html(fileName);

                if (localThis.checkFile($(this))) {
                    localThis.file = $(this)[0].files[0];
                    
                    localThis.fileinfo = {
                        Uid: "",
                        Name: fileName,
                        ClientId: -1,
                        Login: window.UserModule.userData.Info.Login,
                        Size: 0,
                        Format: "",
                        Mime: "",
                        ObjectId: localThis.feature.Id,
                        Url: ""
                    };
                }
            });
