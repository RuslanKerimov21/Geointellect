            .beginFill(0xA3A3A3, opacity)
            .arc(x, y, r, angle, angle - 0.001)
            .arc(x, y, rInner, angle - 0.001, angle, true)
            .closePath()
            .endFill()

        noDataContainer.interactive = "true";
        
        noDataContainer.on("pointerover", () => {
