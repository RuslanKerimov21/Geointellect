        if (elem[0].files.length === 1) {
            var file = elem[0].files[0];
            badfile.toobig = (file.size >= 50000000);
            badfile.badformat = ["exe", "dll", "bat", "cmd", "run"].indexOf(file.type) !== -1;
            var out = "";
            out += (badfile.toobig) ? "Слишком большой файл, должен быть до 50 Мб<br/>" : "";
            out += (badfile.badformat) ? "Загрузка исполняемых файлов не разрешена<br/>" : "";
            if (out !== "") {
                alert(out);
                return false;
            } else {
                return true;
            }
        } else {
            alert((elem[0].files.length === 0) ? "Нет файла" : "Много файлов");
