class PointRenderer {
    /** @type {import("@pixi/graphics").Graphics} */
    graphics = new PIXI.Graphics();
    /** @type {import("@pixi/display").Container} */
    container = new PIXI.Container();
    feature;
    pixiLayer;
    popup;

    constructor(feature, pixiLayer) {
        this.feature = feature;
        this.pixiLayer = pixiLayer;

        const { x, y } = this.#project(feature);

        this.container.position.set(x, y);
    }

    /**
     *
     * @param {boolean} condition
     * @param {(renderer: PointRenderer) => PointRenderer} _then
     * @param {(renderer: PointRenderer) => PointRenderer} _else
     * @returns {PointRenderer}
     */
    when(condition, _then, _else) {
        condition ? _then(this) : _else(this);
        return this;
    }

    /**
     * @param {{ radius: number, fillColor: number, opacity: number}} options
     * @returns {PointRenderer}
     */
    addCircle({ radius, fillColor, opacity }) {
        this.graphics
            .beginFill(this.#resolveColor(fillColor), opacity)
            .drawCircle(0, 0, radius)
            .endFill();

        return this;
    }

    /**
     * @param {{ content: string, fontSize: number, fill: number}} options
     * @returns {PointRenderer}
     */
    addText({ content, fontSize, fill }) {
        const text = new PIXI.Text(content, {
            fontSize,
            fill: this.#resolveColor(fill),
        });

        text.anchor.set(0.5, 0.5);
        this.graphics.addChild(text);

        return this;
    }

    /**
     * @param {{
     *   data: Array<{
     *     name: string,
     *     value: number,
     *   }>,
     *   palette: number[] | { [name: string]: color: number },
     *   innerRadius: number,
     *   startAngle: number,
     * }} options
     * @returns {PointRenderer}
     */
    addPiechart({ data, radius, innerRadius, startAngle, palette }) {
        // const total = Object.values(data).reduce((acc, val) => acc + val, 0);
        const total = data.reduce((acc, val) => acc + val.value, 0);
        const centerX = 0;
        const centerY = 0;

        /** @type {(name: string) => number} */
        let getColor;

        let currentAngle = startAngle;

        if (palette.length !== undefined) {
            const getColorCallback = this.#createOrdinalColorPalette(palette);

            getColor = (name) => getColorCallback();
        } else {
            getColor = (name) => palette[name] ?? 0xff0000;
        }

        for (const { name, value } of data) {
            const angle = (value / total) * Math.PI * 2;
            const startAngle = currentAngle;
            const endAngle = currentAngle + angle;
            const color = getColor(name);

            this.graphics
                .beginFill(this.#resolveColor(color), 0.8)
                .arc(centerX, centerY, radius, startAngle, endAngle)
                .arc(centerX, centerY, innerRadius, endAngle, startAngle, true)
                .closePath()
                .endFill();

            currentAngle += angle;
        }

        return this;
    }

    addEventListener(eventName, callback) {
        this.container.interactive = "true";
        this.container.on(eventName, (e) => {
            callback({
                ...e,
                feature: this.feature,
            });
        });

        return this;
    }

    /**
     * @returns {PIXI.Container}
     */
    get() {
        this.container.addChild(this.graphics);
        return this.container;
    }

    #project(feature) {
        return this.pixiLayer.utils.latLngToLayerPoint([
            feature.geometry.coordinates[1],
            feature.geometry.coordinates[0],
        ]);
    }

    /**
     * Конвертирует цвет в формате "#FFFFFF" в формат 0xFFFFFF (PIXI другой не жрёт)
     *
     * @param {string | number | undefined | null} color
     * @returns {number | null} hex number or null
     */
    #resolveColor(color) {
        if (color == undefined || color == null) return null;

        if (typeof color === "string") {
            const cleanHexString = color.startsWith("#")
                ? color.substring(1)
                : color;

            return parseInt(cleanHexString, 16);
        }

        return color;
    }

    /**
     * Принимает массив цветов в формате шестнадцатиричного числа.
     * Возвращает функцию, которая позволяет получать цвета из палитры,
     * чередуя их по порядку
     *
     * @param {number[]} colors
     * @returns {() => number} функция, которая возвращает следующий цвет из палитры
     */
    #createOrdinalColorPalette(colors) {
        let lastUsedIndex = -1;

        return function () {
            if (lastUsedIndex + 1 > colors.length - 1) {
                lastUsedIndex = 0;

                return colors[lastUsedIndex];
            }

            return colors[++lastUsedIndex];
        };
    }
}

function CanvasClickManager() {
    const state = {
        subscribed: false,
        canvas: null,
        clicked: false,
    };

    function handle(e) {
        if (state.clicked) {
            e.stopPropagation();
        }

        state.clicked = false;
    }

    function subscribe(utils) {
        if (state.subscribed) return;
        state.subscribed = true;
        state.canvas = utils.getRenderer().view;
        state.canvas.addEventListener("click", handle);
        state.canvas.addEventListener("mousedown", handle);
        state.canvas.addEventListener("touchstart", handle);
    }

    function unsubscribe() {
        state.canvas.removeEventListener("click", handle);
        state.canvas.removeEventListener("mousedown", handle);
        state.canvas.removeEventListener("touchstart", handle);
        state.canvas = null;
        state.subscribed = false;
    }

    function click() {
        state.clicked = true;
    }

    return {
        click,
        subscribe,
        unsubscribe,
    };
}

