        console.log("cluster", cluster);
    }

    style(style) {
        console.log("style", style);
    }

    clustersDbscan(features, distance) {
        const clusters = [];
        const noise = [];

        const dbscan = turf.clustersDbscan(
            turf.featureCollection(features),
            distance,
        );
        for (const feature of dbscan.features) {
            if (feature.properties.dbscan === "noise") {
                noise.push(feature);
                continue;
            }

            const cluster = (clusters[feature.properties.cluster] ??= []);
            cluster.push(feature);
        }

        return clusters
            .map((cluster, id) => {
                const center = turf.centerOfMass(
                    turf.featureCollection(cluster),
                );
                center.properties = {
                    cluster: id,
                    features: cluster,
                };
                return center;
            })
            .concat(noise);
    }

    add(features) {
        this.store.set({
            features: this.clustersDbscan(features, 1),
        });
    }

    #subscribe() {
        const featureRerenderUnsubscribe = this.store.subscribe(
            (state) => state.features,
            (features) => {
                if (features.length === 0) {
                    if (window.MAP.hasLayer(this.layer)) {
                        this.clickManager.unsubscribe();
                        window.MAP.removeLayer(this.layer);
                    }

                    return;
                }

                if (!window.MAP.hasLayer(this.layer)) {
                    window.MAP.addLayer(this.layer);
                }

                this.#redraw();
                this.#render();
            },
        );

        const opacityRerenderUnsubscribe = this.store.subscribe(
            (state) => state.opacity,
            (opacity) => {
                if (!this.layer.utils) return;

                const renderer = this.layer.utils.getRenderer();
                const container = this.layer.utils.getContainer();

                container.alpha = opacity;

                renderer.render(container);
            },
        );

        return [featureRerenderUnsubscribe, opacityRerenderUnsubscribe];
    }
}

