    function geographicRadiusToPixels(map, latlng, radiusKm) {
        const R = 6378.1; // радиус Земли в км
        const latRad = (latlng.lat * Math.PI) / 180;
        const scale = Math.cos(latRad); // проекция Меркатора: сжатие по долготе
      
        // Длина одного градуса широты ≈ 111.32 км
        const metersPerDegreeLat = 111320;
        // Длина одного градуса долготы зависит от широты
        const metersPerDegreeLng = 111320 * scale;
      
        // Среднее (или можно взять по широте — безопаснее)
        const metersPerDegree = metersPerDegreeLat;
      
        const radiusMeters = radiusKm * 1000;
        const radiusDegrees = radiusMeters / metersPerDegree;
      
        // Теперь переведём это в пиксели
        const point1 = map.latLngToLayerPoint(latlng);
        const point2 = map.latLngToLayerPoint([
          latlng.lat + radiusDegrees,
          latlng.lng,
        ]);
      
        return point1.distanceTo(point2);
    }

