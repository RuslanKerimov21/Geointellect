        if (link.length <= 10) {
            alert("Вы не указали веб-ссылку");
            return;
        }

        var caption = $.trim(localThis.dialog.find("[data-field=newLinkCaption]").val());

        localThis.uploadinfo = {
            Uid: "",
            Name: caption,
            ClientId: -1,
            Login: "",
            Size: 0,
            Format: "url",
            Mime: "text/plain",
            LayerUid: localThis.feature.layer.uid,
            ObjectUid: localThis.feature.properties.uniqueid,
            Url: link
        };

        var request = {
            layer_uid: localThis.feature.layer.uid,
            object_uid: localThis.feature.properties.uniqueid,
            fileinfo: JSON.stringify(localThis.uploadinfo)
