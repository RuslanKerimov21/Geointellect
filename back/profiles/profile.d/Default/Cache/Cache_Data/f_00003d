var calculateObjectPerimetr = function (llObject) {
    var lineMarkers = llObject.getLatLngs();
    var distance = 0;
    for (var i = 1; i < lineMarkers.length; i++) {
        var markerPrev = lineMarkers[i - 1];
        var marker = lineMarkers[i];
        distance += markerPrev.distanceTo(marker);
    }
    distance += lineMarkers[0].distanceTo(lineMarkers[lineMarkers.length - 1]);
    return distance;
};

var calculateObjectArea = function (llObject) {
    var area = L.GeometryUtil.geodesicArea(llObject.getLatLngs());
    return area;
};

var calculateObjectLength = function (latlngs) {
    
    var analysisCoords;
    if (typeof latlngs.getLatLngs !== "undefined") {
        analysisCoords = latlngs.getLatLngs();
    }
    else {
        analysisCoords = latlngs;
    }
    
    var distance = 0;
    var pointsCount = analysisCoords.length;

    if (pointsCount === 1) {
        if (analysisCoords[0].length > 2) {
            analysisCoords = analysisCoords[0];
            pointsCount = analysisCoords.length;
        }
    }

    if (pointsCount > 2) {
        for (var i = 1; i < pointsCount; i++) {
            var latlngCur = analysisCoords[i];
            var latlngPrev = analysisCoords[i - 1];
            distance += latlngPrev.distanceTo(latlngCur);
        }
    }

    return distance;
};

var calculateObjectLastSegmentLength = function (latlngs) {
    if (latlngs.length < 2) return 0;
    return calculateObjectLength([latlngs[latlngs.length - 2], latlngs[latlngs.length - 1]]);
};

