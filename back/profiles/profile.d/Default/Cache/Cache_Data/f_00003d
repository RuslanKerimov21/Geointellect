};

var splitByZeroMeridian = function (geometry) {
    if(geometry.type !== "Polygon" && geometry.type !== "MultiPolygon") return geometry;

    var meridian = turf.polygon([[[179.999999, 90], [179.999999, -90], [180, -90], [180, 85], [179.999999, 90]]]);    
    var feature = turf.difference(geometry, meridian);

    return feature.geometry;
}

var transformPairCoordinatesTo3857 = function (xlon, ylat) {
    var target = 'EPSG:3857';
    var source = 'EPSG:4326';
    return proj4(source, target, [xlon, ylat]);
};

var createPolygonFromBounds = function (latLngBounds) {
    var center = latLngBounds.getCenter();
    var latlngs = [];

    latlngs.push(latLngBounds.getSouthWest());
    latlngs.push({ lat: latLngBounds.getSouth(), lng: center.lng });
    latlngs.push(latLngBounds.getSouthEast());
    latlngs.push({ lat: center.lat, lng: latLngBounds.getEast() });
    latlngs.push(latLngBounds.getNorthEast());
    latlngs.push({ lat: latLngBounds.getNorth(), lng: center.lng });
    latlngs.push(latLngBounds.getNorthWest());
    latlngs.push({ lat: center.lat, lng: latLngBounds.getWest() });

    return new L.polygon(latlngs);
};

var getPreparedGeoJson = function (llObject) {
    if (typeof llObject === "undefined" || llObject === null) return null;
    var aGeometry = llObject.toGeoJSON().geometry;

    aGeometry = splitByZeroMeridian(aGeometry);

    if (aGeometry.type === "Point") {
        // aGeometry.coordinates = fixMeridianPoint(aGeometry.coordinates);
        aGeometry.coordinates = transformPairCoordinatesTo3857(
            aGeometry.coordinates[0],
            aGeometry.coordinates[1]
        );
    } else {
        for (var i = 0; i < aGeometry.coordinates.length; i++) {
            for (var j = 0; j < aGeometry.coordinates[i].length - 1; j++) {
                var tmp = aGeometry.coordinates[i][j];
                var transformed = transformPairCoordinatesTo3857(
                    tmp[0],
                    tmp[1]
                );
                tmp[0] = transformed[0];
                tmp[1] = transformed[1];
            }
        }
    }

    aGeometry = addCRSToGeoJSONGeometry3857(aGeometry);
    return JSON.stringify(aGeometry);
};

var getPreparedGeoJsonAsObject = function (llObject) {
    var i, j, k, tmp, transformed;

    if (typeof llObject === "undefined" || llObject === null) return null;

    var aGeometry;

    if (typeof llObject.toGeoJSON == "function") {
        if (llObject.toGeoJSON().type === "Feature") {
            aGeometry = llObject.toGeoJSON().geometry;
        } else if (llObject.toGeoJSON().type === "FeatureCollection") {
            aGeometry = llObject.toGeoJSON().features[0].geometry;
        } else {
            return null;
        }
    }
    else {
        if (llObject.hasOwnProperty("type") && llObject.hasOwnProperty("coordinates")) {
            aGeometry = llObject;
        }
    }
    
    aGeometry = splitByZeroMeridian(aGeometry);        
    
    if (aGeometry.type === "Point") {
        // aGeometry.coordinates = fixMeridianPoint(aGeometry.coordinates);
        aGeometry.coordinates = transformPairCoordinatesTo3857(
            aGeometry.coordinates[0],
            aGeometry.coordinates[1]
        );
    }
    else if (aGeometry.type === "MultiPoint") {
        var mpoint = aGeometry.coordinates;
        for (i = 0; i < mpoint.length; i++) {
            tmp = mpoint[i];
            transformed = transformPairCoordinatesTo3857(
                tmp[0],
                tmp[1]
            );
            tmp[0] = transformed[0];
            tmp[1] = transformed[1];
        }
    }
    else if (aGeometry.type === "Polygon") {
        var polygon = aGeometry.coordinates;
        for (i = 0; i < polygon.length; i++) {
            var line = polygon[i];
            var offset = line.at(0) === line.at(-1) ? 1 : 0;
            for (j = 0; j < line.length - offset; j++) {
                tmp = line[j];
                transformed = transformPairCoordinatesTo3857(
                    tmp[0],
                    tmp[1]
                );
                tmp[0] = transformed[0];
                tmp[1] = transformed[1];
            }
        }
    } else if (aGeometry.type === "MultiPolygon") {
        var polygons = aGeometry.coordinates;
        for (i = 0; i < polygons.length; i++) {
            var polygon = polygons[i];
            for (j = 0; j < polygon.length; j++) {
                var line = polygon[j];
                var offset = line.at(0) === line.at(-1) ? 1 : 0;
                for (k = 0; k < line.length - offset; k++) {
                    tmp = line[k];
                    transformed = transformPairCoordinatesTo3857(
                        tmp[0],
                        tmp[1]
                    );
                    tmp[0] = transformed[0];
                    tmp[1] = transformed[1];
                }
            }
        }
    }

    aGeometry = addCRSToGeoJSONGeometry3857(aGeometry);

    return aGeometry;
};

var getLlObjectFromGeoJson = function (geojson, transform) {
    var a, i, j, tmp, transformed;
    transform = (typeof transform === "undefined") ? true : transform;

    if (typeof geojson === "undefined" || geojson === null) return null;
    var aGeometry;
    if (typeof geojson === "string") {
        aGeometry = $.parseJSON(geojson);
    } else if (typeof geojson === "object") {
        aGeometry = geojson;
    } else {
        return null;
    }

    if (!aGeometry) return null;

    aGeometry = splitByZeroMeridian(aGeometry);
    
    if (aGeometry.type === "Point") {
        if (transform) {
            aGeometry.coordinates = transformPairCoordinatesTo4326(
                aGeometry.coordinates[0],
                aGeometry.coordinates[1]
            );
        }
        /*aGeometry = addCRSToGeoJSONGeometry(aGeometry);*/
        return L.geoJson(aGeometry, {
            pointToLayer: geoJsonPointToLayer
        });
    } else if (aGeometry.type === "Polygon") {
        var polygon = aGeometry.coordinates;
        for (i = 0; i < polygon.length; i++) {
            var line = polygon[i];
            var offset = line.at(0) === line.at(-1) ? 1 : 0;
            for (j = 0; j < line.length - offset; j++) {
                tmp = line[j];
                transformed = transformPairCoordinatesTo4326(
                    tmp[0],
                    tmp[1]
                );
                tmp[0] = transformed[0];
                tmp[1] = transformed[1];
            }
        }
    } else if (aGeometry.type === "MultyPolygon") {
        var polygons = aGeometry.coordinates;
        for (a = 0; a < polygons.length; a++) {
            var polygon = polygons[a];
            for (i = 0; i < polygon.length; i++) {
                var line = polygon[i];
                var offset = line.at(0) === line.at(-1) ? 1 : 0;
                for (j = 0; j < line.length - offset; j++) {
                    tmp = line[j];
                    transformed = transformPairCoordinatesTo4326(
                        tmp[0],
                        tmp[1]
                    );
                    tmp[0] = transformed[0];
                    tmp[1] = transformed[1];
                }
            }
        }
    }

    aGeometry = addCRSToGeoJSONGeometry(aGeometry);
    
    return L.geoJson(aGeometry);
};

