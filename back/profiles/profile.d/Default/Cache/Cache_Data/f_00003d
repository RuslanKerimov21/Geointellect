var geojsonToCql = function (aGeojson) {
    if (typeof (aGeojson) === "undefined" || aGeojson === null) return null;
    aGeojson = $.parseJSON(aGeojson);
    var result = "";
    result += aGeojson.type + "(";
    for (var i = 0; i < aGeojson.coordinates.length; i++) {
        var first = true;
        result += "(";
        for (var j = 0; j < aGeojson.coordinates[i].length; j++) {
            if (first) {
                first = false;
            } else {
                result += ", ";
            }
            var tmp = aGeojson.coordinates[i][j];
            //                    result += transformPairCoordinatesTo4326(tmp[0], tmp[1]).join(" ");
            result += tmp.join(" ");
        }
        result += ")";
    }
    result += ")";
    return result;
};

var transformPairCoordinatesTo4326 = function (xlon, ylat) {
    var source = 'EPSG:3857';
    var target = 'EPSG:4326';
    return proj4(source, target, [xlon, ylat]);
};

var transformPolygonTo4326 = function (geometry) {
    var a, i, j, tmp, transformed;
    var result = geometry;
    if (result.Type === "Polygon") {
        for (i = 0; i < result.coordinates.length; i++) {
            for (j = 0; j < result.coordinates[i].length - 1; j++) {
                tmp = result.coordinates[i][j];
                transformed = transformPairCoordinatesTo4326(
                    tmp[0],
                    tmp[1]
                );
                tmp[0] = transformed[0];
                tmp[1] = transformed[1];
            }
        }
    }
    else if (result.Type === "MultiPolygon") {
        for (a = 0; a < result.coordinates.length; i++) {
            for (i = 0; i < result.coordinates[a].length; i++) {
                for (j = 0; j < result.coordinates[a][i].length - 1; j++) {
                    tmp = result.coordinates[a][i][j];
                    transformed = transformPairCoordinatesTo4326(
                        tmp[0],
                        tmp[1]
                    );
                    tmp[0] = transformed[0];
                    tmp[1] = transformed[1];
                }
            }
        }
    }

    return result;
};

