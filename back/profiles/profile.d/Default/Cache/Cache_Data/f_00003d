function Cut180Meridian(multiPolygon) {
    if (multiPolygon.length === 0) return [];

    // Group into rows
    var sorted = multiPolygon.slice().sort(function (a, b) {
        var minA = Math.min.apply(null, a.map(function (p) { return p[1]; }));
        var minB = Math.min.apply(null, b.map(function (p) { return p[1]; }));
        return minA - minB;
    });

    var rows = [];
    var currentGroup = [sorted[0]];
    var currentMax = Math.max.apply(null, sorted[0].map(function (p) { return p[1]; }));

    for (var i = 1; i < sorted.length; i++) {
        var poly = sorted[i];
        var minL = Math.min.apply(null, poly.map(function (p) { return p[1]; }));
        if (minL <= currentMax) {
            currentGroup.push(poly);
            currentMax = Math.max(currentMax, Math.max.apply(null, poly.map(function (p) { return p[1]; })));
        } else {
            rows.push(currentGroup);
            currentGroup = [poly];
            currentMax = Math.max.apply(null, poly.map(function (p) { return p[1]; }));
        }
    }
    rows.push(currentGroup);

    var resultMultiPolygon = [];

    for (var j = 0; j < rows.length; j++) {
        var row = rows[j];
        var lefts = row.filter(function (poly) {
            return poly.some(function (p) { return p[0] === 180; });
        });
        var rights = row.filter(function (poly) {
            return poly.some(function (p) { return p[0] === -180; });
        });
        var others = row.filter(function (p) {
            return lefts.indexOf(p) === -1 && rights.indexOf(p) === -1;
        });

        var cleanedOthers = others.map(function (poly) {
            return poly.filter(function (p) { return p[0] !== 180 && p[0] !== -180; });
        });

        if (lefts.length === 1 && rights.length === 1) {
            var left = lefts[0];
            var right = rights[0];
            var cleanedLeft = left.filter(function (p) { return p[0] !== 180 && p[0] !== -180; });
            var cleanedRight = right.filter(function (p) { return p[0] !== 180 && p[0] !== -180; });

            // Assume polygons are closed (last point equals first)
            var leftPath = cleanedLeft.slice(0, -1);
            var rightPathReversed = cleanedRight.slice(0, -1).reverse();
            var newPolygon = leftPath.concat(rightPathReversed).concat([cleanedLeft[0]]);

            resultMultiPolygon.push(newPolygon);
        } else {
            // If not exactly one left and one right, just add cleaned versions of all in the row
            var cleanedLefts = lefts.map(function (poly) {
                return poly.filter(function (p) { return p[0] !== 180 && p[0] !== -180; });
            });
            var cleanedRights = rights.map(function (poly) {
                return poly.filter(function (p) { return p[0] !== 180 && p[0] !== -180; });
            });
            resultMultiPolygon = resultMultiPolygon.concat(cleanedLefts).concat(cleanedRights).concat(cleanedOthers);
        }
    }

    return resultMultiPolygon;
}