var invertFeatureCoordinates = function (_feature) {
    if (typeof _feature === "undefined" || _feature === null || _feature.type != "Feature") {
        return null;
    }
    var geom;
    switch (_feature.geometry.type) {
        case "Polygon":
            geom = turf.flip(turf.polygon(_feature.geometry.coordinates));
            break;
        case "MultiPolygon":
            geom = turf.flip(turf.multiPolygon(_feature.geometry.coordinates));
            break;
        case "LineString":
            geom = turf.flip(turf.lineString(_feature.geometry.coordinates));
            break;
        case "MultiLineString":
            geom = turf.flip(turf.multiLineString(_feature.geometry.coordinates));
            break;
        default:
            alert("not supported");
            break;
    }
    return geom;
};

function polygonToLineGeometry(geometry) {
    if (!geometry || !geometry.type) {
        return false;
    }

    const type = geometry.type;
    const coordinates = geometry.coordinates;

    if (type === "Polygon") {
        return {
            type: "LineString",
            coordinates: coordinates[0] 
        };
    } else if (type === "MultiPolygon") {
        const lines = coordinates.map(polygon => polygon[0]);
        return {
            type: "MultiLineString",
            coordinates: lines
        };
    } else {
        return false;
    }
}
function extractFullCircularOutline(multiPolygon) {
    /* Проверка валидности входных данных */
    if (!multiPolygon || multiPolygon.type !== "MultiPolygon" || !Array.isArray(multiPolygon.coordinates)) {
        return null;
    }

    /* Проверка пересечения 180-го меридиана */
    let minLon = Infinity;
    let maxLon = -Infinity;

    for (const polygon of multiPolygon.coordinates) {
        for (const ring of polygon) {
            for (const [lon] of ring) {
                if (lon < minLon) minLon = lon;
                if (lon > maxLon) maxLon = lon;
            }
        }
    }

    const crosses180 = (maxLon - minLon) > 180;

    /* Если не пересекает 180, возвращаем первый внешний контур */
    if (!crosses180) {
        return {
            type: "LineString",
            coordinates: multiPolygon.coordinates[0][0]
        };
    }

    /* Преобразование координат из 0..360 в -180..180 */
    const toMinus180 = ([lon, lat]) => [(lon > 180 ? lon - 360 : lon), lat];
    const to360 = ([lon, lat]) => [(lon < 0 ? lon + 360 : lon), lat];

    /* Собираем все внешние кольца */
    let allPoints = [];
    for (const polygon of multiPolygon.coordinates) {
        const ring = polygon[0];
        allPoints.push(...ring.slice(0, -1)); /* Убираем замыкающую точку */
    }

    /* Преобразуем в -180..180 для вычислений */
    const points180 = allPoints.map(toMinus180);

    /* Вычисляем центр по долготе и широте */
    const centerLat = points180.reduce((sum, [_, lat]) => sum + lat, 0) / points180.length;
    const centerLon = points180.reduce((sum, [lon]) => sum + lon, 0) / points180.length;

    /* Вычисляем углы для сортировки */
    const pointsWithAngles = points180.map(([lon, lat]) => {
        const dx = lon - centerLon;
        const dy = lat - centerLat;
        let angle = Math.atan2(dy, dx);
        if (angle < 0) angle += 2 * Math.PI;
        return { point: [lon, lat], angle };
    });

    /* Сортировка по углу против часовой стрелки */
    pointsWithAngles.sort((a, b) => a.angle - b.angle);

    /* Получение упорядоченных точек */
    const sorted = pointsWithAngles.map(p => p.point);

    /* Замыкаем контур */
    sorted.push(sorted[0]);

    /* Преобразуем обратно в 0..360 */
    const sorted360 = sorted.map(to360);

    /* Возвращаем как LineString */
    return {
        type: "LineString",
        coordinates: sorted360
    };
}

function extractUnifiedOutline(multiPolygon) {
    if (!multiPolygon || multiPolygon.type !== "MultiPolygon" || !Array.isArray(multiPolygon.coordinates)) {
        return null;
    }

    let allPoints = [];
    for (const polygon of multiPolygon.coordinates) {
        const ring = polygon[0];
        allPoints.push(...ring.slice(0, -1)); 
    }

    const centerLat = allPoints.reduce((sum, [_, lat]) => sum + lat, 0) / allPoints.length;
    const centerLon = allPoints.reduce((sum, [lon]) => sum + lon, 0) / allPoints.length;

    const pointsWithAngles = allPoints.map(([lon, lat]) => {
        const dx = lon - centerLon;
        const dy = lat - centerLat;
        let angle = Math.atan2(dy, dx);
        if (angle < 0) angle += 2 * Math.PI;
        return { point: [lon, lat], angle };
    });

    pointsWithAngles.sort((a, b) => a.angle - b.angle);

    const sorted = pointsWithAngles.map(p => p.point);

    sorted.push(sorted[0]);

    return {
        type: "LineString",
        coordinates: sorted
    };
}

function convertLongitudesTo360(geometry) {
    return processGeometry(geometry, function (lon) {
        return lon < 0 ? lon + 360 : lon;
    });
}

function convertLongitudesTo180(geometry) {
    return processGeometry(geometry, function (lon) {
        return lon >= 180 ? lon - 360 : lon;
    });
}


function convertLongitudesTo360Mercator(geometry) {
    return processGeometry(geometry, function (lon) {
        return lon < 0 ? lon + 20037508.342789244 * 2 : lon;
    });
}

function convertLongitudesTo180Mercator(geometry) {
    return processGeometry(geometry, function (lon) {
        return lon >= 20037508.342789244 ? lon - 20037508.342789244 * 2 : lon;
    });
}


function processGeometry(geometry, convertFn) {
    if (!geometry || !geometry.type || !geometry.coordinates && geometry.type !== 'GeometryCollection') {
        return geometry;
    }

    function deepMap(coords) {
        if (typeof coords[0] === 'number') {
            var converted = [convertFn(coords[0]), coords[1]];
            for (var i = 2; i < coords.length; i++) {
                converted.push(coords[i]);
            }
            return converted;
        }

        var result = [];
        for (var i = 0; i < coords.length; i++) {
            result.push(deepMap(coords[i]));
        }
        return result;
    }

    if (geometry.type === 'GeometryCollection') {
        var newGeometries = [];
        for (var j = 0; j < geometry.geometries.length; j++) {
            newGeometries.push(processGeometry(geometry.geometries[j], convertFn));
        }
        return {
            type: "GeometryCollection",
            geometries: newGeometries
        };
    }

    return {
        type: geometry.type,
        coordinates: deepMap(geometry.coordinates)
    };
}

/**
 * Проверяет, пересекает ли мультиполигон 180-й меридиан
 * @param {Array} coords - массив coordinates из GeoJSON MultiPolygon
 * @returns {boolean}
 */
function IsCrossing180Meridian(coords) {
    let hasLeft = false;
    let hasRight = false;

    for (let i = 0; i < coords?.length; i++) {
        const ring = coords[i][0];
        let allNegative = true;
        let allPositive = true;

        for (let j = 0; j < ring.length; j++) {
            const lon = ring[j][0];
            if (lon > 0) allNegative = false;
            if (lon < 0) allPositive = false;
        }

        if (allNegative) hasLeft = true;
        if (allPositive) hasRight = true;

        if (hasLeft && hasRight) {
            return true;
        }
    }

    return false;
}

