
var MessageBoxesModule = (function () {

    var init = function () {
        ToolDescription.init();
    }

    var ToolDescription = (function () {
        var $elemDescription,
            topPosition,
            active;

        var panelButtons = [];

        var init = function () {
            $elemWindowMessagePanel = $("#WindowMessagePanel");
            $elemDescription = $("#message-box-panel-description");

            topPosition = $("#top-panel").position().top + $("#top-panel").outerHeight(true);
        }

        var show = function (text) {
            if (!active) {
                $elemDescription.transition({ "top": "80px" }, 500, 'snap');
            }
            $('[data-elem="message"]', $elemDescription).html(text);
            active = true;

        }
        var hide = function () {
            if (active) {
                $elemDescription.transition({ "top": "-1000px" }, 500, 'ease');
            }
            $('[data-elem="message"]', $elemDescription).empty();
            removeAllButtons();
            active = false;
        }


        var createNewButton = function (_options) {
            var tmp = new SmallButton(_options);
            panelButtons.push(tmp);
            return tmp;
        }
        var removeAllButtons = function () {
            for (var i = 0; i < panelButtons.length; i++) {
                var tmp = panelButtons[i];
                tmp.remove();
            }
            panelButtons = [];
        }

        var SmallButton = function (_options) {
            var options = {
                "title": null,
                "class": null,
                "onClick": null,
                "order": 0,
            }
            $.extend(options, _options);

            var guid = generateGUID();
            var _disabled = false;
            var $elemButton = $("<div/>").addClass("smallButton block-transition").append($("<div/>"));
            var $elemButtonContainer = $('[data-elem="tools"]', $elemDescription);



            var findPositionAndAppend = function () {
                var $elems = $("> div", $elemButtonContainer);
                if ($elems.length === 0) {
                    $elemButtonContainer.append($elemButton);
                } else {
                    $("> div", $elemButtonContainer).each(function (index, elem) {
                        var $tmp = $(elem);
                        if (parseInt($tmp.attr("data-order")) >= options.order) {
                            $elemButton.insertBefore($tmp);
                            return false;
                        }
                        if (index == ($elems.length - 1)) {
                            $elemButtonContainer.append($elemButton);
                        }
                    });
                }
            }

            var addToTopPanel = function () {
                $elemButton.attr("title", options.title);
                $elemButton.attr("data-order", options.order);
                $("div", $elemButton).addClass(options.class);
                $elemButton.click(function () {
                    onClick();
                });
                findPositionAndAppend();
            }

            var onClick = function () {
                if (_disabled) {
                    return;
                }

                $elemButton.attr("data-active", '1');
                if (typeof options.onClick == "function") {
                    options.onClick();
                }
            }
            var onEnd = function () {
                $elemButton.attr("data-active", '0');
            }
            var triggerClick = function () {
                if (!$elemButton.attr("data-active") == '1') {
                    onClick();
                }
            }
            var disableButton = function () {
                _disabled = true;
                $elemButton.attr("data-disabled", "1");
            }
            var enableButton = function () {
                _disabled = false;
                $elemButton.attr("data-disabled", "0");
            }

            var remove = function () {
                $elemButton.remove();
            }


            addToTopPanel();
            return {
                "guid": guid,
                "type": options.type,
                "$elemButton": $elemButton,
                "addToTopPanel": addToTopPanel,
                "triggerClick": triggerClick,
                "onEnd": onEnd,
                "disableButton": disableButton,
                "enableButton": enableButton,

                "remove": remove
            }
        }

        return {
            "init": init,
            "show": show,
            "hide": hide,

            createNewButton: createNewButton
        }
    }());

    var Dialog = function (_options) {
        var options = {
            "minHeight": 150,
            "minWidth": 600,

            "title": "",
            "titleIcon": "",

            "isLeftPane": false,
            "class": "",

            resize: function () { },
            show: function () { },
            close: function () { },
        }
        $.extend(options, _options);
        var $dialog;

        var init = function () {

            $dialog.draggable({ cursor: "move", containment: "body", scroll: false });
            $dialog.resizable({
                minHeight: options.minHeight,
                minWidth: options.minWidth,
                containment: "body",
                resize: function () { resize(); }
            });
            resize();

            $(".header-close", $dialog).click(function () {
                hide();
            });
        }

        var show = function () {
            $dialog.show();
            if (typeof options.show == "function") {
                options.show();
            }
            resize();
        }
        var hide = function () {
            $dialog.hide();
            if (typeof options.close == "function") {
                options.close();
            }
        }
        var resize = function () {
            if (typeof options.resize == "function") {
                options.resize();
            }
        }

       

        init();
        return {
            "$dialog": $dialog,
            "show": show,
            "hide": hide
        }
    }


    return {
        "init": init,
        "ToolDescription": ToolDescription
    }
}());


$(document).ready(function () {
    window.MessageBoxesModule.init();
});

