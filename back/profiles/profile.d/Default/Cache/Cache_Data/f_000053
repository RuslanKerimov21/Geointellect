.sticker-container {
  position: relative;
  z-index: 5;
  text-decoration: none;
  display: block;
  height: 58px;
  width: 58px;
  line-height: 58px;
  text-align: center;
  box-shadow: 0 0px 20px rgba(0, 0, 0, 0.3);
  border-radius: 7px;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  -webkit-font-smoothing: subpixel-antialiased;
  -webkit-transition: all 0.2s;
  transition: all 0.2s;
}
.sticker-container:hover {
  -webkit-transform: perspective(0px) translateZ(0) scale(1.1);
  -moz-transform: perspective(0px) translateZ(0) scale(1.1);
  -ms-transform: perspective(0px) translateZ(0) scale(1.1);
  transform: perspective(0px) translateZ(0) scale(1.1);
  position: relative;
  z-index: 5;
  cursor: pointer;
}
.sticker-container k[data-elem="query-kolvo"] {
  font-size: 30px;
}
.sticker-container .stickerContainerContent {
  display: inline-block;
  vertical-align: middle;
  line-height: 25px;
}
