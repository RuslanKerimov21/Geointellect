    var fields = {
        helpers: {
            getFieldType: function (fieldname) {
                var type = "String";
                localThis.scheme.Schema.forEach(function (o) {
                    if (o.Name === fieldname) {
                        type = o.Format;
                    }
                });
                return type;
            },
            checkFieldsDisabled: function () {

                var current_status_name = localThis.data.status;
                var current_status_id = status.helpers.findStatusId(current_status_name);
                var stt = status.helpers.findStatusInfoById(current_status_id);
                if (stt != null && stt != undefined) {
                    if (stt.Read_Only === true) {
                        _window.find("select[data-field]").attr("disabled", true);
                        _window.find("input[data-field]").attr("disabled", true);
                        _window.find(".checkBox[data-field]").attr("data-editable", false);
                    }
                }                
            },
            getValueAsString: function (_name, _type) {
                var _value = null;
                for (var _prop in localThis.data) {
                    if (localThis.data.hasOwnProperty(_prop) && _prop == _name) {
                        var _v = localThis.data[_prop];
                        if (_v == null) {
                            _value = "";
                        }
                        else {
                            if (_type == "DateTime") {
                                _value = moment(_v).format('L');
                            }
                            else {
                                _value = _v;
                            }
                        }
                    }
                }
                return _value;
            },
            findFieldInSchema: function (name) {
                var _column = null;
                localThis.scheme.Schema.forEach(function (o) {
                    if (o.Name === name) {
                        _column = o;
                    }
                });
                return _column;
            },
            checkIfFieldIsEditable: function (name) {
                var _result = false;
                var _column = fields.helpers.findFieldInSchema(name);
                if (_column !== null) {
                    _result = _column.Editable;
                }
                return _result;
            },
            getColumnRule: function (column, rule) {
                var _rule = null;
                localThis.scheme.Schema.forEach(function (o) {
                    if (o.Name === column) {

                        o.Rules.forEach(function (_rul) {
                            if (_rul !== "") {
                                var _parts = _rul.split("|");
                                if (_parts.length === 2) {

                                    if (_parts[0] === rule) {

                                        if (_parts[0] === "default") {
                                            _rule = {
                                                type: _parts[0],
                                                condition: _parts[1]
                                            };
                                        }
                                        else if (_parts[0] === "show") {
                                            var _show = _parts[1].split("=");
                                            _rule = {
                                                type: _parts[0],
                                                condition: {
                                                    column: _show[0],
                                                    value: _show[1]
                                                }
                                            };
                                        }

                                    }


                                }
                            }
                        });
                    }
                });
                return _rule;
            },
            findValueDropBox: function (dropBox, value) {
                dropBox.find("select option").each(function (i, v) {
                    if ($(v).text() === value) {
                        $(this).attr("selected", true);
                    }
                });
            },
            checkField: function (self) {
                var active = self.attr("data-active");
                if (self.attr("data-editable") == "false") {
                    return false;
                }
                self.attr("data-active", (active == '0') ? '1' : '0');
            },
            clearFields: function () {
                for (var name in localThis.coreFields) {
                    if (localThis.coreFields.hasOwnProperty(name)) {

                        var elem = localThis.coreFields[name];

                        if (elem.attr("data-type") === "txt") {
                            elem.text("");
                        }
                        else if (elem.attr("data-type") === "val") {
                            elem.val("");
                        }
                    }
                }
            }
        }
    };

    var zones = {
        helpers: {
            featuresToZones: function (features, label) {
                var geoms = Object.assign({}, features);
                var zones = [];
                zones.length = 0;

                if (typeof label === "undefined") {
                    label = "мин";
                }

                geoms.forEach(function (o) {
                    if (o.hasOwnProperty("geometry")) {
                        zones.push({
                            zone_name: "" + parseInt(o.properties.size) + " " + label,
                            zone_size: parseInt(o.properties.size),
                            zone_size_label: label,
                            color: o.properties.color,
                            geom: o.geometry
                        });
                    }
                });

                return zones;
            },
            createZones: function (features, label) {

                localThis.zones = [];
                localThis.zones.length = 0;

                if (typeof label === "undefined") {
                    label = gl.text.minutes1;
                }

                localThis.zones = zones.helpers.featuresToZones(features, label);

                return localThis.zones;
            }
        }
    };
    this.ext.setZones = zones.setZones;
    this.ext.featuresToZones = zones.helpers.featuresToZones;

    this.GetData = function () {
        localThis.scheme_uid = window.mapInfoPopupModule.mapInfoPopup.selectedFeature.properties.project_type;
        localThis.project_uid = window.mapInfoPopupModule.mapInfoPopup.selectedFeature.properties.project_uid;

        if (GiLocalStorageForOld.exists("project_catd_no_access_scheme_" + localThis.scheme_uid)) {
            localThis.scheme = GiLocalStorageForOld.getItem("project_catd_no_access_scheme_" + localThis.scheme_uid);
            if (localThis.scheme != null) {
                let project_api = localThis.GetProjectInfo();
                project_api.done(function (p_resp) {
                    if (localThis.data != null) {
                        generateWindow();
                    }
                });
            }
        } else {
            let scheme_api = localThis.GetScheme();
            scheme_api.done(function (resp) {
                if (localThis.scheme != null) {
                    let project_api = localThis.GetProjectInfo();
                    project_api.done(function (p_resp) {
                        if (localThis.data != null) {
                            generateWindow();
                        }
                    });
                }
            });
        }        
    };

    var generateWindow = function () {
        renderWindow(localThis.scheme.Schema);

        /*toggleActionIdButtonsFor("open");*/

        $("body").append(_window);

        _parts.window_title.html(localThis.scheme.Caption);

        setFormDataNoAccess(localThis.data);

        bindEvents();

        _window.css({ "right": "-600px" });
        window.window.right_z += 1;
        _window.css({ display: "block", "z-index": window.window.right_z });
        _window.transition({ "right": "35px", easing: "cubic-bezier(0.915, 0.825, 0.345, 1.075)", duration: 200 });

        _window.find(".groups-container").slimScroll({
            height: (_window.height() - 320),
            width: "100%",
            size: "3px",
            railVisible: true,
            railOpacity: 0.3,
            railColor: "#88BD1F",
            color: "#88BD1F"
        });
        _window.find(".slimScrollDiv").css({ position: "absolute" });

        localThis.visible = true;

        localThis.layer.features = [];
        localThis.layer.features.length = 0;
        localThis.zones.forEach(function (o) {
            console.log("zone", o);
            localThis.layer.features.push({
                geometry: o.geom,
                properties: {
                    color: o.color
                },
                type: "Feature"
            });
        });

        localThis.layer.show();
        localThis.layer.zoomTo();

        localThis.type = "update";


        localThis.coreFields = null;
        localThis.coreFields = {};
        localThis.coreFields.project_uid = _window.find("[data-field=\"project_uid\"]");
        localThis.coreFields.project_name = _window.find("[data-field=\"project_name\"]");
        localThis.coreFields.created_user = _window.find("[data-field=\"created_user\"]");
        localThis.coreFields.created_date = _window.find("[data-field=\"created_date\"]");
        localThis.coreFields.priority = _window.find("[data-field=\"priority\"]");
        localThis.coreFields.status = _window.find("[data-field=\"status\"]");

        if (_window.find("[data-field=\"project_value\"]").length > 0) {
            localThis.coreFields.project_value = _window.find("[data-field=\"project_value\"]");
        }

        _window.find("[action-id]").each(function () {
            var action = $(this).attr("action-id");
            if (action == "add_zone" && localThis.zones && localThis.zones.length == 0) {
                $(this).attr("data-used", "false");
            }
        });
    };

    this.open = function () {
        console.log("open_project");
        localThis.layer.features = [];
        localThis.layer.hide();
        localThis.GetData();
    };

    init();
};

window.projectCardGeoNoAccess = new ProjectCardGeoNoAccess();


