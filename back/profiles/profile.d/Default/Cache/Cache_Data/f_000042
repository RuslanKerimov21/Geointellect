    var guessWidth = function (_width) {
        var _w = _width;
        if (_width >= 100 || _width <= 10) {
            _w = 100;
        }
        else if (_width <= 50) {
            _w = 49;
        }
        else if (Math.abs(_width - 50) <= 5) {
            _w = 49;
        }
        else {
            _w = 100;
        }
        return _w;
    };

    var renderOneFieldNoAccess = function (_field_info) {
        var _result = null;
        var v = _field_info;
        if (v == null) {
            return _result;
        }
        _result = _t.no_access_template.clone();
        _result.css("flex-basis", (guessWidth(v.Width)) + "%");
        _result.attr("data-field-name", v.Name);
        _result.attr("data-field-format", v.Format);
        _result.attr("data-type", v.Type);
        _result.find("label").html(v.Caption);

        var _txt = _result.find("[data-label=text]");

        _txt.attr({ "data-field": v.Name, "data-format": v.Format });

        return _result;
    };

    var renderAllFields = function (scheme) {

        var _groups = [];
        scheme.forEach(function (v) {
            var _gr = v.Group;
            if (_groups.indexOf(_gr) == -1) {
                _groups.push(_gr);
            }
        });

        _groups.forEach(function (_gr) {
            var scheme_filtered = scheme.filter(function (el) { return el.Group == _gr; });

            scheme_filtered = scheme_filtered.sort(function (a, b) {
                if (a.Index < b.Index) {
                    return -1;
                }
                if (a.Index > b.Index) {
                    return 1;
                }
                if (a.Index == b.Index) {
                    if (a.Name < b.Name) {
                        return -1;
                    }
                    return 1;
                }
                return 0;
            });

            var _group_div = _t._group_template.clone();

            _group_div.find("label[data-id]").html(_gr);

            scheme_filtered.forEach(function (_fld) {

                if (["value", "project_value"].indexOf(_fld.Name) !== -1) {
                    return;
                }

                if (localThis.data.hasOwnProperty(_fld.Name) === false) {
                    return;
                }

                if (_fld.Visible === false) {
                    return;
                }

                var field = renderOneFieldNoAccess(_fld);
                /* console.log("=======================",field);*/

                if (field != null) {
                    _group_div.find(".body-container").append(field);
                }

                field.find("[data-field=" + _fld.Name + "]").attr("disabled", _fld.Editable == false);

                if (_fld.Highlighted === true) {
                    var err_message = "Проверьте значения:\n";
                    if (_fld.hasOwnProperty("ErrorMessages") && _fld.ErrorMessages !== null && _fld.ErrorMessages.length > 0) {
                        _fld.ErrorMessages.forEach(function (item) {
                            err_message += "- " + item + "\n";
                        });
                    }
                    field.find("[data-field=" + _fld.Name + "]").attr("highlighted", true).attr("title", err_message);
                }
                else {
                    field.find("[data-field=" + _fld.Name + "]").attr("highlighted", false);
                }

            });

            _group_div.find(".arrow-down").on("click", function () {
                if ($(this).parent().parent(".group").attr("expanded") == "true") {
                    $(this).parent().parent(".group").attr("expanded", "false");
                }
                else {
                    $(this).parent().parent(".group").attr("expanded", "true");
                }
            });

            _parts.groups_container.append(_group_div);

        });

        fields.helpers.checkFieldsDisabled();

    };

    var setFormDataNoAccess = function (json) {
        _window.find("[data-field]").each(function () {
            var _type = $(this)[0].nodeName.toLowerCase();
            var _name = $(this).attr("data-field");
            var _format = $(this).attr("data-format");

            if (_name == "project_name") {
                /*Удалим input*/
                var _container = $(this).parent();
                $(this).remove();
                _container.append($("<span/>").attr("data-field", "project_name").text(json[_name]));
            }
            if (_name == "status") {
                $(this).text(json[_name]);
                $(this).removeAttr("data-action");
                $(this).attr("data-access", "false");
                status.changeStatusPlate(json[_name]);
                /* updateFieldsEditability();*/
            }
            else if (_name == "priority") {
                if (json.hasOwnProperty(_name)) {
                    $(this).parent().find("label").text("");
                    if (json[_name] == 1) {
                        $(this).parent().find("span.i").addClass("priority-ico");
                        $(this).parent().find("label").text("Срочно!");
                    }
                    $(this).remove();
                }
            }
            else if (_name == "created_date") {
                if (json.hasOwnProperty(_name)) {
                    $(this).html(moment(json[_name]).format('L') + " " + moment(json[_name]).format('LT'));
                }
            }
            else {

                switch (_type) {
                    case "span":
                    case "label":
                    case "div":
                        if (json.hasOwnProperty(_name)) {
                            if ($(this).parent().attr("data-type") == "checkBox") {
                                $(this).attr("data-active", json[_name] == 1 ? "true" : "false");
                            }
                            else if (["Date", "DateTime"].indexOf(_format) != -1) {
                                $(this).html(moment(json[_name]).format('L'));
                            }
                            else {
                                if (json[_name] == null || json[_name] == "null") {
                                    $(this).html("Нет информации");
                                }
                                else if ($(this).parent().attr("data-type") == "checkbox") {
                                    $(this).text(json[_name] == 1 ? "Да" : "Нет");
                                }
                                else {
                                    $(this).html(json[_name]);
                                }
                            }
                        }
                        break;
                    case "input":
                    case "textarea":
                    case "select":
                        if (json.hasOwnProperty(_name)) {
                            if (["Date", "DateTime"].indexOf(_format) != -1) {
                                $(this).val(moment(json[_name]).format('L'));
                            }
                            else {
                                $(this).val(json[_name]);
                            }
                        }
                        break;
                    default:
                        break;
                }
            }

        });
    };
